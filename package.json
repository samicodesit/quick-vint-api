{
  "name": "quick-vint-api",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "ops:dev": "node scripts/ops-dev.mjs",
    "ops:test:unit": "vitest run --config vitest.ops.unit.config.ts",
    "ops:test:db": "vitest run --config vitest.ops.db.config.ts",
    "ops:test:api": "vitest run --config vitest.ops.api.config.ts",
    "ops:test:e2e": "playwright test --config=playwright.ops.config.ts",
    "ops:seed": "node scripts/ops-seed.mjs",
    "ops:worker": "tsx scripts/ops-worker.mjs",
    "ops:verify": "npm run ops:test:unit && npm run ops:test:db && npm run ops:test:api && npm run ops:test:e2e && npm run type-check && npm run build",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint \"api/**/*.ts\" \"utils/**/*.{ts,js}\"",
    "lint:fix": "eslint \"api/**/*.ts\" \"utils/**/*.{ts,js}\" --fix",
    "check:blog-plan": "node scripts/check-blog-plan.mjs",
    "growth": "node scripts/growth-scorecard.mjs",
    "ops:delete-user": "node scripts/delete-user-by-email.mjs",
