<script>
  const heroVideo = document.querySelector(
    "[data-hero-video]",
  ) as HTMLVideoElement | null;

  function runAfterLoadWhenIdle(callback: () => void) {
    const runAfterLoad = () => {
      if ("requestIdleCallback" in window) {
        window.requestIdleCallback(callback, { timeout: 3000 });
        return;
      }

      window.setTimeout(callback, 0);
    };

    if (document.readyState === "complete") {
      runAfterLoad();
      return;
    }

    window.addEventListener("load", runAfterLoad, { once: true });
  }

  function loadHeroVideo() {
    if (!heroVideo || heroVideo.dataset.loaded === "true") return;
    const src = heroVideo.dataset.videoSrc;
    if (!src) return;

    heroVideo.src = src;
    heroVideo.dataset.loaded = "true";
    heroVideo.load();
  }

  function scheduleHeroVideoLoad() {
    runAfterLoadWhenIdle(() => {
      loadHeroVideo();
      heroVideo?.play().catch(() => {});
    });
  }

  async function openHeroFullscreen() {
    if (!heroVideo) return;
    loadHeroVideo();
    try {
      if (heroVideo.requestFullscreen) {
        await heroVideo.requestFullscreen();
      } else if ((heroVideo as any).webkitEnterFullscreen) {
        (heroVideo as any).webkitEnterFullscreen();
      }
    } catch (err) {
      // ignore
    }
    try {
      await heroVideo.play();
    } catch (e) {}
  }

  document.querySelectorAll("[data-open-fullscreen]").forEach((el) => {
    el.addEventListener("click", (e) => {
      e.preventDefault();
      openHeroFullscreen();
    });
  });

  const screenshotPreviewModal = document.querySelector(
    "[data-screenshot-preview-modal]",
  ) as HTMLElement | null;
  const screenshotPreviewImage = document.querySelector(
    "[data-screenshot-preview-image]",
  ) as HTMLImageElement | null;

  let lastScreenshotPreviewTrigger: HTMLElement | null = null;

  function closeScreenshotPreview() {
    if (!screenshotPreviewModal || !screenshotPreviewImage) return;
    screenshotPreviewModal.classList.add("hidden");
    screenshotPreviewModal.classList.remove("flex");
    screenshotPreviewImage.removeAttribute("src");
    screenshotPreviewImage.alt = "";
    document.body.style.overflow = "";
    lastScreenshotPreviewTrigger?.focus();
  }

  document.querySelectorAll("[data-screenshot-preview-open]").forEach((el) => {
    el.addEventListener("click", () => {
      if (!screenshotPreviewModal || !screenshotPreviewImage) return;
      const trigger = el as HTMLElement;
      const src = trigger.dataset.screenshotSrc;
      if (!src) return;
      lastScreenshotPreviewTrigger = trigger;
      screenshotPreviewImage.src = src;
      screenshotPreviewImage.alt = trigger.dataset.screenshotAlt || "";
      screenshotPreviewModal.classList.remove("hidden");
      screenshotPreviewModal.classList.add("flex");
      document.body.style.overflow = "hidden";
      screenshotPreviewModal
        .querySelector<HTMLElement>("[data-screenshot-preview-close]")
        ?.focus();
    });
  });

  document.querySelectorAll("[data-screenshot-preview-close]").forEach((el) => {
    el.addEventListener("click", closeScreenshotPreview);
  });

  document.addEventListener("keydown", (event) => {
    if (
      event.key === "Escape" &&
      screenshotPreviewModal &&
      !screenshotPreviewModal.classList.contains("hidden")
    ) {
      closeScreenshotPreview();
    }
  });

  const publicStatsRoot = document.querySelector(
    "[data-public-stats]",
  ) as HTMLElement | null;
  const homeProofRail = document.querySelector(
    "[data-home-proof-rail]",
  ) as HTMLElement | null;

  if (homeProofRail) {
    const tierOptions = Array.from(
      homeProofRail.querySelectorAll<HTMLElement>("[data-home-tier-option]"),
    );
    const tierLink = homeProofRail.querySelector<HTMLAnchorElement>(
      "[data-home-tier-link]",
    );
    const pricingHref = homeProofRail.dataset.pricingHref || "/pricing";
    let tierValues: Record<string, Record<string, string>> = {};

    try {
      tierValues = JSON.parse(homeProofRail.dataset.tierValues || "{}");
    } catch {
      tierValues = {};
    }

    function selectHomeProofTier(tier: string) {
      const values = tierValues[tier];
      if (!values) return;

      homeProofRail
        ?.querySelectorAll<HTMLElement>("[data-home-tier-proof]")
        .forEach((element) => {
          const key = element.dataset.homeTierProof;
          if (key && values[key]) element.textContent = values[key];
        });

      tierOptions.forEach((option) => {
        const active = option.dataset.homeTierOption === tier;
        option.classList.toggle("is-active", active);
        option.setAttribute("aria-selected", String(active));
      });

      if (tierLink) {
        tierLink.href = `${pricingHref}?plan=${tier}#pricing`;
        tierLink.dataset.trackPlan = tier;
      }
    }

    tierOptions.forEach((option) => {
      option.addEventListener("click", () => {
        const tier = option.dataset.homeTierOption;
        if (tier) selectHomeProofTier(tier);
      });
    });
  }

  function formatPublicStat(value: unknown) {
    const number = Number(value);
    if (!Number.isFinite(number) || number <= 0) {
      return "";
    }

    const formatted = new Intl.NumberFormat(
      document.documentElement.lang || undefined,
      {
        maximumFractionDigits: 0,
      },
    ).format(Math.floor(number));

    return `${formatted}+`;
  }

  function setPublicStatNumber(element: Element | null, value: number) {
    if (!element) return false;
    const text = formatPublicStat(value);
    if (!text) return false;
    element.textContent = text;
    return true;
  }

  async function loadPublicStats() {
    if (!publicStatsRoot) return;

    const endpoint = publicStatsRoot.dataset.statsEndpoint || "/api/public-stats";

    try {
      const response = await fetch(endpoint, {
        headers: { Accept: "application/json" },
      });

      if (!response.ok) {
        throw new Error(`Stats request failed: ${response.status}`);
      }

      const stats = await response.json();
      const generations = Number(stats.totalGenerations);

      if (!Number.isFinite(generations) || generations <= 0) {
        return;
      }

      const generationsEl = publicStatsRoot.querySelector(
        "[data-stat-generations]",
      );

      setPublicStatNumber(generationsEl, Math.floor(generations));
    } catch (error) {
      // Keep the stable placeholder when live stats are unavailable.
    } finally {
      publicStatsRoot.setAttribute("aria-busy", "false");
    }
  }

  function schedulePublicStatsLoad() {
    runAfterLoadWhenIdle(loadPublicStats);
  }

  if (heroVideo) {
    scheduleHeroVideoLoad();
  }

  if (publicStatsRoot) {
    schedulePublicStatsLoad();
  }
</script>

