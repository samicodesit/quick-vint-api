---
import type { SiteCopy, SiteExtraHomeCopy } from "../i18n/site.js";

interface Props {
  copy: SiteCopy["home"];
  extra: SiteExtraHomeCopy;
  locale?: string;
  heroTitleAccent?: {
    before: string;
    accent: string;
    after: string;
  };
  heroSubtitleEmphasis?: string;
}

const { copy, extra, locale = "en", heroTitleAccent, heroSubtitleEmphasis } = Astro.props;

const chromeHref =
  "https://chromewebstore.google.com/detail/autolister-ai-vinted-desc/mommklhpammnlojjobejddmidmdcalcl";
const pricingHref = locale === "en" ? "/pricing" : `/${locale}/pricing`;
const tierProofValues = JSON.stringify(extra.tierProof.tiers);

const subtitleParts =
  heroSubtitleEmphasis && copy.heroSubtitle.includes(heroSubtitleEmphasis)
    ? copy.heroSubtitle.split(heroSubtitleEmphasis)
    : null;
---

<!-- Hero Section -->
<div
  class="relative pt-32 pb-12 lg:pt-[97px] lg:pb-0 overflow-hidden bg-white"
  data-home-hero
>
  <div
    class="absolute top-0 left-0 w-full h-full overflow-hidden pointer-events-none z-0"
  >
    <div
      class="absolute top-0 left-1/4 w-[600px] h-[600px] bg-brand-100 rounded-full mix-blend-multiply filter blur-[80px] opacity-80"
    >
    </div>
    <div
      class="absolute top-0 right-1/4 w-[500px] h-[500px] bg-purple-50 rounded-full mix-blend-multiply filter blur-[80px] opacity-80 animation-delay-2000"
    >
    </div>
    <div
      class="absolute -bottom-32 left-1/3 w-[600px] h-[600px] bg-indigo-50 rounded-full mix-blend-multiply filter blur-[80px] opacity-80 animation-delay-4000"
    >
    </div>
  </div>

  <div
    class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full"
  >
    <div class="lg:grid lg:grid-cols-12 lg:gap-8 xl:gap-16 items-center">
      <div
        class="lg:col-span-5 text-center lg:text-left flex flex-col items-center lg:items-start opacity-0 animate-[fadeInUp_0.8s_ease-out_forwards]"
      >
        <div
          class="hidden sm:flex flex-wrap items-center gap-2 mb-5"
          data-home-hero-badges
        >
          <div
            class="inline-flex max-w-full items-center gap-2 px-3 py-1 rounded-full bg-brand-50 border border-brand-100 text-left text-brand-600 text-xs font-bold uppercase leading-snug tracking-wider shadow-sm transition-colors cursor-default"
          >
            <span class="relative flex h-2 w-2">
              <span
                class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-400 opacity-75"
              ></span>
              <span
                class="relative inline-flex rounded-full h-2 w-2 bg-brand-600"
              ></span>
            </span>
            {extra.heroBadgePrimary}
          </div>
        </div>

        <h1
          class="text-[2.55rem] sm:text-5xl lg:text-5xl xl:text-6xl font-extrabold tracking-tight leading-[1.06] sm:leading-[1.1] mb-4 sm:mb-5 text-slate-900 mt-2 sm:mt-4 lg:mt-0 text-balance"
        >
          {
            heroTitleAccent ? (
              <>
                {heroTitleAccent.before}{" "}
                <span class="gradient-text">{heroTitleAccent.accent}</span>{" "}
                {heroTitleAccent.after}
              </>
            ) : (
              copy.heroTitle
            )
          }
        </h1>

        <p
          class="home-hero-subtitle hidden sm:block text-lg sm:text-xl text-slate-600 mb-6 max-w-lg leading-relaxed font-medium"
        >
          {
            subtitleParts ? (
              <>
                {subtitleParts[0]}
                <strong class="text-slate-800 font-semibold">
                  {heroSubtitleEmphasis}
                </strong>
                {subtitleParts.slice(1).join(heroSubtitleEmphasis || "")}
              </>
            ) : (
              copy.heroSubtitle
            )
          }
        </p>

        <p
          class="sm:hidden text-base text-slate-600 mb-5 max-w-sm leading-relaxed font-semibold"
        >
          {copy.heroMobileSubtitle}
        </p>

        <ul
          class="home-hero-benefits hidden sm:block space-y-2.5 mb-6 text-left w-full max-w-md px-2 sm:px-0 list-none"
        >
          <li class="flex items-start gap-3">
            <div
              class="flex-shrink-0 w-6 h-6 rounded-full bg-brand-50 flex items-center justify-center mt-0.5 border border-brand-100 shadow-sm"
            >
              <svg
                class="w-4 h-4 text-brand-600"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2.5"
                  d="M5 13l4 4L19 7"></path>
              </svg>
            </div>
            <span class="text-slate-700 font-semibold text-lg leading-snug"
              >{extra.heroBullet1}</span
            >
          </li>
          <li class="flex items-start gap-3">
            <div
              class="flex-shrink-0 w-6 h-6 rounded-full bg-brand-50 flex items-center justify-center mt-0.5 border border-brand-100 shadow-sm"
            >
              <svg
                class="w-4 h-4 text-brand-600"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2.5"
                  d="M5 13l4 4L19 7"></path>
              </svg>
            </div>
            <span class="text-slate-700 font-semibold text-lg leading-snug"
              >{extra.heroBullet2}</span
            >
          </li>
          <li class="flex items-start gap-3">
            <div
              class="flex-shrink-0 w-6 h-6 rounded-full bg-brand-50 flex items-center justify-center mt-0.5 border border-brand-100 shadow-sm"
            >
              <svg
                class="w-4 h-4 text-brand-600"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2.5"
                  d="M5 13l4 4L19 7"></path>
              </svg>
            </div>
            <span class="text-slate-700 font-semibold text-lg leading-snug"
              >{extra.heroBullet3}</span
            >
          </li>
        </ul>

        <div
          class="home-hero-actions flex flex-col sm:flex-row lg:flex-col xl:flex-row gap-3 sm:gap-4 w-full max-w-2xl px-1 sm:px-0"
        >
          <a
            href={chromeHref}
            target="_blank"
            rel="noopener noreferrer"
            data-track-event="chrome_store_click"
            data-track-context="home_hero_primary"
            data-track-copy-version="vinted_ai_listing_assistant_v1"
            class="group relative inline-flex min-h-[60px] sm:min-h-[76px] w-full sm:flex-1 items-center justify-start gap-3 px-5 py-3.5 sm:px-7 sm:py-4 text-left text-base font-bold text-white bg-brand-600 rounded-2xl hover:bg-brand-700 transition-all duration-200 hover:-translate-y-1 shadow-lg shadow-brand-600/30 overflow-hidden focus:ring-2 ring-brand-500 no-underline"
          >
            <div
              class="bg-white rounded-full p-0.5 shadow-sm shrink-0 self-center"
            >
              <svg
                viewBox="0 0 48 48"
                class="w-5 h-5 shrink-0 transition-transform group-hover:rotate-12 duration-500"
              >
                <defs>
                  <linearGradient
                    id="chrome-a"
                    x1="3.2"
                    y1="15"
                    x2="44.7"
                    y2="15"
                    gradientUnits="userSpaceOnUse"
                  >
                    <stop offset="0" stop-color="#d93025"></stop>
                    <stop offset="1" stop-color="#ea4335"></stop>
                  </linearGradient>
                  <linearGradient
                    id="chrome-b"
                    x1="20.7"
                    y1="47.6"
                    x2="41.5"
                    y2="11.6"
                    gradientUnits="userSpaceOnUse"
                  >
                    <stop offset="0" stop-color="#fcc934"></stop>
                    <stop offset="1" stop-color="#fbbc04"></stop>
                  </linearGradient>
                  <linearGradient
                    id="chrome-c"
                    x1="26.5"
                    y1="46.5"
                    x2="5.8"
                    y2="10.5"
                    gradientUnits="userSpaceOnUse"
                  >
                    <stop offset="0" stop-color="#1e8e3e"></stop>
                    <stop offset="1" stop-color="#34a853"></stop>
                  </linearGradient>
                </defs>
                <circle cx="24" cy="24" r="12" fill="#fff"></circle>
                <path
                  d="M24 12H44.78a24 24 0 0 0-41.56 0L13.6 30S24 12 24 12Z"
                  fill="url(#chrome-a)"></path>
                <circle cx="24" cy="24" r="9.5" fill="#1a73e8"></circle>
                <path
                  d="M34.39 30 24 48a24 24 0 0 0 20.78-36H24S34.39 30 34.39 30Z"
                  fill="url(#chrome-b)"></path>
                <path
                  d="M13.6 30 3.2 12A24 24 0 0 0 24 48l10.4-18S13.6 30 13.6 30Z"
                  fill="url(#chrome-c)"></path>
              </svg>
            </div>

            <span class="min-w-0 flex flex-col items-start leading-tight">
              <span class="break-words text-base font-bold"
                >{extra.addToChrome}</span
              >
              <span class="font-medium text-brand-100 opacity-90 mt-1 text-sm"
                >{extra.addToChromeNote}</span
              >
            </span>
          </a>

          <button
            data-open-fullscreen
            data-track-event="demo_video_open"
            data-track-context="home_hero_secondary"
            data-track-copy-version="vinted_ai_listing_assistant_v1"
            class="inline-flex min-h-[56px] sm:min-h-[76px] w-full sm:w-auto sm:min-w-[220px] items-center justify-start gap-2 px-5 py-3.5 sm:px-7 sm:py-4 text-left text-base font-bold text-slate-800 bg-white border-2 border-slate-300 rounded-2xl hover:bg-slate-50 hover:border-slate-400 transition-all duration-200 hover:-translate-y-1 shadow-sm cursor-pointer"
          >
            <svg
              class="w-5 h-5 text-slate-900 shrink-0"
              fill="currentColor"
              viewBox="0 0 24 24"
            >
              <path d="M8 5v14l11-7z"></path>
            </svg>
            <span class="break-words leading-tight">{extra.watchDemo}</span>
          </button>
        </div>

        <div
          class="sm:hidden mt-5 grid w-full max-w-sm grid-cols-1 gap-2 px-1 text-left"
          aria-label="AutoLister highlights"
        >
          <div
            class="flex items-center gap-2 rounded-xl border border-brand-100 bg-white px-3 py-2 text-sm font-bold leading-tight text-slate-800 shadow-sm"
          >
            <svg
              class="h-4 w-4 shrink-0 text-brand-600"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.5"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
            </svg>
            <span>{extra.heroBadgePrimary}</span>
          </div>
          <div
            class="flex items-center gap-2 rounded-xl border border-brand-100 bg-white px-3 py-2 text-sm font-bold leading-tight text-slate-800 shadow-sm"
          >
            <svg
              class="h-4 w-4 shrink-0 text-brand-600"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.5"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
            </svg>
            <span>{extra.heroBullet2}</span>
          </div>
        </div>

        <div
          class="mt-6 hidden sm:flex items-start gap-4 p-4 rounded-xl bg-slate-50/50 border border-slate-100/60 max-w-md backdrop-blur-sm"
        >
          <img
            class="w-10 h-10 rounded-full border-2 border-white shadow-md shrink-0"
            src="/user-1.jpg"
            alt="User"
            width="40"
            height="40"
            loading="lazy"
            decoding="async"
          />
          <div class="text-sm">
            <p class="text-slate-700 italic leading-relaxed">
              "{extra.testimonialQuote}"
            </p>
            <p
              class="text-slate-900 font-bold mt-2 text-xs uppercase tracking-wide"
            >
              {extra.testimonialAuthor}
            </p>
          </div>
        </div>
      </div>

      <div
        class="lg:col-span-7 mt-12 lg:mt-0 relative opacity-0 animate-[fadeInUp_0.8s_ease-out_0.2s_forwards]"
      >
        <div
          class="absolute -top-12 -right-12 w-72 h-72 bg-brand-100 rounded-full mix-blend-multiply filter blur-[60px] opacity-60"
        >
        </div>
        <div
          class="absolute -bottom-8 -left-8 w-64 h-64 bg-purple-100 rounded-full mix-blend-multiply filter blur-[60px] opacity-60"
        >
        </div>

        <div
          data-public-stats
          data-stats-endpoint="/api/public-stats"
          class="public-stats-video-badge mx-auto mb-3 flex w-fit max-w-full items-center rounded-full border border-indigo-200 bg-white px-4 py-2 text-sm font-bold text-slate-700 shadow-lg shadow-indigo-200/60"
          aria-label={extra.publicStatsAriaLabel}
          aria-busy="true"
          aria-live="polite"
        >
          <span
            data-stat-generations
            class="public-stat-number min-w-[8ch] text-right text-base font-black text-indigo-600"
          >
            —
          </span>
          <span class="ml-1">{extra.publicStatsGenerationsLabel}</span>
        </div>

        <div
          class="relative w-full rounded-2xl overflow-hidden video-wrapper bg-white group cursor-pointer"
          data-open-fullscreen
        >
          <div class="aspect-video relative">
            <video
              data-hero-video
              data-video-src="/vid-promo.mp4"
              class="hero-demo-video w-full h-full object-cover"
              poster="/video-poster.webp"
              width="1920"
              height="1080"
              preload="none"
              autoplay
              loop
              muted
              playsinline
              controls
            >
            </video>

            <div class="absolute top-4 right-4 z-20">
              <button
                data-open-fullscreen
                class="p-2.5 bg-black/40 backdrop-blur-md text-white rounded-full hover:bg-black/60 transition-all duration-200 hover:scale-110"
                aria-label="View Full Screen"
              >
                <svg
                  class="w-5 h-5"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"
                  ></path>
                </svg>
              </button>
            </div>
          </div>
        </div>

        <div class="mt-4 text-center">
          <p class="text-sm text-slate-500 font-medium">
            {extra.videoCaption}
          </p>
        </div>

        <div class="mt-5 max-w-md mx-auto">
          <div class="mb-2 flex items-center justify-between gap-3 px-1">
            <p class="text-xs font-bold uppercase tracking-wider text-slate-600">
              {extra.screenshotPreviewLabel}
            </p>
            <p class="text-xs font-medium text-slate-400">
              {extra.screenshotPreviewHint}
            </p>
          </div>
          <div class="grid grid-cols-2 gap-3">
            <button
              type="button"
              data-screenshot-preview-open
              data-screenshot-src="/cws-screenshot-main.png"
              data-screenshot-alt={extra.screenshotPreviewPrimary}
              data-track-event="store_screenshot_open"
              data-track-context="home_hero_screenshot_main"
              class="group relative block overflow-hidden rounded-xl border border-white/70 bg-white p-0 text-left shadow-lg shadow-slate-900/10 ring-1 ring-slate-200/70 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-xl hover:ring-brand-300 focus:outline-none focus:ring-2 focus:ring-brand-500"
              aria-label={extra.screenshotPreviewPrimary}
            >
              <img
                src="/cws-screenshot-main-thumb.webp"
                alt={extra.screenshotPreviewPrimary}
                width="320"
                height="200"
                loading="lazy"
                decoding="async"
                fetchpriority="low"
                class="aspect-[8/5] h-auto w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
              />
              <span
                class="absolute left-2 top-2 rounded-full bg-brand-600 px-2 py-0.5 text-[10px] font-black uppercase tracking-wide text-white shadow-sm"
              >
                {extra.screenshotPreviewBadge}
              </span>
              <span
                class="absolute inset-x-0 bottom-0 bg-slate-950/70 px-2 py-1 text-left text-[11px] font-semibold text-white backdrop-blur-sm"
              >
                {extra.screenshotPreviewPrimary}
              </span>
            </button>
            <button
              type="button"
              data-screenshot-preview-open
              data-screenshot-src="/cws-screenshot-secondary.png"
              data-screenshot-alt={extra.screenshotPreviewSecondary}
              data-track-event="store_screenshot_open"
              data-track-context="home_hero_screenshot_secondary"
              class="group relative block overflow-hidden rounded-xl border border-white/70 bg-white p-0 text-left shadow-lg shadow-slate-900/10 ring-1 ring-slate-200/70 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-xl hover:ring-brand-300 focus:outline-none focus:ring-2 focus:ring-brand-500"
              aria-label={extra.screenshotPreviewSecondary}
            >
              <img
                src="/cws-screenshot-secondary-thumb.webp"
                alt={extra.screenshotPreviewSecondary}
                width="320"
                height="200"
                loading="lazy"
                decoding="async"
                fetchpriority="low"
                class="aspect-[8/5] h-auto w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
              />
              <span
                class="absolute left-2 top-2 rounded-full bg-brand-600 px-2 py-0.5 text-[10px] font-black uppercase tracking-wide text-white shadow-sm"
              >
                {extra.screenshotPreviewBadge}
              </span>
              <span
                class="absolute inset-x-0 bottom-0 bg-slate-950/70 px-2 py-1 text-left text-[11px] font-semibold text-white backdrop-blur-sm"
              >
                {extra.screenshotPreviewSecondary}
              </span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <div class="home-tier-proof-slot">
      <section
        class="home-tier-proof-rail"
        data-home-proof-rail
        data-tier-values={tierProofValues}
        data-pricing-href={pricingHref}
        aria-label={extra.tierProof.ariaLabel}
      >
        <div
          class="home-tier-toggle"
          role="tablist"
          aria-label={extra.tierProof.tierLabel}
        >
          {
            (Object.keys(extra.tierProof.tiers) as Array<
              keyof typeof extra.tierProof.tiers
            >).map((tier, index) => (
              <button
                type="button"
                role="tab"
                class:list={["home-tier-option", { "is-active": index === 0 }]}
                aria-selected={index === 0 ? "true" : "false"}
                data-home-tier-option={tier}
              >
                {extra.tierProof.tiers[tier].name}
              </button>
            ))
          }
        </div>

        <div class="home-tier-proof-card">
          <ul class="home-tier-proof-grid">
            <li>
              <strong data-home-tier-proof="priceValue">
                {extra.tierProof.tiers.starter.priceValue}
              </strong>
              <span>{extra.tierProof.priceLabel}</span>
            </li>
            <li>
              <strong data-home-tier-proof="comparisonValue">
                {extra.tierProof.tiers.starter.comparisonValue}
              </strong>
              <span>{extra.tierProof.comparisonLabel}</span>
            </li>
            <li>
              <strong data-home-tier-proof="listingsValue">
                {extra.tierProof.tiers.starter.listingsValue}
              </strong>
              <span>{extra.tierProof.listingsLabel}</span>
            </li>
            <li>
              <strong data-home-tier-proof="speedValue">
                {extra.tierProof.tiers.starter.speedValue}
              </strong>
              <span>{extra.tierProof.speedLabel}</span>
            </li>
          </ul>
          <a
            class="home-tier-proof-link"
            href={`${pricingHref}?plan=starter#pricing`}
            data-home-tier-link
            data-track-event="pricing_view"
            data-track-context="home_tier_proof"
            data-track-plan="starter"
          >
            <span class="home-tier-proof-link-title">
              {extra.tierProof.chooseTier}
            </span>
            <span class="home-tier-proof-link-note">
              {extra.tierProof.noCardRequired}
            </span>
          </a>
        </div>
      </section>
    </div>
  </div>
</div>

<div
  data-screenshot-preview-modal
  class="fixed inset-0 z-[120] hidden items-center justify-center bg-slate-950/80 px-4 py-5 backdrop-blur-sm sm:px-6"
  role="dialog"
  aria-modal="true"
  aria-labelledby="screenshot-preview-title"
>
  <div class="absolute inset-0" data-screenshot-preview-close></div>
  <div
    class="relative z-10 flex max-h-[92vh] w-full max-w-6xl flex-col overflow-hidden rounded-3xl bg-white shadow-2xl ring-1 ring-white/20"
  >
    <div
      class="flex items-center justify-between gap-4 border-b border-slate-200 px-4 py-3 sm:px-5"
    >
      <div>
        <p
          id="screenshot-preview-title"
          class="text-sm font-black uppercase tracking-wider text-brand-600"
        >
          {extra.screenshotModalEyebrow}
        </p>
        <p class="mt-0.5 text-sm font-medium text-slate-500">
          {extra.screenshotModalHint}
        </p>
      </div>
      <button
        type="button"
        data-screenshot-preview-close
        class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-slate-200 bg-white text-slate-600 transition hover:bg-slate-100 hover:text-slate-950 focus:outline-none focus:ring-2 focus:ring-brand-500"
        aria-label={extra.screenshotModalClose}
      >
        <svg
          class="h-5 w-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2.5"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <div class="min-h-0 flex-1 overflow-auto bg-slate-100 p-3 sm:p-5">
      <img
        data-screenshot-preview-image
        alt=""
        class="mx-auto h-auto w-full max-w-[1280px] rounded-2xl bg-white shadow-xl ring-1 ring-slate-200"
      />
    </div>

    <div
      class="flex flex-col gap-3 border-t border-slate-200 bg-white px-4 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-5"
    >
      <button
        type="button"
        data-screenshot-preview-close
        class="inline-flex min-h-11 items-center justify-center rounded-xl border border-slate-300 bg-white px-5 py-2.5 text-sm font-black text-slate-700 transition hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-brand-500"
      >
        {extra.screenshotModalClose}
      </button>
      <a
        href={chromeHref}
        target="_blank"
        rel="noopener noreferrer"
        data-track-event="chrome_store_click"
        data-track-context="screenshot_preview_modal"
