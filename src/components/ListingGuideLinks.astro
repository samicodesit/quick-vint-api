---
import { LISTING_GUIDE_COPY, LISTING_GUIDE_SLUGS } from "../i18n/listingGuides.js";
import type { ListingGuideSlug } from "../i18n/listingGuides.js";
import { localizedPath } from "../i18n/routing.js";
import type { SiteLocale } from "../i18n/site.js";

interface Props {
  locale: SiteLocale;
  currentSlug?: ListingGuideSlug;
}

const { locale, currentSlug } = Astro.props;
const copy = LISTING_GUIDE_COPY[locale];
const slugs = LISTING_GUIDE_SLUGS.filter((slug) => slug !== currentSlug);
---

<section class="border-t border-slate-200 bg-slate-50 py-14 sm:py-20" aria-labelledby="listing-resources-heading">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <h2 id="listing-resources-heading" class="max-w-3xl text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">
      {currentSlug ? copy.ui.related : copy.ui.resources}
    </h2>
    <div class:list={["mt-7 grid gap-4", slugs.length === 3 ? "md:grid-cols-3" : "md:grid-cols-2"]}>
      {slugs.map((slug) => (
        <a href={localizedPath(locale, `/${slug}`)} class="group rounded-2xl border border-slate-200 bg-white p-6 no-underline transition-colors hover:border-brand-600 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-600">
          <h3 class="text-lg font-bold leading-snug text-slate-900 group-hover:text-brand-700">{copy.pages[slug].heading}</h3>
          <p class="mt-3 text-sm leading-relaxed text-slate-600">{copy.pages[slug].description}</p>
        </a>
      ))}
    </div>
  </div>
</section>
