---
import { PHONE_TRANSFER_COPY } from "../i18n/phoneTransfer";
import type { SiteLocale } from "../i18n/site";
interface Props { locale?: SiteLocale; }
const { locale = "en" } = Astro.props;
const copy = PHONE_TRANSFER_COPY[locale];
---
<details class="rounded-2xl border border-slate-200 bg-white p-5 sm:p-6" data-phone-photo-transfer>
  <summary class="cursor-pointer text-base font-bold text-slate-900">{copy.heading}</summary>
  <ol class="mt-5 list-decimal space-y-2 pl-5 text-sm leading-relaxed text-slate-600">
    {copy.steps.map((step) => <li>{step}</li>)}
  </ol>
  <figure class="mt-5">
    <img src="/phone-upload-qr-preview.png" width="494" height="769" alt={copy.qrLabel} loading="lazy" decoding="async" class="mx-auto h-auto w-full max-w-xs rounded-xl border border-slate-100" />
    <figcaption class="mt-3 text-center text-sm text-slate-600">{copy.example}</figcaption>
  </figure>
</details>
