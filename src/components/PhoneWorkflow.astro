---
import { LISTING_GUIDE_COPY } from "../i18n/listingGuides";

interface Props {
  context: string;
}
const { context } = Astro.props;
const { phoneQuestion, phoneBody } = LISTING_GUIDE_COPY.en.ui;
---

<section id="phone-only" class="scroll-mt-28 rounded-2xl border border-brand-200 bg-brand-50 p-6 text-left sm:p-8">
  <h2 class="text-xl font-bold text-slate-900">{phoneQuestion}</h2>
  <p class="mt-3 leading-relaxed text-slate-600">{phoneBody}</p>
  <a href="/app" data-track-event="web_app_click" data-track-context={context} class="mt-4 inline-flex min-h-11 items-center rounded-xl bg-brand-600 px-5 py-3 font-bold text-white no-underline hover:bg-brand-700 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-600">Open AutoLister web app</a>
</section>
