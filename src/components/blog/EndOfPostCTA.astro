---
import { CHROME_WEB_STORE_URL } from "../../utils/blog.js";

interface Props {
  locale?: "en" | "fr" | "de" | "nl";
}

const { locale = "en" } = Astro.props;

const copy = {
  en: {
    title: "Try AutoLister AI",
    body: "Prepare editable listing drafts from your photos and seller notes. Create an account to try 5 free generations. No card required.",
    cta: "Install AutoLister",
    mobile: "Using an iPhone or iPad? Setup guide",
  },
  fr: {
    title: "Essayer AutoLister AI",
    body: "Préparez des brouillons modifiables à partir de vos photos et de vos notes. Créez un compte pour essayer 5 générations gratuites, sans carte bancaire.",
    cta: "Installer AutoLister",
    mobile: "Sur iPhone ou iPad ? Guide d’installation",
  },
  de: {
    title: "AutoLister AI testen",
    body: "Erstelle bearbeitbare Entwürfe aus deinen Fotos und Verkäufernotizen. Registriere dich für 5 kostenlose Generierungen. Keine Kreditkarte nötig.",
    cta: "AutoLister installieren",
    mobile: "iPhone oder iPad? Zur Installationsanleitung",
  },
  nl: {
    title: "Probeer AutoLister AI",
    body: "Maak bewerkbare advertentieconcepten met je foto's en verkopersnotities. Maak een account voor 5 gratis generaties. Geen betaalkaart nodig.",
    cta: "AutoLister installeren",
    mobile: "iPhone of iPad? Bekijk de installatiegids",
  },
}[locale];
---

<aside class="my-12 rounded-2xl border border-slate-200 bg-slate-50 p-6 sm:p-8">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h3 class="text-lg font-bold text-slate-900">{copy.title}</h3>
      <p class="mt-1 text-sm text-slate-600 leading-relaxed">{copy.body}</p>
    </div>
    <a
      href={CHROME_WEB_STORE_URL}
      target="_blank"
      rel="noopener noreferrer"
      data-track-event="chrome_store_click"
      data-track-context="blog_end_of_post"
      class="inline-flex shrink-0 items-center justify-center rounded-xl bg-slate-900 px-5 py-2.5 text-sm font-bold text-white no-underline transition hover:bg-slate-800"
    >
      {copy.cta}
    </a>
  </div>
  <a
    href="/support#iphone-ipad"
    data-track-event="support_guide_click"
    data-track-context="blog_end_of_post_iphone_ipad"
    class="mt-4 inline-block text-sm font-medium text-indigo-700 underline underline-offset-4 hover:text-indigo-900"
  >
    {copy.mobile}
  </a>
</aside>
