---
import { CHROME_WEB_STORE_URL } from "../../utils/blog.js";

interface Props {
  variant?: "speed" | "quality" | "safe";
  locale?: "en" | "fr" | "de" | "nl";
}

const { variant = "speed", locale = "en" } = Astro.props;

const copy = {
  en: {
    speed: "Turn photos into listings or batch drafts in seconds.",
    quality: "Write clearer titles and descriptions buyers can actually find.",
    safe: "Prepare listing drafts while staying in control.",
    body: "AutoLister AI prepares titles and descriptions from your photos, one item or a batch, for you to review.",
    cta: "Install AutoLister",
    mobile: "Using an iPhone or iPad? Setup guide",
  },
  fr: {
    speed: "Transformez vos photos en annonces ou en lots de brouillons.",
    quality: "Rédigez des titres et descriptions plus clairs, faciles à trouver.",
    safe: "Préparez vos brouillons d’annonces tout en gardant le contrôle.",
    body: "AutoLister AI prépare des titres et descriptions à partir de vos photos, à vérifier avant publication.",
    cta: "Installer AutoLister",
    mobile: "Sur iPhone ou iPad ? Guide d’installation",
  },
  de: {
    speed: "Verwandle Fotos in Listings oder Batch-Entwürfe.",
    quality: "Schreibe klarere Titel und Beschreibungen, die Käufer finden.",
    safe: "Erstelle Entwürfe und behalte die Kontrolle.",
    body: "AutoLister AI erstellt Titel und Beschreibungen aus deinen Fotos, die du vor der Veröffentlichung prüfst.",
    cta: "AutoLister installieren",
    mobile: "iPhone oder iPad? Zur Installationsanleitung",
  },
  nl: {
    speed: "Zet foto's om naar advertenties of batch-concepten.",
    quality: "Schrijf betere titels en beschrijvingen die kopers kunnen vinden.",
    safe: "Maak advertentieconcepten en houd zelf de controle.",
    body: "AutoLister AI maakt titels en beschrijvingen vanuit je foto's, die je voor publicatie controleert.",
    cta: "AutoLister installeren",
    mobile: "iPhone of iPad? Bekijk de installatiegids",
  },
}[locale];
---

<aside
  class="my-10 rounded-2xl border border-slate-200 bg-slate-50 p-5"
>
  <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <p class="text-base font-bold text-slate-900">
        {copy[variant]}
      </p>
      <p class="mt-1 text-sm font-medium leading-6 text-slate-600">
        {copy.body}
      </p>
    </div>
    <a
      href={CHROME_WEB_STORE_URL}
      target="_blank"
      rel="noopener noreferrer"
      data-track-event="chrome_store_click"
      data-track-context={`blog_inline_${variant}`}
      class="inline-flex shrink-0 items-center justify-center rounded-xl bg-slate-900 px-4 py-2.5 text-sm font-bold text-white no-underline transition hover:bg-slate-800"
    >
      {copy.cta}
    </a>
  </div>
  <a
    href="/support#iphone-ipad"
    data-track-event="support_guide_click"
    data-track-context={`blog_inline_${variant}_iphone_ipad`}
    class="mt-4 inline-block text-sm font-medium text-indigo-700 underline underline-offset-4 hover:text-indigo-900"
  >
    {copy.mobile}
  </a>
</aside>
