---
import { buildExample, initialStyle } from "../../app/mobile-web/styleExample";

interface Props { locale?: "en" | "de"; }
const { locale = "en" } = Astro.props;
const example = buildExample({ ...initialStyle, titleLanguage: locale, descriptionLanguage: locale, emojis: false });
const copy = {
  en: {
    item: "Listing description before and after",
    before: "Before",
    beforeTitle: "Black dress",
    beforeText: "Lovely black dress, size 34. Message me for more details!",
    after: "After",
  },
  de: {
    item: "Artikelbeschreibung vorher und nachher",
    before: "Vorher",
    beforeTitle: "Schwarzes Kleid",
    beforeText: "Schönes schwarzes Kleid, Größe 34. Bei Fragen gerne melden!",
    after: "Nachher",
  },
}[locale];
---

<section class="listing-comparison" data-listing-comparison aria-label={copy.item}>
  <div class="comparison-grid">
    <section class="comparison-card comparison-before" aria-label={copy.before}>
      <header><h3>{copy.before}</h3></header>
      <p class="comparison-title">{copy.beforeTitle}</p>
      <p>{copy.beforeText}</p>
    </section>
    <section class="comparison-card comparison-after" aria-label={copy.after}>
      <header><h3>{copy.after}</h3></header>
      <p class="comparison-title">{example.title}</p>
      <p>{example.intro}</p>
      <ul>{example.details.map(detail => <li>{detail}</li>)}</ul>
      <p class="comparison-hashtags">{example.hashtags}</p>
    </section>
  </div>
</section>

<style>
  .listing-comparison { margin: 1.5rem 0; color: #0f172a; }
  .comparison-grid { display: grid; align-items: start; gap: 1rem; }
  .comparison-card { min-width: 0; padding: 1.25rem; border: 1px solid #e2e8f0; border-radius: 12px; background: #f8fafc; overflow-wrap: anywhere; }
  .comparison-after { border-color: #c7d2fe; background: #f5f7ff; }
  .comparison-card header { margin-bottom: .75rem; }
  .comparison-card h3 { margin: 0; font-size: 1.0625rem; line-height: 1.3; }
  .comparison-after h3 { color: #3730a3; }
  .comparison-card p { margin: 0 0 .75rem; font-size: 1rem; line-height: 1.6; }
  .comparison-card .comparison-title { font-weight: 700; line-height: 1.45; }
  .comparison-card ul { margin: 0; padding-left: 1.2rem; font-size: 1rem; line-height: 1.6; list-style: disc; }
  .comparison-card li { margin: .375rem 0; padding: 0; }
  .comparison-card .comparison-hashtags { margin: 1rem 0 0; color: #3730a3; font-size: .875rem; overflow-wrap: anywhere; }
  .comparison-card p:last-child { margin-bottom: 0; }
  @media (min-width: 680px) { .comparison-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } }
</style>
