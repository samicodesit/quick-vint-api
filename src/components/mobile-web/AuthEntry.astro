---
// An illustrative scenario, not observed customer averages.
const manualWritingMinutes = 5;
const assistedWritingMinutes = 1;
const savedWritingMinutes = manualWritingMinutes - assistedWritingMinutes;
---
<section class="mobile-auth-card mobile-auth-entry" data-mobile-web="auth-card" aria-labelledby="mobile-auth-title" hidden>
  <div class="auth-entry-form">
    <h1 id="mobile-auth-title">Sign in</h1>
    <div data-mobile-web="auth-choices">
      <p class="auth-entry-offer">New accounts get 5 free drafts. No card needed.</p>
      <button type="button" class="mobile-google-button" data-mobile-web="google-sign-in"><img class="mobile-google-mark" src="/app/google-g.png" width="20" height="20" alt="" />Continue with Google</button>
      <div class="mobile-auth-divider" aria-hidden="true"><span>or use email</span></div>
      <form data-mobile-web="email-form" class="mobile-email-form">
        <label for="mobile-email">Email address</label>
        <input id="mobile-email" name="email" type="email" autocomplete="email" inputmode="email" required placeholder="you@example.com" aria-describedby="mobile-auth-status" />
        <button type="submit" class="mobile-primary-button">Continue</button>
      </form>
    </div>
    <form data-mobile-web="otp-form" class="mobile-otp-form" method="post" novalidate hidden>
      <p class="auth-code-destination" data-mobile-web="auth-email"></p>
      <p id="mobile-otp-help" class="mobile-field-help">Open the link or enter the code.</p>
      <label for="mobile-otp">6-digit code</label>
      <input id="mobile-otp" name="otp" type="text" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" required spellcheck="false" autocapitalize="off" aria-describedby="mobile-otp-help mobile-otp-status" />
      <p id="mobile-otp-status" class="mobile-form-status" data-mobile-web="otp-status" role="status" aria-live="polite"></p>
      <button type="submit" class="mobile-primary-button" data-mobile-web="verify-code">Verify code</button>
      <div class="mobile-auth-actions">
        <button type="button" class="mobile-text-button" data-mobile-web="resend-code">Resend email</button>
        <button type="button" class="mobile-text-button" data-mobile-web="change-email">Change email</button>
      </div>
    </form>
    <p id="mobile-auth-status" class="mobile-form-status" data-mobile-web="auth-status" role="status" aria-live="polite"></p>
    <nav class="auth-entry-legal" data-mobile-web="auth-legal" aria-label="Legal"><a href="/terms">Terms</a><a href="/privacy">Privacy</a></nav>
  </div>
  <div class="auth-estimates" aria-labelledby="auth-benefit-title">
    <h2 id="auth-benefit-title">Spend less time writing.</h2>
    <div class="auth-time-estimate" data-entry-metric="time">
      <p class="auth-time-value"><strong>{savedWritingMinutes}</strong><span>min</span></p>
      <p class="auth-time-label">Estimated writing time saved per listing</p>
    </div>
    <dl class="auth-time-comparison">
      <div><dt>By hand</dt><dd>{manualWritingMinutes} <span>min</span></dd></div>
      <div><dt>With AutoLister</dt><dd>{assistedWritingMinutes} <span>min</span></dd></div>
    </dl>
    <dl class="auth-selling-estimates">
      <div data-entry-metric="views"><dt>Views in 7 days</dt><dd>40–60</dd></div>
      <div data-entry-metric="favourites"><dt>Favourites in 7 days</dt><dd>3–5</dd></div>
      <div data-entry-metric="sale-time"><dt>Days to sell</dt><dd>7–14</dd></div>
    </dl>
    <p class="auth-estimate-note" data-entry-estimate-note>Illustrative estimates per listing.</p>
  </div>
</section>
