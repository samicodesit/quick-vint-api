---
import { Camera, Images, Copy, Pencil, Settings2, ArrowLeft, ArrowRight, ChevronLeft, Ellipsis, Pause, Play, RotateCcw, RotateCw, Crop, Paintbrush, Undo2, Check, Plus, Trash2, Download, X, LoaderCircle, Clock, TriangleAlert, Package, Layers, ChevronDown } from "@lucide/astro";
import ListingSettingsFields from "./ListingSettingsFields.astro";
import PhotoEntry from "./PhotoEntry.astro";
---
<section class="draft-workspace" data-draft-workspace hidden aria-label="Listing drafts">
  <template data-draft-icon="images"><Images size={24} aria-hidden="true" /></template>
  <template data-draft-icon="remove"><X size={18} aria-hidden="true" /></template><template data-draft-icon="more"><Ellipsis size={20} aria-hidden="true" /></template>
  <template data-draft-icon="copy"><Copy size={18} aria-hidden="true" /></template>
  <template data-draft-icon="check"><Check size={18} aria-hidden="true" /></template>
  <template data-draft-icon="download"><Download size={18} aria-hidden="true" /></template>
  <template data-draft-icon="rotate"><RotateCw size={18} aria-hidden="true" /></template>
  <template data-draft-icon="crop"><Crop size={18} aria-hidden="true" /></template>
  <template data-draft-icon="hide"><Paintbrush size={18} aria-hidden="true" /></template>
  <template data-draft-icon="undo"><Undo2 size={18} aria-hidden="true" /></template>
  <template data-draft-icon="settings"><Settings2 size={20} aria-hidden="true" /></template>
  <template data-draft-icon="loading"><LoaderCircle size={18} aria-hidden="true" /></template>
  <template data-draft-icon="waiting"><Clock size={18} aria-hidden="true" /></template>
  <template data-draft-icon="warning"><TriangleAlert size={18} aria-hidden="true" /></template>
  <dialog class="draft-delete-dialog" data-draft-delete-dialog aria-labelledby="draft-delete-title" aria-describedby="draft-delete-copy">
    <form method="dialog"><img data-draft-delete-cover hidden alt="Item to delete" /><h2 id="draft-delete-title">Delete?</h2><p id="draft-delete-copy"></p><div class="draft-actions"><button type="submit" value="cancel" autofocus>Keep it</button><button type="submit" value="confirm" class="draft-danger"><Trash2 size={18} aria-hidden="true" />Delete</button></div></form>
  </dialog>
  <span class="draft-sr-only" data-draft-copy-status role="status" aria-live="polite"></span>
    <details class="draft-settings draft-global-settings" data-draft-global-settings data-draft-popover>
      <summary hidden>Listing settings</summary>
      <div class="draft-popover-panel" id="draft-global-dialog">
        <button type="button" class="draft-close" data-draft-close aria-label="Close settings"><X size={20} aria-hidden="true" /></button>
        <header class="draft-dialog-header"><h3>Listing settings</h3><p>Defaults for new items.</p><nav class="draft-settings-scope" aria-label="Settings scope"><button type="button" data-draft-action="settings-item" aria-pressed="false" hidden>This item</button><button type="button" data-draft-action="settings-batch" aria-pressed="false" hidden>This batch</button><button type="button" data-draft-action="settings-defaults" aria-pressed="true">Defaults</button></nav></header>
        <div class="draft-settings-content"><ListingSettingsFields scope="global" /><p class="draft-help" data-draft-global-save-status role="status" hidden></p></div>
        <footer class="draft-dialog-footer"><button type="button" class="draft-primary draft-settings-done" data-draft-action="save-global-defaults">Save defaults</button></footer>
      </div>
    </details>
  <details class="draft-settings" data-draft-editor-settings data-draft-popover><summary hidden>Item settings<span data-draft-editor-summary hidden></span></summary><div class="draft-popover-panel" id="draft-item-dialog"><button type="button" class="draft-close" data-draft-close aria-label="Close settings"><X size={20} aria-hidden="true" /></button><header class="draft-dialog-header"><h3>Item settings</h3><p data-draft-settings-context>This item</p><nav class="draft-settings-scope" aria-label="Settings scope"><button type="button" data-draft-action="settings-item" aria-pressed="true" hidden>This item</button><button type="button" data-draft-action="settings-batch" aria-pressed="false" hidden>This batch</button><button type="button" data-draft-action="settings-defaults" aria-pressed="false">Defaults</button></nav></header><div class="draft-settings-content"><p class="draft-help" data-draft-item-save-status role="status" hidden></p><button type="button" data-draft-action="retry-item-settings" hidden>Retry save</button><ListingSettingsFields /><p class="draft-help" data-draft-settings-summary></p><p class="draft-help" data-draft-regenerate-notice hidden>Applies on regeneration. Your existing text stays until a new draft is saved.</p><button type="button" data-draft-action="regenerate"><RotateCcw size={18} aria-hidden="true" />Regenerate · 1 generation</button><button type="button" class="draft-text-button" data-draft-action="save-defaults">Save as my defaults</button><p class="draft-help" data-draft-default-save-status role="status" hidden></p></div><footer class="draft-dialog-footer"><button type="button" class="draft-primary draft-settings-done" data-draft-close>Done</button></footer></div></details>
  <details class="draft-settings draft-batch-settings" data-draft-popover><summary hidden>Batch settings<span data-draft-default-summary hidden></span></summary><div class="draft-popover-panel" id="draft-batch-dialog"><button type="button" class="draft-close" data-draft-close aria-label="Close settings"><X size={20} aria-hidden="true" /></button><header class="draft-dialog-header"><h3>Batch settings</h3><p>For items without custom settings.</p><nav class="draft-settings-scope" aria-label="Settings scope"><button type="button" data-draft-action="settings-item" aria-pressed="false" hidden>This item</button><button type="button" data-draft-action="settings-batch" aria-pressed="true" hidden>This batch</button><button type="button" data-draft-action="settings-defaults" aria-pressed="false">Defaults</button></nav></header><div class="draft-settings-content"><p class="draft-help" data-draft-batch-save-status role="status" hidden></p><ListingSettingsFields scope="batch" /></div><footer class="draft-dialog-footer"><button type="button" class="draft-primary draft-settings-done" data-draft-close>Done</button></footer></div></details>
  <div class="draft-heading">
    <button type="button" class="draft-text-button" data-draft-action="close-import" hidden><ArrowLeft size={18} aria-hidden="true" />Back to drafts</button>
    <h1 data-draft-heading>Drafts</h1>
  </div>
  <p class="draft-notice" data-draft-message role="status" aria-live="polite" hidden></p>
  <button type="button" data-draft-action="reload" data-draft-retry hidden><RotateCcw size={18} aria-hidden="true" />Try again</button>
  <section class="draft-queue" data-draft-queue hidden aria-label="Batch progress">
    <div><strong data-draft-queue-title></strong><p data-draft-queue-copy hidden></p></div>
    <button type="button" class="draft-text-button" data-draft-action="pause"><Pause size={18} aria-hidden="true" />Pause</button><button type="button" data-draft-action="resume" hidden><Play size={18} aria-hidden="true" />Resume</button>
    <div class="draft-queue-items" data-draft-queue-items></div>
  </section>
  <section class="draft-import" data-draft-import hidden aria-label="Add several items">
    <nav class="draft-mode" aria-label="Processing mode"><button type="button" data-draft-action="new">One item</button><button type="button" aria-current="page" data-draft-action="bulk"><span class="draft-new-badge" aria-hidden="true">New</span>Several items</button></nav>
    <PhotoEntry mode="batch" />
    <div class="draft-import-controls" data-draft-import-controls hidden>
      <div class="draft-import-toolbar"><p data-draft-grouping-instruction>Select photos of the same item.</p><label class="draft-add"><Plus size={18} aria-hidden="true" />Add photos<input type="file" accept="image/*" multiple data-draft-input="bulk" /></label></div>

    </div>
    <p class="draft-import-status" data-draft-import-status role="status" hidden></p>
<div class="draft-grouping-layout"><div><div class="draft-photo-grid" data-draft-pool></div><section class="draft-grouping-complete" data-draft-grouping-complete hidden><span class="draft-complete-icon"><Check size={24} aria-hidden="true" /></span><h2>All photos are grouped</h2><p>Your items are saved. Review them or add photos for another item.</p><div class="draft-actions"><button type="button" data-draft-action="add-bulk-photos"><Plus size={18} aria-hidden="true" />Add photos</button></div></section><div class="draft-import-footer" role="region" aria-label="Create items from selected photos" data-draft-import-footer hidden><span data-draft-photo-count></span><div class="draft-actions"><button type="button" class="draft-text-button" data-draft-action="individual" disabled title="Create one item per selected photo">Separate items</button><button type="button" class="draft-primary" data-draft-action="group" disabled><Plus size={18} aria-hidden="true" />Create item</button></div></div></div>
      <aside class="draft-groups" data-draft-groups hidden><h2>Your batch</h2><div data-draft-created-groups></div><div class="draft-group-generation" data-draft-group-generation><p class="draft-help" data-draft-groups-status hidden></p><button type="button" class="draft-primary" data-draft-action="generate-groups"><Play size={18} aria-hidden="true" /><span data-draft-label>Generate ready drafts</span></button><p class="draft-help" data-draft-batch-cost></p></div></aside>
    </div>
  </section>
  <div class="draft-layout">
    <section class="draft-library" aria-label="Saved items">
      <div class="draft-library-heading"><div><h1 class="draft-library-title">Your drafts</h1><p class="draft-storage-scope" title="Clearing this browser’s site data removes its saved drafts and photos.">Saved in this browser</p></div><div class="draft-actions" data-draft-library-actions><span class="draft-allowance" data-draft-allowance hidden></span><details class="draft-add-menu" data-draft-popover><summary class="draft-primary" role="button" aria-label="Add new"><Plus size={18} aria-hidden="true" />Add new<ChevronDown size={16} aria-hidden="true" /></summary><div class="draft-popover-panel" aria-label="Add new item"><button type="button" data-draft-action="new"><Package size={18} aria-hidden="true" /><span>One item</span></button><button type="button" data-draft-action="bulk"><Layers size={18} aria-hidden="true" /><span>Multiple items</span></button></div></details></div></div>
      <div class="draft-library-toolbar"><div class="draft-tabs" aria-label="Item status"><button type="button" data-draft-tab="draft" aria-pressed="true">Drafts</button><button type="button" data-draft-tab="done" aria-pressed="false">Listed</button></div><button type="button" class="draft-text-button" data-draft-action="selection" aria-pressed="false"><span data-draft-label>Select</span></button></div>
      <aside class="draft-import-summary" data-draft-import-summary hidden><Images size={20} aria-hidden="true" /><p data-draft-import-summary-copy></p><button type="button" class="draft-text-button" data-draft-action="bulk">Continue grouping</button></aside>
      <div class="draft-batch-actions" data-draft-batch-actions hidden><button type="button" class="draft-text-button" data-draft-action="select-ready">Select ready items</button><span data-draft-selected-count role="status" aria-live="polite"></span><button type="button" class="draft-text-button draft-danger" data-draft-action="delete-selected" hidden><Trash2 size={18} aria-hidden="true" />Delete selected</button><button type="button" class="draft-primary" data-draft-action="generate-selected" hidden disabled><Play size={18} aria-hidden="true" /><span data-draft-label>Generate drafts</span></button></div>
      <div class="draft-items" data-draft-items aria-busy="true"><p class="draft-help">Loading your drafts…</p></div>
      <button type="button" data-draft-action="more" hidden>Load more</button>
    </section>
    <section class="draft-editor" data-draft-editor hidden aria-labelledby="draft-editor-title">
      <div class="draft-editor-navigation"><button type="button" class="draft-text-button" data-draft-action="back"><ArrowLeft size={18} aria-hidden="true" /><span data-draft-label>Back to drafts</span></button><div class="draft-actions"><button type="button" class="draft-text-button" data-draft-action="previous" aria-label="Previous item"><ChevronLeft size={20} aria-hidden="true" /></button><span data-draft-position></span><button type="button" class="draft-text-button" data-draft-action="next"><span>Next</span><ArrowRight size={18} aria-hidden="true" /></button><details class="draft-item-menu" data-draft-popover><summary aria-label="Item options"><Ellipsis size={20} aria-hidden="true" /></summary><div class="draft-popover-panel"><h3>Item options</h3><button type="button" class="draft-close" data-draft-close aria-label="Close item options"><X size={20} aria-hidden="true" /></button><button type="button" data-draft-action="choose-item"><Images size={18} aria-hidden="true" />Add photos</button><button type="button" class="draft-camera" data-draft-action="choose-camera"><Camera size={18} aria-hidden="true" />Camera</button><button type="button" class="draft-danger" data-draft-action="delete"><Trash2 size={18} aria-hidden="true" />Delete item</button></div></details></div></div>
      <div class="draft-section-heading"><div class="draft-title-group"><h2 id="draft-editor-title">Add item</h2><div class="draft-save-controls"><span class="draft-save-status" data-draft-save-status role="status"></span><button type="button" class="draft-text-button" data-draft-action="save" aria-label="Retry save" title="Retry save" hidden><RotateCcw size={18} aria-hidden="true" /></button></div></div><div class="draft-upload-actions" data-draft-upload-actions hidden><details class="draft-add-menu draft-photo-source" data-draft-popover><summary role="button" aria-label="Add photos"><Images size={18} aria-hidden="true" />Add photos<ChevronDown size={16} aria-hidden="true" /></summary><div class="draft-popover-panel" aria-label="Add photos"><button type="button" data-draft-action="choose-item"><Images size={18} aria-hidden="true" />Photo library</button><button type="button" data-draft-action="choose-camera"><Camera size={18} aria-hidden="true" />Camera</button></div></details></div></div>
      <nav class="draft-mode draft-entry-mode" aria-label="Processing mode"><button type="button" aria-current="page" data-draft-action="new">One item</button><button type="button" data-draft-action="bulk"><span class="draft-new-badge" aria-hidden="true">New</span>Several items</button></nav>
      <p class="draft-entry-help" data-draft-entry-help hidden>Add photos of one item to prepare its listing.</p>
      <p class="draft-help" data-draft-operation-status role="status" hidden></p><button type="button" data-draft-action="check" hidden><RotateCcw size={18} aria-hidden="true" />Check saved result</button>
      <div class="draft-conflict" data-draft-conflict hidden role="alert"><p>This draft changed on another device. Your edits are still here.</p><div class="draft-actions"><button type="button" data-draft-action="load-saved">Load saved version</button><button type="button" data-draft-action="keep-edits">Keep my edits</button></div></div>
      <div class="draft-recovery" data-draft-recovery hidden><p>You have unsaved edits from this tab.</p><button type="button" data-draft-action="restore">Restore edits</button><button type="button" data-draft-action="discard-recovery">Discard edits</button></div>
      <div class="draft-review-layout">
        <div class="draft-preparation" data-draft-preparation>
          <span data-draft-preparation-label hidden>Photos</span>
          <PhotoEntry mode="single" />
          <img class="draft-editor-cover" data-draft-editor-cover hidden alt="Selected item’s cover photo" />
          <div class="draft-item-photos" data-draft-item-photos></div>
          <input type="file" accept="image/*" multiple data-draft-input="item" hidden /><input type="file" accept="image/*" capture="environment" data-draft-input="camera" hidden />
        </div>

        <div class="draft-text-panel">
          <div class="draft-copy-fields" data-draft-copy-fields hidden>
            <div class="draft-field-heading"><label for="draft-title">Title</label><button type="button" class="draft-text-button" data-draft-action="copy-title" aria-label="Copy title"><Copy size={18} aria-hidden="true" /><span data-draft-label>Copy</span></button></div>
            <p class="draft-readable-title" data-draft-read="title"></p><input id="draft-title" data-draft-field="title" type="text" maxlength="200" placeholder="Add a title" autocomplete="off" hidden />
            <div class="draft-field-heading"><label for="draft-description">Description</label><button type="button" class="draft-text-button" data-draft-action="copy-description" aria-label="Copy description"><Copy size={18} aria-hidden="true" /><span data-draft-label>Copy</span></button></div>
            <p class="draft-readable-description" data-draft-read="description"></p><textarea id="draft-description" data-draft-field="description" maxlength="10000" rows="4" placeholder="Add a description" hidden></textarea>
          </div>
          <div class="draft-generation-actions" data-draft-generation-actions hidden><button type="button" class="draft-primary draft-generate" data-draft-action="generate" aria-description="Uses 1 generation" title="Uses 1 generation" disabled><Play size={18} data-draft-generate-play aria-hidden="true" /><LoaderCircle size={18} data-draft-generate-loader aria-hidden="true" hidden /><span data-draft-label>Generate</span></button></div>
          <p class="draft-help" data-draft-generate-help hidden></p>
          <button type="button" class="draft-text-button draft-write" data-draft-action="write">Or write it myself</button>
          <div class="draft-editor-footer" data-draft-editor-footer hidden><button type="button" class="draft-primary" data-draft-action="done"><Check size={18} aria-hidden="true" /><span data-draft-label>Mark as listed</span></button></div>
        </div>
      </div>
    </section>
    <div data-draft-editor-empty hidden></div>
  </div>
</section>
