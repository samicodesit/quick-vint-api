---
import { SUPPORTED_OUTPUT_LANGUAGES } from "../../utils/mobileOutputLanguages";
---
<section class="draft-workspace" data-draft-workspace hidden aria-label="Listing drafts">
  <dialog class="draft-delete-dialog" data-draft-delete-dialog aria-labelledby="draft-delete-title" aria-describedby="draft-delete-copy"><form method="dialog"><h2 id="draft-delete-title">Delete permanently?</h2><p id="draft-delete-copy"></p><div class="draft-actions"><button type="submit" value="cancel" autofocus>Keep it</button><button type="submit" value="confirm" class="draft-danger">Delete permanently</button></div></form></dialog>
  <span class="draft-sr-only" data-draft-copy-status role="status" aria-live="polite"></span>
  <div class="draft-heading">
    <h1>Drafts</h1>
    <div class="draft-actions"><span class="draft-allowance" data-draft-allowance></span><button type="button" data-draft-action="bulk">Bulk upload</button><button type="button" class="draft-primary" data-draft-action="new">+ New draft</button></div>
  </div>
  <p class="draft-notice" data-draft-message role="status" aria-live="polite" hidden></p>
  <button type="button" data-draft-action="reload" data-draft-retry hidden>Try again</button>
  <section class="draft-queue" data-draft-queue hidden aria-label="Batch progress">
    <div><strong data-draft-queue-title></strong><p data-draft-queue-copy></p></div>
    <button type="button" data-draft-action="pause">Pause after this item</button><button type="button" data-draft-action="resume" hidden>Continue remaining</button>
  </section>
  <section class="draft-import" data-draft-import hidden aria-labelledby="draft-import-title">
    <div class="draft-section-heading"><div><h2 id="draft-import-title">Group your photos</h2><p>Select the photos of one item, then create its draft.</p></div><button type="button" data-draft-action="close-import">Back to drafts</button></div>
    <label class="draft-add">+ Add photos<input type="file" accept="image/*" multiple data-draft-input="bulk" /></label>
    <details class="draft-settings"><summary>Settings for new items</summary><div class="draft-settings-grid">
      <label>Title language<select data-draft-default="titleLanguageCode">{SUPPORTED_OUTPUT_LANGUAGES.map(language=><option value={language.code}>{language.label}</option>)}</select></label>
      <label>Description language<select data-draft-default="descriptionLanguageCode">{SUPPORTED_OUTPUT_LANGUAGES.map(language=><option value={language.code}>{language.label}</option>)}</select></label>
      <label>Length<select data-draft-default="descriptionLength"><option value="long">Detailed</option><option value="short">Short</option></select></label>
      <label class="draft-check"><input type="checkbox" data-draft-default="useBulletPoints" checked /> Bullet points</label>
    </div><p class="draft-help">Applies to items you create next. You can change each item’s settings in its draft.</p></details>
    <p data-draft-import-status role="status"></p>
    <div class="draft-photo-grid" data-draft-pool></div>
    <div class="draft-actions"><button type="button" class="draft-primary" data-draft-action="group" disabled>Create item · 0 photos</button><button type="button" data-draft-action="individual" disabled>One item per photo</button></div>
    <p class="draft-help">Up to 100 photos. Ungrouped photos stay saved here.</p>
  </section>
  <aside class="draft-import-summary" data-draft-import-summary hidden><p data-draft-import-summary-copy></p><button type="button" data-draft-action="bulk">Continue grouping</button></aside>
  <div class="draft-layout">
    <aside class="draft-library" aria-label="Saved items">
      <div class="draft-library-toolbar"><div class="draft-tabs" aria-label="Item status"><button type="button" data-draft-tab="draft" aria-pressed="true">Drafts</button><button type="button" data-draft-tab="done" aria-pressed="false">Done</button></div><button type="button" class="draft-text-button" data-draft-action="selection" aria-pressed="false">Select</button></div>
      <div class="draft-batch-actions" data-draft-batch-actions hidden><button type="button" data-draft-action="select-ready">Select ready items</button><span data-draft-selected-count role="status" aria-live="polite"></span></div>
      <button type="button" class="draft-primary draft-batch-button" data-draft-action="generate-selected" hidden disabled>Generate selected items</button>
      <div class="draft-items" data-draft-items aria-busy="true"><p class="draft-help">Loading your drafts…</p></div>
      <button type="button" data-draft-action="more" hidden>Load more</button>
    </aside>
    <section class="draft-editor" data-draft-editor hidden aria-labelledby="draft-editor-title">
      <div class="draft-editor-navigation"><button type="button" data-draft-action="back">← All drafts</button><div><button type="button" data-draft-action="previous" aria-label="Previous item">←</button><span data-draft-position></span><button type="button" data-draft-action="next" aria-label="Next item">→</button><details class="draft-item-menu"><summary aria-label="Draft actions">•••</summary><button type="button" class="draft-danger" data-draft-action="delete">Delete draft</button></details></div></div>
      <div class="draft-section-heading"><img class="draft-editor-cover" data-draft-editor-cover hidden alt="Selected item’s cover photo" /><h2 id="draft-editor-title">New draft</h2><span class="draft-save-status" data-draft-save-status role="status">Saved</span></div>
      <p class="draft-help" data-draft-operation-status role="status"></p>
      <button type="button" data-draft-action="check" hidden>Check saved result</button>
      <div class="draft-conflict" data-draft-conflict hidden role="alert"><p>This draft changed on another device. Your edits are still here.</p><div class="draft-actions"><button type="button" data-draft-action="load-saved">Load saved version</button><button type="button" data-draft-action="keep-edits">Keep my edits</button></div></div>
      <div class="draft-recovery" data-draft-recovery hidden><p>You have unsaved edits from this tab.</p><button type="button" data-draft-action="restore">Restore edits</button><button type="button" data-draft-action="discard-recovery">Discard edits</button></div>
      <details class="draft-preparation" data-draft-preparation open>
      <summary data-draft-preparation-label>Photos</summary>
      <div class="draft-upload-intro" data-draft-upload-intro><svg viewBox="0 0 48 48" fill="none" aria-hidden="true"><rect x="7" y="9" width="34" height="30" rx="6" stroke="currentColor" stroke-width="1.5"/><circle cx="18" cy="19" r="3" stroke="currentColor" stroke-width="1.5"/><path d="m9 33 11-10 8 7 5-5 7 7" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg><h3>Add your item’s photos</h3><p>Generate a title and description from your photos.</p></div>
      <div class="draft-item-photos" data-draft-item-photos></div>
      <div class="draft-actions draft-upload-actions" data-draft-upload-actions><label class="draft-add">+ Add photos<input type="file" accept="image/*" multiple data-draft-input="item" /></label><label class="draft-add draft-camera">Take photo<input type="file" accept="image/*" capture="environment" data-draft-input="camera" /></label><span class="draft-photo-limit">10 photos max</span></div>
      <details class="draft-settings"><summary>Language &amp; style <span data-draft-settings-summary></span></summary><div class="draft-settings-grid">
        <label>Title language<select data-draft-field="titleLanguageCode">{SUPPORTED_OUTPUT_LANGUAGES.map(language=><option value={language.code}>{language.label}</option>)}</select></label>
        <label>Description language<select data-draft-field="descriptionLanguageCode">{SUPPORTED_OUTPUT_LANGUAGES.map(language=><option value={language.code}>{language.label}</option>)}</select></label>
        <label>Length<select data-draft-field="descriptionLength"><option value="long">Detailed</option><option value="short">Short</option></select></label>
        <label class="draft-check"><input type="checkbox" data-draft-field="useBulletPoints" /> Bullet points</label>
      </div></details>
      <div class="draft-generation-actions" data-draft-generation-actions hidden><button type="button" class="draft-primary draft-generate" data-draft-action="generate" disabled>Generate listing</button><span class="draft-help">Uses 1 generation</span></div>
      <p class="draft-help" data-draft-generate-help hidden></p>
      <p class="draft-originals" data-draft-originals hidden>Keep your original photos for publishing.</p>
      </details>
      <button type="button" class="draft-text-button draft-write" data-draft-action="write">Write it myself</button>
      <div class="draft-copy-fields" data-draft-copy-fields hidden>
      <div class="draft-field-heading"><label for="draft-title">Title</label><button type="button" data-draft-action="copy-title">Copy title</button></div>
      <input id="draft-title" data-draft-field="title" type="text" maxlength="200" placeholder="Add a title" autocomplete="off" />
      <div class="draft-field-heading"><label for="draft-description">Description</label><button type="button" data-draft-action="copy-description">Copy description</button></div>
      <textarea id="draft-description" data-draft-field="description" maxlength="10000" rows="6" placeholder="Add a description"></textarea>
      <div class="draft-editor-footer"><span class="draft-help">Copy, then publish on your marketplace.</span><button type="button" data-draft-action="done">Mark as done</button></div>
      </div>
      <button type="button" data-draft-action="save" hidden>Retry save</button>
    </section>
    <div data-draft-editor-empty hidden></div>
  </div>
</section>
