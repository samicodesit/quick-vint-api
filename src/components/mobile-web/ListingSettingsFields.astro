---
import DraftSelect from "./DraftSelect.astro";
import { List, AlignLeft, Hash, Smile, StickyNote, LockKeyhole } from "@lucide/astro";
const { scope = "item" } = Astro.props;
const attribute = scope === "global" ? "data-draft-global" : scope === "batch" ? "data-draft-default" : "data-draft-field";
const field = (name: string) => ({ [attribute]: name });
---
<div class="draft-settings-grid" data-settings-scope={scope}>
  <div class="draft-language-fields">
    <DraftSelect scope={scope} attribute={attribute} name="titleLanguageCode" label="Title language" />
    <DraftSelect scope={scope} attribute={attribute} name="descriptionLanguageCode" label="Description language" />
  </div>
  <fieldset class="draft-choice"><legend>Description length</legend><div>
    <label><input type="radio" name={`${scope}-length`} value="long" {...field("descriptionLength")} /><span>Long</span></label>
    <label><input type="radio" name={`${scope}-length`} value="short" {...field("descriptionLength")} /><span>Short</span></label>
  </div></fieldset>
  <fieldset class="draft-choice"><legend>Text format</legend><div>
    <label><input type="radio" name={`${scope}-format`} value="true" {...field("useBulletPoints")} /><span><List size={16} aria-hidden="true" />Bullet points</span></label>
    <label><input type="radio" name={`${scope}-format`} value="false" {...field("useBulletPoints")} /><span><AlignLeft size={16} aria-hidden="true" />Paragraphs</span></label>
  </div></fieldset>
  <DraftSelect scope={scope} attribute={attribute} name="tone" label="Description tone" kind="tone" />
  <div class="draft-switches">
    <label class="draft-switch"><span><Hash size={16} aria-hidden="true" />Hashtags</span><input type="checkbox" role="switch" {...field("useHashtags")} /></label>
    <label class="draft-switch"><span><Smile size={16} aria-hidden="true" />Emojis<a class="draft-setting-lock" data-draft-plan-lock href="/app?plans=1" target="_blank" rel="noopener noreferrer" aria-label="Emojis: locked, view plans" hidden><LockKeyhole size={14} aria-hidden="true" /></a></span><input type="checkbox" role="switch" aria-label="Emojis" {...field("useEmojis")} /></label>
    <label class="draft-switch"><span><StickyNote size={16} aria-hidden="true" />Include seller note<a class="draft-setting-lock" data-draft-plan-lock href="/app?plans=1" target="_blank" rel="noopener noreferrer" aria-label="Include seller note: locked, view plans" hidden><LockKeyhole size={14} aria-hidden="true" /></a></span><input type="checkbox" role="switch" aria-label="Include seller note" {...field("includeSellerNote")} /></label>
  </div>
  <div class="draft-note-field"><div class="um-note-heading"><label for={`${scope}-seller-note`}>Seller note</label>{import.meta.env.PUBLIC_USER_MODELS_ENABLED === "true" && <button type="button" class="um-settings-entry" data-user-model-open><svg viewBox="0 0 32 40" fill="none" aria-hidden="true"><path d="M6 36V12a10 10 0 0 1 20 0v24Z" stroke="currentColor" stroke-width="2"/><circle cx="16" cy="12" r="3" fill="currentColor"/><path d="M11 22c0-6 10-6 10 0m-5-5v13m-1-6-3 7m5-7 3 7" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>Your model</button>}</div><p id={`${scope}-note-error`} class="draft-settings-error" data-draft-settings-error role="status" hidden></p><textarea id={`${scope}-seller-note`} aria-label="Seller note" {...field("descriptionFooterText")} maxlength="240" rows="3" placeholder="Smoke-free home. Happy to bundle items." aria-describedby={`${scope}-note-help ${scope}-note-error`}></textarea><span class="draft-note-meta"><small id={`${scope}-note-help`}>Saved when excluded. No links or contact details.</small><small data-draft-note-count>0/240</small></span></div>
</div>
