---
export interface PhotoRailItem {
  id: string;
  src?: string;
  alt?: string;
  status?: "ready" | "uploading" | "uploaded" | "error";
}

interface Props {
  photos?: PhotoRailItem[];
  editable?: boolean;
  compact?: boolean;
}

const { photos = [], editable = true, compact = false } = Astro.props;
---

<section
  class:list={['mobile-photo-rail', { 'is-compact': compact }]}
  data-mobile-web="photo-rail"
  aria-label="Selected photos"
>
  <button type="button" class="photo-empty-state" data-mobile-web="photo-empty-state">
    <span class="photo-empty-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none">
        <path d="M5.25 8.25h2.1l1.4-2h6.5l1.4 2h2.1c.83 0 1.5.67 1.5 1.5v8.5c0 .83-.67 1.5-1.5 1.5h-13.5c-.83 0-1.5-.67-1.5-1.5v-8.5c0-.83.67-1.5 1.5-1.5Z" fill="currentColor" />
        <circle cx="12" cy="14" r="3.15" fill="var(--mobile-brand)" />
      </svg>
    </span>
    <strong>Add photos of your item</strong>
    <span>Tap to take a photo or choose from your gallery</span>
  </button>
  <div class="photo-rail-scroll" data-mobile-web="photo-list" role="list">
    {photos.map((photo, index) => (
      <div class="photo-tile" data-photo-id={photo.id} data-status={photo.status ?? "ready"} role="listitem">
        {photo.src ? (
          <img src={photo.src} alt={photo.alt ?? `Selected photo ${index + 1}`} loading="lazy" />
        ) : (
          <span class="photo-placeholder" aria-hidden="true">{index + 1}</span>
        )}
        {photo.status === "uploading" && <span class="photo-status" aria-label="Uploading" />}
        {photo.status === "error" && <span class="photo-error" aria-label="Upload failed">!</span>}
        {editable && (
          <button
            class="photo-remove"
            type="button"
            data-photo-remove={photo.id}
            aria-label={`Remove photo ${index + 1}`}
          >
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15" /></svg>
          </button>
        )}
      </div>
    ))}
    {editable && (
      <button class="photo-add" type="button" data-mobile-web="add-photo" aria-label="Add photos">
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 4v12M4 10h12" /></svg>
        <span>Add</span>
      </button>
    )}
  </div>
</section>

<style>
  .mobile-photo-rail {
    width: 100%;
    min-width: 0;
  }

  .photo-empty-state {
    display: grid;
    place-items: center;
    gap: 7px;
    width: 100%;
    min-height: 152px;
    padding: 14px 12px;
    border: 1.5px dashed #b8b9ec;
    border-radius: 14px;
    background: #fbfbff;
    color: var(--mobile-ink);
    cursor: pointer;
    text-align: center;
  }

  .photo-empty-state:hover {
    border-color: var(--mobile-brand);
    background: #f7f7ff;
  }

  .photo-empty-state strong {
    margin-top: 4px;
    color: var(--mobile-ink);
    font-size: 16px;
    letter-spacing: -0.025em;
  }

  .photo-empty-state > span:last-child {
    color: var(--mobile-muted);
    font-size: 13px;
    line-height: 1.35;
  }

  .photo-empty-icon {
    display: grid;
    place-items: center;
    width: 66px;
    height: 66px;
    border-radius: 50%;
    background: #f0f1ff;
    color: var(--mobile-brand);
  }

  .photo-empty-icon svg {
    width: 34px;
    height: 34px;
  }

  .photo-empty-icon circle {
    fill: #ffffff;
  }

  .photo-rail-scroll {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 78px;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    padding: 4px 2px 8px;
    scrollbar-width: thin;
  }

  .photo-rail-scroll[hidden] {
    display: none;
  }

  .photo-tile,
  .photo-add {
    position: relative;
    flex: 0 0 68px;
    width: 68px;
    height: 68px;
    overflow: visible;
    border-radius: 14px;
  }

  .photo-tile {
    background: #f1f0fa;
    box-shadow: 0 1px 0 rgba(35, 28, 91, 0.04);
  }

  .photo-tile img,
  .photo-placeholder {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: inherit;
    object-fit: cover;
  }

  .photo-placeholder {
    display: grid;
    place-items: center;
    color: #6d68a9;
    font-size: 18px;
    font-weight: 750;
  }

  .photo-remove {
    position: absolute;
    top: -10px;
    right: -10px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid #e8e6f4;
    border-radius: 999px;
    background: #fff;
    color: #2c275f;
    box-shadow: 0 4px 14px rgba(28, 22, 74, 0.13);
    cursor: pointer;
    touch-action: manipulation;
  }

  .photo-remove svg,
  .photo-add svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-width: 1.8;
  }

  .photo-add {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 3px;
    border: 1px dashed #b8b3e8;
    background: #faf9ff;
    color: #4d46b8;
    font-size: 11px;
    font-weight: 750;
    cursor: pointer;
  }

  .photo-add svg { width: 16px; height: 16px; }

  .photo-status {
    position: absolute;
    right: 5px;
    bottom: 5px;
    width: 9px;
    height: 9px;
    border: 2px solid #fff;
    border-radius: 999px;
    background: #7b73e8;
    box-shadow: 0 0 0 3px rgba(123, 115, 232, 0.2);
  }

  .photo-error {
    position: absolute;
    right: 5px;
    bottom: 5px;
    display: grid;
    place-items: center;
    width: 18px;
    height: 18px;
    border-radius: 999px;
    background: #b6435f;
    color: #fff;
    font-size: 12px;
    font-weight: 800;
  }

  .photo-remove:focus-visible,
  .photo-add:focus-visible {
    outline: 3px solid rgba(79, 70, 229, 0.28);
    outline-offset: 2px;
  }

  @media (min-width: 640px) {
    .photo-tile,
    .photo-add { flex-basis: 76px; width: 76px; height: 76px; }
    .photo-rail-scroll { min-height: 86px; }
  }

  @media (max-width: 380px) {
    .photo-empty-state {
      min-height: 144px;
    }
  }

  .mobile-photo-rail.is-compact .photo-rail-scroll {
    min-height: 64px;
    gap: 8px;
    overflow-y: hidden;
    padding-top: 2px;
    padding-bottom: 6px;
  }

  .mobile-photo-rail.is-compact .photo-tile,
  .mobile-photo-rail.is-compact .photo-add {
    flex-basis: 56px;
    width: 56px;
    height: 56px;
    border-radius: 12px;
  }

  @media (prefers-reduced-motion: reduce) {
    .photo-rail-scroll { scroll-behavior: auto; }
  }
</style>
