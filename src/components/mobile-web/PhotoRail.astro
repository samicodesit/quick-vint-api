---
export interface PhotoRailItem {
  id: string;
  src?: string;
  alt?: string;
  status?: "ready" | "uploading" | "uploaded" | "error";
}

interface Props {
  photos?: PhotoRailItem[];
  editable?: boolean;
  compact?: boolean;
}

const { photos = [], editable = true, compact = false } = Astro.props;
---

<section
  class:list={['mobile-photo-rail', { 'is-compact': compact }]}
  data-mobile-web="photo-rail"
  aria-label="Selected photos"
>
  <div class="photo-rail-scroll" data-mobile-web="photo-list" role="list">
    {photos.map((photo, index) => (
      <div class="photo-tile" data-photo-id={photo.id} data-status={photo.status ?? "ready"} role="listitem">
        {photo.src ? (
          <img src={photo.src} alt={photo.alt ?? `Selected photo ${index + 1}`} loading="lazy" />
        ) : (
          <span class="photo-placeholder" aria-hidden="true">{index + 1}</span>
        )}
        {photo.status === "uploading" && <span class="photo-status" aria-label="Uploading" />}
        {photo.status === "error" && <span class="photo-error" aria-label="Upload failed">!</span>}
        {editable && (
          <button
            class="photo-remove"
            type="button"
            data-photo-remove={photo.id}
            aria-label={`Remove photo ${index + 1}`}
          >
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15" /></svg>
          </button>
        )}
      </div>
    ))}
    {editable && (
      <button class="photo-add" type="button" data-mobile-web="add-photo" aria-label="Add photos">
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 4v12M4 10h12" /></svg>
        <span>Add</span>
      </button>
    )}
  </div>
</section>

<style>
  .mobile-photo-rail {
    width: 100%;
    min-width: 0;
  }

  .photo-rail-scroll {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 78px;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    padding: 4px 2px 8px;
    scrollbar-width: thin;
  }

  .photo-tile,
  .photo-add {
    position: relative;
    flex: 0 0 68px;
    width: 68px;
    height: 68px;
    overflow: visible;
    border-radius: 14px;
  }

  .photo-tile {
    background: #f1f0fa;
    box-shadow: 0 1px 0 rgba(35, 28, 91, 0.04);
  }

  .photo-tile img,
  .photo-placeholder {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: inherit;
    object-fit: cover;
  }

  .photo-placeholder {
    display: grid;
    place-items: center;
    color: #6d68a9;
    font-size: 18px;
    font-weight: 750;
  }

  .photo-remove {
    position: absolute;
    top: -10px;
    right: -10px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid #e8e6f4;
    border-radius: 999px;
    background: #fff;
    color: #2c275f;
    box-shadow: 0 4px 14px rgba(28, 22, 74, 0.13);
    cursor: pointer;
    touch-action: manipulation;
  }

  .photo-remove svg,
  .photo-add svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-width: 1.8;
  }

  .photo-add {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 3px;
    border: 1px dashed #b8b3e8;
    background: #faf9ff;
    color: #4d46b8;
    font-size: 11px;
    font-weight: 750;
    cursor: pointer;
  }

  .photo-add svg { width: 16px; height: 16px; }

  .photo-status {
    position: absolute;
    right: 5px;
    bottom: 5px;
    width: 9px;
    height: 9px;
    border: 2px solid #fff;
    border-radius: 999px;
    background: #7b73e8;
    box-shadow: 0 0 0 3px rgba(123, 115, 232, 0.2);
  }

  .photo-error {
    position: absolute;
    right: 5px;
    bottom: 5px;
    display: grid;
    place-items: center;
    width: 18px;
    height: 18px;
    border-radius: 999px;
    background: #b6435f;
    color: #fff;
    font-size: 12px;
    font-weight: 800;
  }

  .photo-remove:focus-visible,
  .photo-add:focus-visible {
    outline: 3px solid rgba(79, 70, 229, 0.28);
    outline-offset: 2px;
  }

  @media (min-width: 640px) {
    .photo-tile,
    .photo-add { flex-basis: 76px; width: 76px; height: 76px; }
    .photo-rail-scroll { min-height: 86px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .photo-rail-scroll { scroll-behavior: auto; }
  }
</style>
