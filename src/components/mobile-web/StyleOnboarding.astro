---
import { AlignLeft, List, Hash, Smile, StickyNote, ChevronRight, X } from "@lucide/astro";
import DraftSelect from "./DraftSelect.astro";
---
<section class="style-setup" data-style-setup hidden aria-labelledby="style-heading">
  <header class="style-heading-row"><h1 id="style-heading" tabindex="-1" data-style-copy="heading">Your listing style</h1><h2 id="style-example-label" data-style-copy="example">Example</h2></header>
  <section class="style-example" aria-labelledby="style-example-label"><article class="style-preview" tabindex="0" data-style-preview>
    <header class="style-example-item"><div class="style-example-photo"><img src="/app/maje-source.webp" alt="Maje" width="1187" height="668" loading="lazy" decoding="async" /></div><h3 data-style-title></h3></header>
    <p data-style-intro></p><ul data-style-details></ul><p data-style-text hidden></p><p class="style-preview-note" data-style-note-preview hidden></p><p data-style-hashtags hidden></p>
  </article></section>
  <section class="style-controls" aria-label="Listing style">
    <div class="style-languages"><DraftSelect scope="style" attribute="data-style-field" name="titleLanguageCode" label="Title" /><DraftSelect scope="style" attribute="data-style-field" name="descriptionLanguageCode" label="Description" /></div>
    <div class="style-row"><span data-style-copy="length">Length</span><div class="style-segment" role="group" data-style-group="length"><button type="button" data-style-length="short" aria-pressed="true" data-style-copy="short">Short</button><button type="button" data-style-length="long" aria-pressed="false" data-style-copy="long">Long</button></div></div>
    <div class="style-row"><span data-style-copy="format">Format</span><div class="style-segment" role="group" data-style-group="format"><button type="button" data-style-format="bullets" aria-pressed="true"><List size={16} aria-hidden="true" /><span data-style-copy="bullets">Bullets</span></button><button type="button" data-style-format="text" aria-pressed="false"><AlignLeft size={16} aria-hidden="true" /><span data-style-copy="paragraphs">Text</span></button></div></div>
    <div class="style-extras"><button type="button" class="style-toggle" role="switch" aria-checked="true" data-style-toggle="hashtags"><span class="style-switch-track" aria-hidden="true"></span><Hash size={16} aria-hidden="true" /><span data-style-copy="hashtags">Hashtags</span></button><button type="button" class="style-toggle" role="switch" aria-checked="true" data-style-toggle="emojis"><span class="style-switch-track" aria-hidden="true"></span><Smile size={16} aria-hidden="true" /><span data-style-copy="emojis">Emojis</span></button></div>
    <div class="style-note-row"><button type="button" class="style-note-add" data-style-edit-note><StickyNote size={16} aria-hidden="true" /><span data-style-note-label>Add seller note</span><ChevronRight size={16} aria-hidden="true" /></button><button type="button" class="style-toggle" role="switch" aria-checked="false" data-style-toggle="includeNote" hidden><span class="style-switch-track" aria-hidden="true"></span><StickyNote size={16} aria-hidden="true" /><span data-style-copy="note">Seller note</span></button><button type="button" class="style-note-edit" data-style-edit-existing hidden aria-label="Seller note"><ChevronRight size={16} aria-hidden="true" /></button></div>
  </section>
  <footer class="style-footer"><button type="button" class="style-primary" data-style-finish data-style-copy="useStyle">Use this style</button><button type="button" class="style-skip" data-style-skip data-style-copy="skip">Skip</button><p data-style-save-error role="status" hidden></p></footer>
  <dialog class="style-note-dialog" data-style-note-dialog aria-labelledby="style-note-heading"><header><h2 id="style-note-heading" data-style-copy="note">Seller note</h2><button type="button" data-style-dismiss-note aria-label="Close"><X size={20} aria-hidden="true" /></button></header><textarea data-style-note-input aria-label="Seller note" maxlength="240" rows="3"></textarea><p data-style-note-error role="status" hidden></p><button type="button" class="style-primary" data-style-save-note data-style-copy="done">Done</button></dialog>
</section>
