---
import { UserRound, ChevronDown, Camera, Images, Play, X, Settings2, Coins } from "@lucide/astro";
import PhotoRail from "./PhotoRail.astro";
import ListingControls from "./ListingControls.astro";
import ListingResult from "./ListingResult.astro";
import DraftWorkspace from "./DraftWorkspace.astro";

interface Props {
  titleLanguageCode?: string;
  descriptionLanguageCode?: string;
}

const {
  titleLanguageCode = "en",
  descriptionLanguageCode = "en",
} = Astro.props;
---

<div class="mobile-workspace-shell" data-mobile-web="workspace" data-state="loading">
  <header class="mobile-workspace-header">
    <a class="mobile-workspace-brand" href="/app" aria-label="AutoLister drafts">AutoLister</a>
    <div class="mobile-workspace-header-actions" data-mobile-web="profile-menu-root" hidden>
      <button type="button" class="mobile-header-settings" data-draft-global-trigger aria-label="Listing settings" aria-haspopup="dialog" aria-controls="draft-global-dialog" aria-expanded="false" hidden><Settings2 size={18} aria-hidden="true" /><span>Settings</span></button>
      <button
        type="button"
        class="mobile-profile-menu-trigger"
        data-mobile-web="profile-menu-trigger"
        aria-controls="mobile-profile-menu"
        aria-expanded="false"
        aria-label="Account menu"
      >
        <span class="mobile-profile-avatar" aria-hidden="true"><UserRound size={20} /></span>
        <ChevronDown class="mobile-profile-chevron" size={18} aria-hidden="true" />
      </button>
      <div
        id="mobile-profile-menu"
        class="mobile-profile-menu"
        data-mobile-web="profile-menu"
        role="region"
        aria-label="Account"
        hidden
      >
        <p data-mobile-web="account-status" class="mobile-form-status" data-tone="error" role="status"></p><button type="button" class="mobile-account-close" data-mobile-web="close-account" aria-label="Close account"><X size={20} aria-hidden="true" /></button><strong class="mobile-account-plan" data-mobile-web="account-plan">Your account</strong>
      <section class="mobile-usage-card" data-mobile-web="usage" aria-label="Usage" aria-live="polite" hidden>
        <div class="mobile-usage-grid">
          <div class="mobile-usage-cell" data-mobile-web="usage-paid">
            <span class="mobile-usage-label">Today</span>
            <strong data-mobile-web="usage-daily-value"></strong>
            <span class="mobile-usage-track" data-mobile-web="usage-daily-track" aria-hidden="true">
              <span data-mobile-web="usage-daily-progress"></span>
            </span>
          </div>
          <div class="mobile-usage-cell" data-mobile-web="usage-paid">
            <span class="mobile-usage-label">This month</span>
            <strong data-mobile-web="usage-monthly-value"></strong>
            <span class="mobile-usage-track" data-mobile-web="usage-monthly-track" aria-hidden="true">
              <span data-mobile-web="usage-monthly-progress"></span>
            </span>
          </div>
          <div class="mobile-usage-cell mobile-usage-free" data-mobile-web="usage-free" hidden>
            <span class="mobile-usage-label">Free</span>
            <strong data-mobile-web="usage-free-value"></strong>
          </div>
          <div class="mobile-usage-cell mobile-extra-credits" data-mobile-web="usage-credits">
            <span class="mobile-usage-label"><Coins size={18} aria-hidden="true" />Extra credits</span>
            <strong data-mobile-web="usage-credits-value">0</strong>
          </div>
        </div>
        <strong class="mobile-usage-unavailable" data-mobile-web="usage-headline" hidden></strong>
      </section>
        <button type="button" class="mobile-profile-menu-item" data-mobile-web="upgrade" data-tier="starter" hidden>Upgrade</button>
        <button type="button" class="mobile-profile-menu-item" data-mobile-web="manage-billing" hidden>Manage plan</button>
        <button type="button" class="mobile-profile-menu-item" data-mobile-web="sign-out" hidden>Sign out</button>
      </div>
    </div>
  </header>

  <main class="mobile-workspace-main">
    <section class="mobile-auth-card" data-mobile-web="auth-card" aria-labelledby="mobile-auth-title" hidden>
      <h1 id="mobile-auth-title">Sign in</h1>
      <div data-mobile-web="auth-choices">
        <button type="button" class="mobile-google-button" data-mobile-web="google-sign-in"><img class="mobile-google-mark" src="/app/google-g.png" width="20" height="20" alt="" />Continue with Google</button>
        <div class="mobile-auth-divider" aria-hidden="true"><span>or use email</span></div>
        <form data-mobile-web="email-form" class="mobile-email-form">
          <label for="mobile-email">Email address</label>
          <input id="mobile-email" name="email" type="email" autocomplete="email" inputmode="email" required placeholder="you@example.com" />
          <button type="submit" class="mobile-primary-button">Continue</button>
        </form>
      </div>
      <form data-mobile-web="otp-form" class="mobile-otp-form" hidden>
        <p class="mobile-field-help">Code sent to <strong data-mobile-web="auth-email"></strong></p><label for="mobile-otp">6-digit code</label>
        <input id="mobile-otp" name="otp" type="text" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" aria-describedby="mobile-otp-help" />
        <p id="mobile-otp-help" class="mobile-field-help">The same email also includes a secure sign-in link.</p>
        <div class="mobile-auth-actions">
          <button type="button" class="mobile-text-button" data-mobile-web="resend-code">Resend code</button>
          <button type="button" class="mobile-text-button" data-mobile-web="change-email">Change email</button>
        </div>
      </form>
      <p class="mobile-form-status" data-mobile-web="auth-status" role="status" aria-live="polite"></p>
    </section>

    <section class="mobile-app-view" data-mobile-web="app-view" hidden aria-labelledby="mobile-app-title">
      <div class="mobile-app-heading">
        <div>
          <p class="mobile-eyebrow">New listing</p>
          <h1 id="mobile-app-title">What are you selling?</h1>
        </div>
      </div>



      <DraftWorkspace />
      <section class="mobile-upload-card" data-mobile-web="upload-card" aria-labelledby="mobile-upload-title">
        <div class="mobile-upload-card-heading">
          <div>
            <h2 id="mobile-upload-title">Item photos</h2>
            <p data-mobile-web="photo-count">No photos yet</p>
          </div>
          <span class="mobile-upload-status" data-mobile-web="upload-status" aria-live="polite"></span>
        </div>
        <PhotoRail editable={true} />
        <div class="mobile-photo-actions">
          <label class="mobile-photo-action">
            <input type="file" accept="image/*" capture="environment" data-mobile-web="camera-input" />
            <Camera size={20} aria-hidden="true" />
            Take photo
          </label>
          <label class="mobile-photo-action">
            <input type="file" accept="image/*" multiple data-mobile-web="gallery-input" />
            <Images size={20} aria-hidden="true" />
            Choose from gallery
          </label>
        </div>
      </section>

      <ListingControls
        selectedTitleLanguageCode={titleLanguageCode}
        selectedDescriptionLanguageCode={descriptionLanguageCode}
        descriptionLength="long"
        useBulletPoints={true}
      />

      <section class="mobile-generation-panel" data-mobile-web="generation-panel" aria-live="polite">
        <div class="mobile-generation-progress" data-mobile-web="generation-progress" hidden>
          <span class="mobile-generation-orb" aria-hidden="true"><span></span></span>
          <div>
            <strong data-mobile-web="generation-progress-title">Preparing your listing</strong>
            <p data-mobile-web="generation-progress-copy">Your photos are being securely prepared.</p>
          </div>
          <button type="button" class="mobile-text-button" data-mobile-web="cancel-generation">Cancel</button>
        </div>
        <p class="mobile-generation-status" data-mobile-web="generation-status" role="status"></p>
        <button type="button" class="mobile-primary-button mobile-generate-button" data-mobile-web="generate" disabled>
          <Play size={20} aria-hidden="true" />
          <span class="mobile-generate-button-label">Generate listing</span>
        </button>
        <p class="mobile-generation-helper" data-mobile-web="generation-helper">Add at least one photo to continue</p>
      </section>

      <ListingResult />
    </section>

    <section class="mobile-state-card" data-mobile-web="state-card" aria-live="polite" hidden>
      <p class="mobile-eyebrow" data-mobile-web="state-eyebrow">AutoLister</p>
      <h2 data-mobile-web="state-title"></h2>
      <p data-mobile-web="state-copy"></p>
      <button type="button" class="mobile-primary-button" data-mobile-web="state-action" hidden></button>
    </section>
  </main>

  <footer class="mobile-workspace-footer" data-mobile-web="legal-disclaimer">
    AutoLister is not affiliated with Vinted.
  </footer>
</div>
