---
import "@fontsource-variable/inter";
import "@fontsource-variable/inter-tight";
import "atropos/css";
import SiteLayout from "../../layouts/SiteLayout.astro";
import LanguageSwitcher from "../LanguageSwitcher.astro";
import ReleaseScreenshot from "./ReleaseScreenshot.astro";
import { UPDATE_140_COPY } from "../../i18n/update140.js";
import type { SiteLocale } from "../../i18n/site.js";

interface Props { locale: SiteLocale }

const { locale } = Astro.props;
const copy = UPDATE_140_COPY[locale];
const releasePath = `/updates/1-4-0/${locale}`;
const canonical = `https://autolister.app${releasePath}`;

const shots = {
  wardrobe: {
    src: "/updates/1-4-0/wardrobe-rewrite.webp",
    file: "wardrobe-rewrite.webp",
    label: "Wardrobe widget, selected listings, and rewrite toolbar",
    guidance: "1600 × 1200 · Keep the header, toolbar, and listing grid visible",
    alt: copy.shots.wardrobe,
  },
  phone: {
    src: "/updates/1-4-0/phone-batch-upload.webp",
    file: "phone-batch-upload.webp",
    label: "Phone upload and desktop batch receiving state",
    guidance: "1600 × 1000 · Show completed uploads and desktop receiving",
    alt: copy.shots.phone,
  },
  review: {
    src: "/updates/1-4-0/review-first.webp",
    file: "review-first.webp",
    label: "Review-first title and description suggestions",
    guidance: "1600 × 1000 · Keep both suggestion actions readable",
    alt: copy.shots.review,
  },
};
---

<SiteLayout
  title={copy.seo.title}
  description={copy.seo.description}
  canonical={canonical}
  ogUrl={canonical}
  htmlLang={locale}
  currentLocale={locale}
  pathPattern="/updates/1-4-0/{lang}"
  minimalChrome
>
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
    {Object.keys(UPDATE_140_COPY).map((lang) => <link rel="alternate" hreflang={lang} href={`https://autolister.app/updates/1-4-0/${lang}`} />)}
    <link rel="alternate" hreflang="x-default" href="https://autolister.app/updates/1-4-0/en" />
  </Fragment>

  <main class="launch-page">
    <header class="launch-nav" aria-label={copy.nav.releaseLabel}>
      <a href={locale === "en" ? "/" : `/${locale}/`} aria-label={copy.nav.homeLabel}>AutoLister <span>AI</span></a>
      <div class="launch-controls">
        <p>{copy.nav.version} 1.4.0</p>
        <LanguageSwitcher currentLocale={locale} pathPattern="/updates/1-4-0/{lang}" className="release-lang-switcher" />
      </div>
    </header>
    <div class="progress" aria-hidden="true"><span></span></div>
    <div class="journey-guide" aria-hidden="true">
      <span>{copy.scroll.continue}</span>
      <svg viewBox="0 0 24 24"><path d="M12 3v18m0 0 7.5-7.5M12 21l-7.5-7.5" /></svg>
    </div>

    <section class="hero-scene" aria-labelledby="release-title">
      <div class="hero-stage">
        <div class="aura aura-one" aria-hidden="true"></div>
        <div class="aura aura-two" aria-hidden="true"></div>
        <div class="hero-copy">
          <p class="eyebrow hero-kicker">{copy.hero.eyebrow}</p>
          <h1 id="release-title">{copy.hero.title}</h1>
          <p class="hero-lede">{copy.hero.body}</p>
          <div class="hero-actions">
            <button class="scroll-action" type="button" data-scroll-explore>
              <span>{copy.scroll.explore}</span>
              <span class="scroll-action-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3v18m0 0 7.5-7.5M12 21l-7.5-7.5" /></svg></span>
            </button>
          </div>
        </div>
        <div class="hero-mascot" aria-hidden="true">
          <img src="/updates/1-4-0/wardrobe-rewrite-character.webp" alt="" />
        </div>
        <div class="hero-product"><ReleaseScreenshot {...shots.wardrobe} eager /></div>
        <div class="hero-caption">
          <p class="eyebrow">{copy.hero.feature}</p>
          <strong>{copy.hero.featureBody}</strong>
        </div>
      </div>
    </section>

    <section class="feature-scene feature-phone" aria-labelledby="phone-title">
      <div class="feature-stage">
        <div class="feature-aura" aria-hidden="true"></div>
        <div class="feature-visual"><ReleaseScreenshot {...shots.phone} /></div>
        <div class="feature-copy">
          <p class="eyebrow">{copy.batch.eyebrow}</p>
          <h2 id="phone-title">{copy.batch.title}</h2>
          <p>{copy.batch.body}</p>
          <ul aria-label={copy.batch.benefitsLabel}>
            {copy.batch.benefits.map((benefit) => <li>{benefit}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class="feature-scene feature-review" aria-labelledby="review-title">
      <div class="feature-stage">
        <div class="feature-aura" aria-hidden="true"></div>
          <div class="feature-copy">
          <p class="eyebrow">{copy.review.eyebrow}</p>
          <h2 id="review-title">{copy.review.title}</h2>
          <p>{copy.review.body}</p>
        </div>
        <div class="feature-visual"><ReleaseScreenshot {...shots.review} /></div>
      </div>
    </section>

    <section class="release-summary" aria-label={copy.summary.label}>
      {copy.summary.items.map((item) => <article><span>{item.eyebrow}</span><strong>{item.title}</strong><p>{item.body}</p></article>)}
    </section>

    <section class="closing" aria-labelledby="closing-title">
      <div class="closing-aura" aria-hidden="true"></div>
      <p class="eyebrow">AutoLister 1.4</p>
      <h2 id="closing-title">{copy.closing.title}</h2>
      <p>{copy.closing.body}</p>
      <a class="primary-action" data-vinted-cta href="https://www.vinted.com/">{copy.closing.action} <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" /></svg></a>
    </section>
    <footer><a href={locale === "en" ? "/" : `/${locale}/`}>AutoLister AI</a><span>{copy.nav.version} 1.4.0</span></footer>
  </main>

  <script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    import { SplitText } from "gsap/SplitText";
    import Atropos from "atropos";
    import { detectUserCountryAndGetVintedUrl } from "../../../utils/vintedRedirect";

    gsap.registerPlugin(ScrollTrigger, SplitText);
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const finePointer = matchMedia("(hover: hover) and (pointer: fine)").matches;
    const vintedOrigin = new URL(detectUserCountryAndGetVintedUrl()).origin;
    document.querySelectorAll<HTMLAnchorElement>("[data-vinted-cta]").forEach((link) => link.href = vintedOrigin);
    document.querySelector<HTMLButtonElement>("[data-scroll-explore]")?.addEventListener("click", () => {
      scrollBy({ top: Math.min(innerHeight * 0.78, 720), behavior: reduced ? "auto" : "smooth" });
    });

    document.fonts.ready.then(() => {
      const heroTitle = document.querySelector<HTMLElement>(".hero-copy h1");
      if (!reduced && heroTitle) {
        const split = SplitText.create(heroTitle, { type: "lines", mask: "lines", aria: "auto" });
        gsap.timeline({ defaults: { ease: "power4.out" } })
          .from(".hero-kicker", { y: 18, autoAlpha: 0, duration: 0.6 })
          .from(split.lines, { yPercent: 115, duration: 1.1, stagger: 0.09 }, 0.06)
          .from(".hero-lede", { y: 26, autoAlpha: 0, duration: 0.75 }, 0.4)
          .from(".hero-actions", { y: 20, autoAlpha: 0, duration: 0.7 }, 0.55);
      }

      if (!reduced) {
        gsap.to(".progress span", {
          scaleY: 1,
          ease: "none",
          scrollTrigger: { start: 0, end: "max", scrub: true },
        });
        const media = gsap.matchMedia();
        media.add("(min-width: 821px)", () => {
          gsap.timeline({
            scrollTrigger: { trigger: ".hero-scene", start: "top top", end: "+=210%", pin: ".hero-stage", scrub: 0.8, anticipatePin: 1 },
          })
            .to(".hero-copy", { yPercent: -34, scale: 0.9, autoAlpha: 0, duration: 0.22 }, 0)
            .to(".hero-mascot", { xPercent: -12, yPercent: 10, autoAlpha: 0, duration: 0.2 }, 0.5)
            .fromTo(".hero-product", { yPercent: 105, scale: 0.46, rotateX: 12, autoAlpha: 0 }, { yPercent: 0, scale: 0.78, rotateX: 0, autoAlpha: 1, duration: 0.38, ease: "power3.out" }, 0.06)
            .to(".hero-product", { scale: 1, duration: 0.34, ease: "power2.inOut" }, 0.42)
            .fromTo(".hero-caption", { y: 32, autoAlpha: 0 }, { y: 0, autoAlpha: 1, duration: 0.24 }, 0.62)
            .to(".hero-caption", { y: -18, autoAlpha: 0, duration: 0.1 }, 0.9)
            .to(".aura-one", { xPercent: 30, yPercent: -18, scale: 1.35, duration: 1 }, 0)
            .to(".aura-two", { xPercent: -24, yPercent: 20, scale: 1.25, duration: 1 }, 0);

          document.querySelectorAll<HTMLElement>(".feature-scene").forEach((scene, index) => {
            const stage = scene.querySelector<HTMLElement>(".feature-stage");
            const visual = scene.querySelector<HTMLElement>(".feature-visual");
            const copy = scene.querySelector<HTMLElement>(".feature-copy");
            const heading = scene.querySelector<HTMLElement>("h2");
            if (!stage || !visual || !copy || !heading) return;
            const direction = index % 2 === 0 ? -1 : 1;
            const featureList = copy.querySelector("ul");

            const entrance = gsap.timeline({
              scrollTrigger: { trigger: scene, start: "top 82%", toggleActions: "play none none reverse" },
            })
              .from(visual, { xPercent: direction * 18, y: 70, rotateY: direction * -5, scale: 0.88, autoAlpha: 0, duration: 0.85, ease: "power3.out" })
              .from(copy.querySelector(".eyebrow"), { y: 16, autoAlpha: 0, duration: 0.4 }, 0.08)
              .from(heading, { y: 38, clipPath: "inset(0 0 100% 0)", duration: 0.62, ease: "power4.out" }, 0.12)
              .from(copy.querySelector(":scope > p:last-of-type"), { y: 18, autoAlpha: 0, duration: 0.45 }, 0.28);
            if (featureList) entrance.from(featureList, { y: 16, autoAlpha: 0, duration: 0.45 }, 0.34);

            gsap.timeline({
              scrollTrigger: { trigger: scene, start: "top top", end: "+=110%", pin: stage, scrub: 0.7, anticipatePin: 1 },
            })
              .to(visual, { yPercent: -3, scale: 1.025, duration: 1, ease: "none" }, 0)
              .to(scene.querySelector(".feature-aura"), { xPercent: direction * -20, scale: 1.25, duration: 1 }, 0);
          });
        });

        media.add("(max-width: 820px)", () => {
          gsap.timeline({
            scrollTrigger: { trigger: ".hero-scene", start: "top top", end: "+=90%", pin: ".hero-stage", scrub: 0.6, anticipatePin: 1 },
          })
            .to(".hero-copy", { yPercent: -28, autoAlpha: 0, duration: 0.28 }, 0)
            .to(".hero-mascot", { yPercent: 12, autoAlpha: 0, duration: 0.2 }, 0.52)
            .fromTo(".hero-product", { yPercent: 80, scale: 0.68, autoAlpha: 0 }, { yPercent: 0, scale: 1, autoAlpha: 1, duration: 0.58, ease: "power3.out" }, 0.16)
            .fromTo(".hero-caption", { y: 18, autoAlpha: 0 }, { y: 0, autoAlpha: 1, duration: 0.2 }, 0.7)
            .to(".hero-caption", { y: -12, autoAlpha: 0, duration: 0.08 }, 0.92);

          document.querySelectorAll<HTMLElement>(".feature-scene").forEach((scene) => {
            const visual = scene.querySelector(".feature-visual");
            const copy = scene.querySelector(".feature-copy");
            const heading = scene.querySelector<HTMLElement>("h2");
            if (!visual || !copy || !heading) return;
            gsap.timeline({ scrollTrigger: { trigger: scene, start: "top 78%", toggleActions: "play none none reverse" } })
              .from(heading, { y: 34, clipPath: "inset(0 0 100% 0)", duration: 0.7, ease: "power4.out" })
              .from(copy.querySelectorAll("p, ul"), { y: 20, autoAlpha: 0, duration: 0.5, stagger: 0.05 }, 0.16)
              .from(visual, { y: 70, scale: 0.88, autoAlpha: 0, duration: 0.8, ease: "power3.out" }, 0.2);
          });
        });

        const closing = document.querySelector<HTMLElement>(".closing h2");
        if (closing) {
          gsap.from(closing, { y: 42, autoAlpha: 0, duration: 0.9, ease: "power4.out", scrollTrigger: { trigger: closing, start: "top 82%", once: true } });
        }
      }

      const guide = document.querySelector(".journey-guide");
      const summary = document.querySelector(".release-summary");
      if (guide && summary) {
        ScrollTrigger.create({
          start: 120,
          endTrigger: summary,
          end: "top 72%",
          invalidateOnRefresh: true,
          onEnter: () => guide.classList.add("is-visible"),
          onLeave: () => guide.classList.remove("is-visible"),
          onEnterBack: () => guide.classList.add("is-visible"),
          onLeaveBack: () => guide.classList.remove("is-visible"),
        });
      }

      if (!reduced && finePointer) {
        document.querySelectorAll<HTMLElement>("[data-product-frame]").forEach((element) => {
          Atropos({ el: element, rotateXMax: 3.5, rotateYMax: 3.5, stretchX: 1, stretchY: 1, stretchZ: 3, shadow: false, highlight: true, duration: 500 });
        });
      }
      addEventListener("load", () => ScrollTrigger.refresh(), { once: true });
      ScrollTrigger.refresh();
    });
  </script>

  <style>
    :global(body) { margin: 0; background: #fff; }
    .launch-page {
      --ink: #11102f;
      --muted: #6e708d;
      --indigo: #5146e5;
      --indigo-deep: #342da7;
      --aqua: #24cdb4;
      position: relative;
      min-height: 100vh;
      overflow: clip;
      color: var(--ink);
      background: #fff;
      font-family: "Inter Variable", Inter, sans-serif;
      font-feature-settings: "cv02", "cv03", "cv04", "cv11";
    }
    .launch-nav {
      position: fixed;
      inset: 0 0 auto;
      z-index: 80;
      display: flex;
      height: 5.2rem;
      align-items: center;
      justify-content: space-between;
      padding-inline: max(2rem, calc((100vw - 88rem) / 2));
      border-bottom: 1px solid rgba(81, 70, 229, 0.09);
      background: rgba(255, 255, 255, 0.72);
      backdrop-filter: blur(24px) saturate(150%);
    }
    .launch-nav a, footer a { color: var(--ink); font-weight: 750; letter-spacing: -0.035em; text-decoration: none; }
    .launch-nav a span { color: var(--indigo); }
    .launch-controls { display: flex; align-items: center; gap: 0.65rem; }
    .launch-nav p {
      display: flex;
      align-items: center;
      gap: 0.55rem;
      margin: 0;
      color: rgba(17, 16, 47, 0.58);
      font: 650 0.72rem/1 ui-monospace, SFMono-Regular, Menlo, monospace;
      letter-spacing: 0.09em;
      text-transform: uppercase;
    }
    :global(.release-lang-switcher [data-lang-trigger]) {
      width: 2.8rem;
      height: 2.8rem;
      justify-content: center;
      padding: 0;
      border: 1px solid transparent;
      border-radius: 999px;
      background:
        linear-gradient(rgba(255, 255, 255, 0.9), rgba(247, 248, 255, 0.82)) padding-box,
        linear-gradient(135deg, rgba(81, 70, 229, 0.7), rgba(36, 205, 180, 0.58)) border-box;
      box-shadow: 0 0.65rem 1.8rem rgba(81, 70, 229, 0.15), inset 0 1px rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(16px);
      cursor: pointer;
      transition: box-shadow 180ms ease, filter 180ms ease;
    }
    :global(.release-lang-switcher [data-lang-trigger]:hover) {
      box-shadow: 0 0.9rem 2.2rem rgba(81, 70, 229, 0.25), 0 0 0 4px rgba(81, 70, 229, 0.07), inset 0 1px rgba(255, 255, 255, 0.95);
      filter: saturate(1.15);
    }
    :global(.release-lang-switcher [data-lang-trigger] > div > span),
    :global(.release-lang-switcher [data-chevron]) { display: none; }
    :global(.release-lang-switcher [data-lang-trigger] img) { width: 1.25rem; height: 0.94rem; }
    :global(.release-lang-switcher [data-lang-panel]) { right: 0; left: auto; min-width: 12rem; }
    .progress { position: fixed; top: 22vh; right: 1rem; z-index: 90; width: 2px; height: 56vh; border-radius: 99px; background: rgba(81, 70, 229, 0.1); }
    .progress span { display: block; width: 100%; height: 100%; border-radius: inherit; background: linear-gradient(var(--indigo), var(--aqua)); box-shadow: 0 0 1rem rgba(36, 205, 180, 0.45); transform: scaleY(0); transform-origin: top; }
    .journey-guide {
      position: fixed;
      bottom: 1.25rem;
      left: 50%;
      z-index: 75;
      display: inline-flex;
      min-height: 2.9rem;
      align-items: center;
      gap: 0.75rem;
      padding: 0.45rem 0.55rem 0.45rem 1rem;
      border: 1px solid rgba(81, 70, 229, 0.2);
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.78);
      box-shadow: 0 1rem 3rem rgba(43, 37, 115, 0.16), inset 0 1px rgba(255, 255, 255, 0.94);
      color: rgba(17, 16, 47, 0.76);
      font-size: 0.76rem;
      font-weight: 720;
      letter-spacing: -0.01em;
      opacity: 0;
      pointer-events: none;
      backdrop-filter: blur(18px) saturate(145%);
      transform: translate(-50%, 1rem) scale(0.96);
      transition: opacity 220ms ease, transform 260ms cubic-bezier(0.22, 1, 0.36, 1);
    }
    .journey-guide.is-visible { opacity: 1; transform: translate(-50%, 0) scale(1); }
    .journey-guide svg { width: 1.85rem; height: 1.85rem; padding: 0.42rem; border-radius: 50%; background: linear-gradient(145deg, #675df3, #443ad5); fill: none; stroke: #fff; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.8; animation: scroll-invite 1.8s ease-in-out infinite; }

    .hero-scene { min-height: 100svh; }
    .hero-stage {
      position: relative;
      display: grid;
      width: 100%;
      height: 100svh;
      min-height: 46rem;
      place-items: center;
      overflow: hidden;
      padding: 7.2rem 1.5rem 3rem;
      isolation: isolate;
      perspective: 1400px;
    }
    .aura { position: absolute; z-index: -2; border-radius: 50%; filter: blur(6rem); opacity: 0.85; will-change: transform; }
    .aura-one { top: 10%; left: 9%; width: min(42rem, 58vw); height: min(30rem, 42vw); background: rgba(81, 70, 229, 0.14); }
    .aura-two { right: 7%; bottom: 8%; width: min(38rem, 52vw); height: min(28rem, 38vw); background: rgba(36, 205, 180, 0.13); }
    .hero-copy { position: relative; z-index: 3; display: grid; width: min(100%, 72rem); min-width: 0; justify-items: center; text-align: center; will-change: transform, opacity; }
    .eyebrow { margin: 0 0 1.15rem; color: var(--indigo); font-size: clamp(0.68rem, 0.85vw, 0.78rem); font-weight: 760; letter-spacing: 0.145em; line-height: 1.2; text-transform: uppercase; }
    h1, h2 { margin: 0; font-family: "Inter Tight Variable", "Arial Narrow", sans-serif; font-weight: 700; letter-spacing: -0.025em; text-wrap: pretty; }
    h1 { max-width: 10ch; font-size: clamp(5rem, 10.2vw, 10.5rem); line-height: 0.84; letter-spacing: 0; }
    .hero-lede { max-width: 42rem; margin: 2.1rem 0 0; color: var(--muted); font-size: clamp(1.05rem, 1.55vw, 1.3rem); font-weight: 470; letter-spacing: -0.02em; line-height: 1.55; }
    .hero-actions { display: flex; align-items: center; margin-top: 2.1rem; }
    .scroll-action {
      display: inline-flex;
      min-width: 16rem;
      min-height: 4.4rem;
      appearance: none;
      align-items: center;
      justify-content: space-between;
      gap: 1.25rem;
      padding: 0.55rem 0.6rem 0.55rem 1.55rem;
      border: 1px solid transparent;
      border-radius: 999px;
      background:
        linear-gradient(rgba(255, 255, 255, 0.84), rgba(249, 249, 255, 0.76)) padding-box,
        linear-gradient(120deg, rgba(81, 70, 229, 0.52), rgba(36, 205, 180, 0.46), rgba(81, 70, 229, 0.34)) border-box;
      box-shadow: 0 1.35rem 3.8rem rgba(43, 37, 115, 0.2), inset 0 1px rgba(255, 255, 255, 0.96);
      color: var(--ink);
      cursor: pointer;
      font: 720 1rem/1 "Inter Variable", sans-serif;
      letter-spacing: -0.025em;
      backdrop-filter: blur(20px) saturate(145%);
      transition: transform 180ms ease, box-shadow 180ms ease;
    }
    .scroll-action-icon {
      display: grid;
      width: 3.15rem;
      height: 3.15rem;
      flex: 0 0 auto;
      place-items: center;
      border-radius: 50%;
      background: linear-gradient(145deg, #6a60f5, var(--indigo) 58%, #3730ba);
      box-shadow: 0 0.7rem 1.8rem rgba(81, 70, 229, 0.3), inset 0 1px rgba(255, 255, 255, 0.24);
      color: #fff;
    }
    .scroll-action svg { width: 1.25rem; height: 1.25rem; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.8; animation: scroll-invite 1.8s ease-in-out infinite; }
    .scroll-action:hover { box-shadow: 0 1.6rem 4.2rem rgba(43, 37, 115, 0.27), 0 0 0 5px rgba(81, 70, 229, 0.06), inset 0 1px rgba(255, 255, 255, 0.96); transform: translateY(-3px); }
    .hero-mascot {
      position: absolute;
      top: 44%;
      left: max(1rem, calc((100vw - 112rem) / 2));
      width: clamp(20rem, 27vw, 30rem);
      height: auto;
      isolation: isolate;
      pointer-events: none;
      translate: 0 -8%;
      user-select: none;
    }
    .hero-mascot::before {
      position: absolute;
      right: 5%;
      bottom: -1%;
      left: 5%;
      z-index: -1;
      height: 15%;
      border: 1px solid rgba(81, 70, 229, 0.2);
      border-radius: 50%;
      background: linear-gradient(110deg, rgba(81, 70, 229, 0.16), rgba(36, 205, 180, 0.19));
      box-shadow: 0 1.5rem 3rem rgba(43, 37, 115, 0.18), inset 0 1px rgba(255, 255, 255, 0.9);
      content: "";
      transform: perspective(12rem) rotateX(62deg);
    }
    .hero-mascot img { position: relative; z-index: 1; display: block; width: 100%; height: auto; filter: drop-shadow(0 1.8rem 2rem rgba(43, 37, 115, 0.14)); }
    .primary-action {
      position: relative;
      display: inline-flex;
      min-height: 3.55rem;
      align-items: center;
      justify-content: center;
      gap: 0.72rem;
      padding: 0.92rem 1.35rem 0.96rem 1.5rem;
      border-radius: 999px;
      background: linear-gradient(135deg, #665cf3, var(--indigo) 55%, #4137ce);
      box-shadow: 0 1.2rem 3.5rem rgba(81, 70, 229, 0.28);
      color: #fff;
      font-weight: 700;
      letter-spacing: -0.02em;
      text-decoration: none;
      transition: transform 180ms ease, background 180ms ease, box-shadow 180ms ease;
    }
    .primary-action svg { width: 1.15rem; height: 1.15rem; fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.8; transition: transform 180ms ease; }
    .primary-action:hover { box-shadow: 0 1.5rem 4rem rgba(52, 45, 167, 0.36); transform: translateY(-2px); }
    .primary-action:hover svg { transform: translateX(3px); }
    .primary-action:focus-visible, .scroll-action:focus-visible, .launch-nav a:focus-visible, footer a:focus-visible { outline: 3px solid rgba(36, 205, 180, 0.78); outline-offset: 4px; }
