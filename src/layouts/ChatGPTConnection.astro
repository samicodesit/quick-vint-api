---
import { getMobileWebBuildConfig } from "../app/mobile-web/config";
const config = getMobileWebBuildConfig(import.meta.env);
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <meta name="referrer" content="no-referrer" />
  <title>{title} | AutoLister</title>
</head>
<body>
  <script is:inline define:vars={{ mobileWebConfig: config }}>
    window.__AUTOLISTER_MOBILE_WEB_CONFIG__ = mobileWebConfig;
  </script>
  <main><a class="brand" href="/app">AutoLister</a><section><slot /></section></main>
</body>
</html>
<style is:global>
*{box-sizing:border-box}body{margin:0;background:#faf9f6;color:#202421;font:16px/1.5 system-ui}main{max-width:560px;margin:5vh auto;padding:20px}.brand{font-size:25px;font-weight:750;letter-spacing:-1px;color:inherit;text-decoration:none}section{margin:22px 0;padding:24px;background:white;border:1px solid #dedfd9;border-radius:16px;box-shadow:0 8px 28px #20242106}h1{font-size:24px;line-height:1.3;letter-spacing:-.5px;margin:0 0 20px;overflow-wrap:anywhere}button,.primary{display:block;width:100%;text-align:center;min-height:48px;font:600 16px system-ui;background:#473edb;color:white;border:0;border-radius:10px;padding:14px 16px;margin-top:20px;cursor:pointer;text-decoration:none}button:disabled{opacity:.6;cursor:wait}button.secondary{background:#f3f2fa;color:#3930bd}button:focus-visible,a:focus-visible,input:focus-visible{outline:3px solid #928bf3;outline-offset:3px}p{color:#62665f;overflow-wrap:anywhere}p:empty{display:none}[hidden]{display:none!important}#photos{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}#photos img{display:block;width:100%;height:180px;object-fit:contain;background:#f7f7f5;border-radius:10px}#photos img:only-child{grid-column:1/-1;height:260px}input{max-width:100%;font:inherit}input::file-selector-button{min-height:44px;padding:8px 12px}@media(max-width:480px){main{margin:16px auto;padding:18px}section{padding:20px}h1{font-size:22px}#photos img{height:150px}#photos img:only-child{height:240px}}
</style>
