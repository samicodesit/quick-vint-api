---
import "../styles/global.css";
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
import { SITE_COPY, SITE_EXTRA_COPY, normalizeSiteLocale } from "../i18n/site.js";
import { WEB_ENTRY_COPY } from "../i18n/webEntry";
import { blogPath, normalizeBlogLocale } from "../i18n/blog";
import { bootstrapHomepageExperiment, HOMEPAGE_EXPERIMENT } from "../scripts/homepageExperiment";
import type { SiteLocale } from "../i18n/site.js";
import { MODEL_PHOTO_CONTENT_ENABLED } from "../utils/modelContentRelease";
import { MODEL_PHOTO_COPY } from "../i18n/modelPhotos";
import { isPhoneOrTablet } from "../utils/clientDevice";

export interface Props {
  title?: string;
  description?: string;
  canonical?: string | URL | null;
  ogUrl?: string;
  ogType?: string;
  htmlLang?: string;
  currentLocale?: string;
  localeBasePath?: string;
  pathPattern?: string;
  switcherLocales?: SiteLocale[];
  localizedUrls?: Partial<Record<SiteLocale, string>>;
  minimalChrome?: boolean;
  includeWebApplication?: boolean;
  webPrimary?: boolean;
  socialImage?: string;
  socialImageAlt?: string;
  socialImageWidth?: number;
  socialImageHeight?: number;
  homepage?: boolean;
  marketplaceAccessNote?: string;
}

const {
  title = "AutoLister AI - AI Listing Assistant",
  description = "Create editable listing titles and descriptions from photos.",
  canonical,
  ogUrl = "https://autolister.app/",
  ogType = "website",
  htmlLang = "en",
  currentLocale,
  localeBasePath = "/",
  pathPattern,
  switcherLocales,
  localizedUrls,
  minimalChrome = false,
  includeWebApplication = false,
  webPrimary = false,
  socialImage = "/social-card-oct2026.png",
  socialImageAlt = "AutoLister AI: From photos to listing drafts. A seller photographs clothes on a rail.",
  socialImageWidth = 1200,
  socialImageHeight = 630,
  homepage = false,
  marketplaceAccessNote,
} = Astro.props;

const ogImage = new URL(socialImage, "https://autolister.app").href;
const ogImageAlt = socialImageAlt;

const resolvedLocale = normalizeSiteLocale(currentLocale || htmlLang);
const navCopy = SITE_COPY[resolvedLocale].nav;
const modelCopy = MODEL_PHOTO_COPY[resolvedLocale as keyof typeof MODEL_PHOTO_COPY] || MODEL_PHOTO_COPY.en;
const showLanguageSwitcher = Boolean(currentLocale);
const localePrefix = resolvedLocale === "en" ? "" : `/${resolvedLocale}`;
const homeHref = `${localePrefix}/`;
const isHomepage = homepage || Astro.url.pathname.replace(/\/$/, "") === homeHref.replace(/\/$/, "");
const homeExtra = SITE_EXTRA_COPY[resolvedLocale].home;
const featuresHref = `${localePrefix}/#features`;
const pricingHref = `${localePrefix}/pricing`;
const blogHref = blogPath(normalizeBlogLocale(resolvedLocale));
const chromeHref =
  "https://chromewebstore.google.com/detail/autolister-ai-vinted-desc/mommklhpammnlojjobejddmidmdcalcl";
---

<!doctype html>
<html lang={htmlLang} class="scroll-smooth">
  <head>
    <link rel="preload" href="/fonts/geist-latin-wght-normal-19f9c925.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    <style is:global>
      @media (prefers-reduced-motion: reduce) {
        html.scroll-smooth { scroll-behavior: auto; }
      }
    </style>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline set:html={`if((${isPhoneOrTablet.toString()})(navigator))document.documentElement.dataset.clientDevice='phone';`} />
    {isHomepage && <script is:inline set:html={`(${bootstrapHomepageExperiment.toString()})(window,${JSON.stringify(HOMEPAGE_EXPERIMENT)});`} />}

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {canonical && <link rel="canonical" href={canonical} />}

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={socialImageWidth} />
    <meta property="og:image:height" content={socialImageHeight} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={ogUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <slot name="head" />

    <script is:inline src="/purchase-measurement.js"></script>

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "AutoLister AI",
        "alternateName": "AutoLister",
        "url": "https://autolister.app/"
      }
    </script>

    <script type="application/ld+json" is:inline set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "@id": "https://autolister.app/#browser-extension",
        "name": "AutoLister AI browser extension",
        "applicationCategory": "BrowserExtension",
        "softwareRequirements": "Chrome on a computer, or Orion with Chrome extension support on iPhone and iPad.",
        "description": MODEL_PHOTO_CONTENT_ENABLED
          ? "AutoLister AI prepares editable listing titles, descriptions and AI model photos for eligible clothing listings on Vinted. Review the results before publishing."
          : "AutoLister AI prepares editable listing titles and descriptions from your photos for you to review.",
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD"
        },
        "url": "https://chromewebstore.google.com/detail/autolister-ai-vinted-desc/mommklhpammnlojjobejddmidmdcalcl"
      })} />
    {(includeWebApplication || isHomepage) && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebApplication",
        "@id": "https://autolister.app/#web-application",
        name: "AutoLister AI web app",
        applicationCategory: "BusinessApplication",
        operatingSystem: "iOS, iPadOS, Android, Windows, macOS, Linux",
        browserRequirements: "Requires JavaScript and an internet connection. No browser extension required.",
        url: "https://autolister.app/app",
        description: MODEL_PHOTO_CONTENT_ENABLED
          ? "Create editable listing titles, descriptions and AI model photos from item photos on your phone or computer. Reuse a saved model, review the results and save photos as JPEGs. Upload to your marketplace yourself."
          : "Generate editable listing titles and descriptions from item photos in your phone or computer browser. Review and copy the text into your marketplace listing, then publish it yourself.",
      })} />
    )}
  </head>

  <body
    class="min-h-screen bg-white text-slate-900 overflow-x-hidden antialiased selection:bg-brand-100 selection:text-brand-900"
  >
    {
      !minimalChrome && (
    <nav
      class:list={["fixed top-0 w-full z-50 glass-nav transition-all duration-300", { "home-navbar": isHomepage }]}
      id="navbar"
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="site-navbar-row flex items-center justify-between h-20">
          <!-- Logo -->
          <a
            href={homeHref}
            class="flex-shrink-0 flex items-center gap-2 cursor-pointer no-underline"
          >
            <span class="font-bold text-xl tracking-tight text-slate-900"
              >AutoLister <span class="text-brand-600">AI</span></span
            >
          </a>

          {isHomepage && (
            <div data-public-stats data-stats-endpoint="/api/public-stats" class="home-public-stats flex" aria-label={homeExtra.publicStatsAriaLabel} aria-busy="true" aria-live="polite">
              <span data-stat-generations class="public-stat-number">...</span>
              <span>{homeExtra.publicStatsGenerationsLabel}</span>
            </div>
          )}

          <!-- Desktop Menu -->
          <div class="site-desktop-nav hidden md:block">
            <div class="ml-10 flex items-center space-x-8">
              <a
                href={featuresHref}
                class="text-base font-bold text-slate-700 hover:text-brand-600 transition-colors no-underline"
                >{navCopy.features}</a
              >
              <a
                href={pricingHref}
                class="text-base font-bold text-slate-700 hover:text-brand-600 transition-colors no-underline"
                >{navCopy.pricing}</a
              >
              <a
                href={blogHref}
                class="text-base font-bold text-slate-700 hover:text-brand-600 transition-colors no-underline"
                >{navCopy.blog}</a
              >
              <a
                href="/support"
                class="text-base font-bold text-slate-700 hover:text-brand-600 transition-colors no-underline"
                >{navCopy.support}</a
              >
              <a
                href="mailto:hello@autolister.app"
                class="text-base font-bold text-slate-700 hover:text-brand-600 transition-colors no-underline"
                >{navCopy.contact}</a
              >
            </div>
          </div>

          {
            showLanguageSwitcher && (
              <div class="site-desktop-nav hidden md:block">
                <LanguageSwitcher
                  currentLocale={resolvedLocale}
                  basePath={localeBasePath}
                  pathPattern={pathPattern}
                  switcherLocales={switcherLocales}
                  localizedUrls={localizedUrls}
                />
              </div>
            )
          }

          <!-- CTA -->
          <div class="site-desktop-nav hidden md:block">
            <a
              href={webPrimary ? `/app?ref=model_nav_${resolvedLocale}` : chromeHref}
              target={webPrimary ? undefined : "_blank"}
              rel={webPrimary ? undefined : "noopener noreferrer"}
              data-track-event={webPrimary ? "web_app_click" : "chrome_store_click"}
              data-track-context="nav_desktop"
              class="site-nav-main inline-flex items-center px-6 py-2.5 border border-transparent text-sm font-bold rounded-2xl shadow-lg shadow-brand-600/20 text-white bg-brand-600 hover:bg-brand-700 transition-all hover:scale-105 active:scale-95 no-underline"
            >
              {webPrimary ? modelCopy.web : navCopy.cta}
            </a>
            {!webPrimary && (
              <a
                href={`/app?ref=nav_tablet_${resolvedLocale}`}
                data-track-event="web_app_click"
                data-track-context="nav_tablet"
                class="site-nav-tablet-web items-center px-6 py-2.5 border border-transparent text-sm font-bold rounded-2xl shadow-lg shadow-brand-600/20 text-white bg-brand-600 hover:bg-brand-700 no-underline"
              >
                {modelCopy.web}
              </a>
            )}
          </div>

          <!-- Mobile menu button -->
          <div class="site-mobile-menu-toggle -mr-2 flex md:hidden">
            <button
              type="button"
              onclick="toggleMobileMenu()"
              class="inline-flex items-center justify-center p-2 rounded-md text-slate-600 hover:text-brand-600 hover:bg-slate-100 focus:outline-none"
            >
              <span class="sr-only">Open main menu</span>
              <svg
                class="h-6 w-6"
                stroke="currentColor"
                fill="none"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M4 6h16M4 12h16M4 18h16"></path>
              </svg>
            </button>
          </div>
        </div>
      </div>

      <!-- Mobile Menu (Hidden by default) -->
      <div
        id="mobile-menu"
        class="hidden md:hidden absolute top-20 left-0 w-full max-h-[calc(100dvh-5rem)] overflow-y-auto overscroll-contain bg-white border-b border-gray-100 shadow-xl transition-all duration-300 origin-top transform"
      >
        <div class="px-4 pt-2 pb-6 space-y-2">
          {isHomepage && (
            <a href="/app?ref=home_menu" data-track-event="web_app_click" data-track-context="home_menu_web" data-track-copy-version="dual_route_v1" class="block px-3 py-3 rounded-lg text-base font-semibold text-brand-700 hover:bg-brand-50 no-underline">{WEB_ENTRY_COPY[resolvedLocale].action}</a>
          )}
          <a
            href={featuresHref}
            class="block px-3 py-3 rounded-lg text-base font-semibold text-slate-600 hover:text-brand-600 hover:bg-brand-50 transition-colors no-underline"
            >{navCopy.features}</a
          >
          <a
            href={pricingHref}
            class="block px-3 py-3 rounded-lg text-base font-semibold text-slate-600 hover:text-brand-600 hover:bg-brand-50 transition-colors no-underline"
            >{navCopy.pricing}</a
          >
          <a
            href={blogHref}
            class="block px-3 py-3 rounded-lg text-base font-semibold text-slate-600 hover:text-brand-600 hover:bg-brand-50 transition-colors no-underline"
            >{navCopy.blog}</a
          >
          <a
            href="/support"
            class="block px-3 py-3 rounded-lg text-base font-semibold text-slate-600 hover:text-brand-600 hover:bg-brand-50 transition-colors no-underline"
            >{navCopy.support}</a
          >
          <a
            href="mailto:hello@autolister.app"
            class="block px-3 py-3 rounded-lg text-base font-semibold text-slate-600 hover:text-brand-600 hover:bg-brand-50 transition-colors no-underline"
            >{navCopy.contact}</a
          >

          {
            showLanguageSwitcher && (
              <div class="px-3 py-2">
                <LanguageSwitcher
                  currentLocale={resolvedLocale}
                  basePath={localeBasePath}
                  className="w-full"
                  pathPattern={pathPattern}
                  switcherLocales={switcherLocales}
                  localizedUrls={localizedUrls}
                />
              </div>
            )
          }

          <div class="pt-4 mt-4 border-t border-gray-100">
            <a
              href={`/app?ref=nav_mobile_${resolvedLocale}`}
              data-track-event="web_app_click"
              data-track-context="nav_mobile"
              class="block w-full text-center px-6 py-3 border border-transparent text-base font-bold rounded-xl text-white bg-brand-600 hover:bg-brand-700 shadow-lg shadow-brand-600/20 no-underline"
            >
              {webPrimary ? modelCopy.web : navCopy.cta}
            </a>
          </div>
        </div>
      </div>
    </nav>
      )
    }

    <slot />

    {
      !minimalChrome && (
    <footer class="bg-slate-50 border-t border-slate-200 pt-16 pb-8">
      <div class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8">
        <div
          class="flex flex-col md:flex-row justify-between items-center gap-8 mb-8"
        >
          <!-- Logo -->
          <div class="flex items-center gap-2">
            <span class="font-bold text-lg text-slate-900"
              >AutoLister <span class="text-brand-600">AI</span></span
            >
          </div>

          <div class="flex flex-wrap justify-center gap-8">
            <a
              href={pricingHref}
              class="text-sm font-semibold text-slate-600 hover:text-brand-600 transition-colors"
              >{navCopy.pricing}</a
            >
            <a
              href={blogHref}
              class="text-sm font-semibold text-slate-600 hover:text-brand-600 transition-colors"
              >{navCopy.blog}</a
            >
            <a
              href="/privacy"
              class="text-sm font-semibold text-slate-600 hover:text-brand-600 transition-colors"
              >{navCopy.privacy}</a
            >
            <a
              href="/terms"
              class="text-sm font-semibold text-slate-600 hover:text-brand-600 transition-colors"
              >{navCopy.terms}</a
            >
            <a
              href="/support"
              class="text-sm font-semibold text-slate-600 hover:text-brand-600 transition-colors"
              >{navCopy.support}</a
            >
            <a href="/withdraw" class="text-sm font-semibold text-slate-600 hover:text-brand-600 transition-colors">Withdraw from contract</a>
          </div>
        </div>
        <div class="border-t border-slate-200 pt-8 text-center">
          <p class="text-sm text-slate-500">
            &copy; 2026 AutoLister AI. {navCopy.copyright}
          </p>
          <p class="mx-auto mt-3 max-w-3xl text-xs leading-relaxed text-slate-500">
            {navCopy.independence}
          </p>
          <p class="mx-auto mt-2 max-w-3xl text-xs leading-relaxed text-slate-500">
            {marketplaceAccessNote ?? navCopy.ebayAccessNote}
          </p>
        </div>
      </div>
    </footer>
      )
    }

    {
      !minimalChrome && (
    <script>
      const mobileMenu = document.getElementById("mobile-menu");

      window.toggleMobileMenu = function toggleMobileMenu() {
        if (!mobileMenu) return;

        if (mobileMenu.classList.contains("hidden")) {
          mobileMenu.classList.remove("hidden");
        } else {
          mobileMenu.classList.add("hidden");
        }
      };

      // Close mobile menu when clicking links
      document.querySelectorAll("#mobile-menu a").forEach((el) => {
        el.addEventListener("click", () => {
          if (!mobileMenu) return;

          mobileMenu.classList.add("hidden");
        });
      });

      // Sticky Navbar Effect
      window.addEventListener("scroll", () => {
        const nav = document.getElementById("navbar");
        if (!nav) return;

        if (window.scrollY > 20) {
          nav.classList.add("shadow-lg");
          nav.style.background = "rgba(255, 255, 255, 0.95)";
        } else {
          nav.classList.remove("shadow-lg");
          nav.style.background = "rgba(255, 255, 255, 0.9)";
        }
      });
    </script>
      )
    }
    <script>
      import "../scripts/analytics.js";
    </script>
  </body>
</html>

<style>
  .site-nav-tablet-web { display: none; }
  html[data-client-device="phone"] .site-nav-main[href^="https://chromewebstore.google.com/"] { display: none; }
  html[data-client-device="phone"] .site-nav-tablet-web { display: inline-flex; }
  .home-public-stats { flex-direction: column; justify-content: center; align-items: center; width: 108px; min-width: 0; height: 38px; flex-shrink: 0; color: #64748b; font-size: 10px; line-height: 1.15; text-align: center; }
  .home-public-stats .public-stat-number { color: #4338ca; font-size: 13px; font-weight: 700; font-variant-numeric: tabular-nums; line-height: 1.3; }
  @media (max-width: 1279px) {
    .home-navbar .site-desktop-nav { display: none; }
    .home-navbar .site-mobile-menu-toggle { display: flex; }
    .home-navbar #mobile-menu:not(.hidden) { display: block; }
  }
  @media (max-width: 1023px) {
    .home-navbar .site-navbar-row { height: 64px; }
    .home-navbar #mobile-menu { top: 64px; }
  }
</style>
