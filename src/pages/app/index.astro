---
import "@fontsource-variable/geist";
import "@fontsource-variable/newsreader";
import "@fontsource-variable/inter-tight";
import bodyFont from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";
import headingFont from "@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url";
import brandFont from "@fontsource-variable/inter-tight/files/inter-tight-latin-wght-normal.woff2?url";
import "../../styles/mobile-web-app.css";
import "../../styles/listing-drafts.css";
import "../../styles/style-onboarding.css";
import WorkspaceShell from "../../components/mobile-web/WorkspaceShell.astro";
import AppInstallHead from "../../components/mobile-web/AppInstallHead.astro";
import { getMobileWebBuildConfig } from "../../app/mobile-web/config";

const buildConfig = getMobileWebBuildConfig({
  PUBLIC_MOBILE_WEB_APP_ENABLED: import.meta.env.PUBLIC_MOBILE_WEB_APP_ENABLED,
  PUBLIC_SUPABASE_URL: import.meta.env.PUBLIC_SUPABASE_URL,
  PUBLIC_SUPABASE_ANON_KEY: import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
  VERCEL_ENV: import.meta.env.VERCEL_ENV,
  VERCEL_APP_SUPABASE_URL: import.meta.env.VERCEL_APP_SUPABASE_URL,
  VERCEL_APP_SUPABASE_ANON_KEY: import.meta.env.VERCEL_APP_SUPABASE_ANON_KEY,
});
const connectSources = [
  "'self'",
  ...(buildConfig.supabaseUrl ? [buildConfig.supabaseUrl] : []),
  "https://api.stripe.com",
  "https://www.google-analytics.com",
  "https://www.googletagmanager.com",
].join(" ");
const contentSecurityPolicy = [
  "default-src 'self'",
  `connect-src ${connectSources}`,
  `img-src 'self' https://flagcdn.com ${buildConfig.supabaseUrl || ""} data: blob:`,
  "font-src 'self' data:",
  "style-src 'self' 'unsafe-inline'",
  "script-src 'self' 'unsafe-inline'",
  "frame-ancestors 'none'",
].join("; ");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta http-equiv="Content-Security-Policy" content={contentSecurityPolicy} />
    <title>AutoLister AI</title>
    {buildConfig.enabled && <AppInstallHead />}
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={headingFont} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={brandFont} as="font" type="font/woff2" crossorigin="anonymous" />
  </head>
  <body>
    <script is:inline>
      if (window.opener) {
        const key = "autolister:chat-import-start";
        try {
          if (location.hash === "#import-chatgpt-item") sessionStorage.setItem(key, String(Date.now()));
          else if (!location.hash && Date.now() - Number(sessionStorage.getItem(key)) < 180000) {
            history.replaceState(history.state, "", location.pathname + location.search + "#import-chatgpt-item");
          }
        } catch {}
      }
    </script>
    {
      buildConfig.enabled ? (
        <WorkspaceShell />
      ) : (
        <main data-mobile-web="disabled" aria-live="polite">
          <section class="mobile-disabled-card">
            <p class="mobile-eyebrow">AutoLister</p>
            <h1>Mobile web app unavailable</h1>
            <p>This private workspace is not enabled yet.</p>
          </section>
        </main>
      )
    }
    {
      buildConfig.enabled && (
        <script
          is:inline
          define:vars={{
            mobileWebConfig: {
              supabaseUrl: buildConfig.supabaseUrl,
              supabaseAnonKey: buildConfig.supabaseAnonKey,
              draftsEnabled: import.meta.env.PUBLIC_LISTING_DRAFTS_ENABLED === "true",
            },
          }}
        >
          window.__AUTOLISTER_MOBILE_WEB_CONFIG__ = mobileWebConfig;
        </script>
      )
    }
    {
      buildConfig.enabled && (
        <script>
          import { mountMobileWebApp } from "../../app/mobile-web/app";

          const root = document.querySelector<HTMLElement>(
            '[data-mobile-web="workspace"]',
          );
          if (root) mountMobileWebApp(root);
        </script>
      )
    }
  </body>
</html>
