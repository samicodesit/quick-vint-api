---
import Layout from "../../layouts/ChatGPTConnection.astro";
---
<Layout title="Connect ChatGPT">
  <h1>Connect ChatGPT to AutoLister</h1>
  <p id="status" role="status">Checking your account…</p>
  <div id="permissions" hidden>
    <p>ChatGPT can prepare drafts from the photos you share and identify your AutoLister account by email.</p>
    <p>Your saved seller note is added when you open the draft in AutoLister.</p>
    <button id="approve">Connect ChatGPT</button>
    <button id="deny" class="secondary">Cancel</button>
  </div>
  <a id="signin" class="primary" href="/app" hidden>Sign in to AutoLister</a>
</Layout>
<script>
import { createBrowserSupabaseClient, getBrowserSession } from "../../app/mobile-web/auth";
const status = document.querySelector<HTMLParagraphElement>("#status")!;
const signin = document.querySelector<HTMLAnchorElement>("#signin")!;
const controls = document.querySelector<HTMLDivElement>("#permissions")!;
const approve = document.querySelector<HTMLButtonElement>("#approve")!;
const deny = document.querySelector<HTMLButtonElement>("#deny")!;
const authorizationId = new URL(location.href).searchParams.get("authorization_id");
try {
  if (!authorizationId || !/^[a-zA-Z0-9_-]{1,200}$/.test(authorizationId)) throw Error("Open the connection from ChatGPT to continue.");
  const session = await getBrowserSession();
  if (!session) {
    sessionStorage.setItem("autolister:chatgpt:return", location.pathname + location.search);
    status.textContent = "Sign in to choose which account to connect."; signin.hidden = false;
  } else {
    const response = await fetch("/api/chatgpt/connection", { method:"POST", headers:{Authorization:"Bearer " + session.access_token} });
    if (!response.ok) throw Error("This private test is not enabled for your account.");
    const { clientId } = await response.json();
    const client = createBrowserSupabaseClient();
    const { data, error } = await client.auth.oauth.getAuthorizationDetails(authorizationId);
    if (error || !data || !("client" in data) || data.client.id !== clientId || data.user.id !== session.user.id) throw Error("Open a fresh connection from ChatGPT to continue.");
    if (data.scope.split(" ").some(scope => !["openid","email"].includes(scope))) throw Error("This connection requests unsupported permissions.");
    status.textContent = data.user.email;
    controls.hidden = false;
    async function decide(accept: boolean) {
      approve.disabled = deny.disabled = true;
      try {
        const current = await getBrowserSession();
        if (current?.user.id !== session!.user.id) throw Error("Your account changed. Reload to continue.");
        const result = accept ? await client.auth.oauth.approveAuthorization(authorizationId!) : await client.auth.oauth.denyAuthorization(authorizationId!);
        if (result.error) throw result.error;
      } catch { status.textContent = "Could not connect. Open a fresh connection from ChatGPT."; }
      finally { approve.disabled = deny.disabled = false; }
    }
    approve.onclick = () => decide(true); deny.onclick = () => decide(false);
  }
} catch(e) { status.textContent = e instanceof Error ? e.message : "Could not open this connection."; }
</script>
