    feedbackTitle: "Porque desinstalou?",
    feedbackSubtitle: "Um toque ajuda-nos a corrigir o que importa.",
    thanks: "Obrigado, isso ajuda.",
    error: "Não foi possível enviar o feedback. Pode fechar esta página.",
    reasons: {
      results_not_good_enough: "Os resultados não foram bons o suficiente",
      could_not_get_it_to_work: "Não consegui fazê-lo funcionar",
      not_what_i_expected: "Não era o que eu esperava",
      wrong_app: "Achei que funcionava com outra aplicação",
      free_limit_too_low: "O limite gratuito era demasiado baixo",
      did_not_understand: "Não percebi como usar",
    },
  },
};
