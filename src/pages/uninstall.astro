<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>AutoLister AI uninstall offer</title>
    <style>
      :root {
        color-scheme: light;
        --bg: #f4f7fb;
        --panel: #ffffff;
        --text: #171923;
        --muted: #667085;
        --border: #e5e7eb;
        --soft-border: #eef1f6;
        --brand: #4f46e5;
        --brand-dark: #4338ca;
        --success: #047857;
        --success-bg: #ecfdf5;
        --warning: #b45309;
      }

      * {
        box-sizing: border-box;
      }

      body {
        min-height: 100vh;
        margin: 0;
        background:
          linear-gradient(135deg, rgba(16, 185, 129, 0.12), transparent 28%),
          linear-gradient(315deg, rgba(79, 70, 229, 0.14), transparent 30%),
          linear-gradient(180deg, #ffffff 0%, var(--bg) 100%);
        color: var(--text);
        font-family:
          -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica,
          Arial, sans-serif;
        display: grid;
        place-items: center;
        padding: 28px;
      }

      main {
        width: min(100%, 1240px);
        display: grid;
        grid-template-columns: minmax(0, 1.5fr) minmax(320px, 0.72fr);
        gap: 20px;
        align-items: start;
      }

      .panel {
        border: 1px solid rgba(226, 232, 240, 0.9);
        border-radius: 22px;
        background: rgba(255, 255, 255, 0.9);
        box-shadow: 0 28px 80px rgba(17, 24, 39, 0.11);
        backdrop-filter: blur(18px);
      }

      .offer {
        isolation: isolate;
        position: relative;
        padding: 38px;
        overflow: hidden;
      }

      .offer::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
        background: linear-gradient(90deg, #10b981, #38bdf8, var(--brand));
      }

      .offer::after {
        content: "";
        position: absolute;
        inset: auto -22% 8% 50%;
        z-index: -1;
        height: 34%;
        border: 1px solid rgba(99, 102, 241, 0.1);
        border-radius: 44px;
        background:
          linear-gradient(135deg, rgba(238, 242, 255, 0.62), rgba(255, 255, 255, 0)),
          linear-gradient(180deg, rgba(255, 255, 255, 0.76), rgba(248, 250, 252, 0.42));
        transform: rotate(-6deg);
      }

      .brand-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 32px;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 8px;
      }

      .brand-logo {
        width: 24px;
        height: 24px;
        border-radius: 8px;
        object-fit: cover;
        box-shadow: 0 8px 18px rgba(79, 70, 229, 0.16);
      }

      .brand-text {
        background: linear-gradient(90deg, #4f46e5, #0891b2);
        background-clip: text;
        color: transparent;
        font-size: 18px;
        font-weight: 850;
        letter-spacing: 0;
      }

      .preview-pill {
        display: none;
        border: 1px solid #fed7aa;
        border-radius: 999px;
        padding: 6px 10px;
        background: #fff7ed;
        color: var(--warning);
        font-size: 12px;
        font-weight: 800;
      }

      [data-preview="true"] .preview-pill {
        display: inline-flex;
      }

      .eyebrow {
        margin: 0 0 10px;
        color: var(--success);
        font-size: 13px;
        font-weight: 850;
        text-transform: uppercase;
        letter-spacing: 0.06em;
      }

      h1 {
        max-width: 900px;
        margin: 0;
        font-size: clamp(44px, 5.2vw, 72px);
        line-height: 1.02;
        letter-spacing: 0;
        overflow-wrap: anywhere;
        text-wrap: balance;
      }

      .offer-hero {
        display: grid;
        grid-template-columns: minmax(360px, 0.92fr) minmax(320px, 1.08fr);
        gap: 20px;
        align-items: start;
        margin-top: 22px;
      }

      .offer-copy {
        min-width: 0;
        position: relative;
        z-index: 2;
      }

      .body-copy {
        max-width: 520px;
        margin: 0 0 16px;
        color: var(--muted);
        font-size: 18px;
        line-height: 1.56;
      }

      .coupon-wrap {
        position: relative;
        display: flex;
        align-items: flex-end;
        width: min(100%, 470px);
        max-width: 100%;
        margin-bottom: 16px;
      }

      .offer-visual {
        justify-self: end;
        width: min(100%, 440px);
        margin: -34px -16px -10px 0;
        pointer-events: none;
      }

      .offer-visual img {
        display: block;
        width: 100%;
        height: auto;
        animation:
          uninstallCharacterIn 720ms cubic-bezier(0.16, 1, 0.3, 1) both,
          offerVisualFloat 4.8s ease-in-out 900ms infinite;
        filter: drop-shadow(0 24px 32px rgba(17, 24, 39, 0.2));
        transform-origin: 52% 88%;
      }

      .coupon-card {
        position: relative;
        z-index: 3;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 10px;
        width: fit-content;
        max-width: 100%;
        padding: 10px;
        border: 1px solid rgba(165, 180, 252, 0.9);
        border-radius: 18px;
        background:
          linear-gradient(180deg, rgba(255, 255, 255, 0.96), rgba(238, 242, 255, 0.95)),
          #eef2ff;
        box-shadow: 0 18px 36px rgba(79, 70, 229, 0.14);
      }

      .coupon-card::before,
      .coupon-card::after {
        content: "";
        position: absolute;
        top: 50%;
        width: 16px;
        height: 16px;
        border: 1px solid rgba(165, 180, 252, 0.72);
        border-radius: 50%;
        background: var(--panel);
        transform: translateY(-50%);
      }

      .coupon-card::before {
        left: -9px;
        border-left-color: transparent;
        border-bottom-color: transparent;
        transform: translateY(-50%) rotate(45deg);
      }

      .coupon-card::after {
        right: -9px;
        border-top-color: transparent;
        border-right-color: transparent;
        transform: translateY(-50%) rotate(45deg);
      }

      .coupon-label {
        min-width: 0;
        padding: 0 6px;
        color: #4338ca;
        font-size: 12px;
        font-weight: 850;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        overflow-wrap: anywhere;
      }

      .coupon-code {
        min-width: 0;
        border: 1px solid #a5b4fc;
        border-radius: 12px;
        background: #ffffff;
        color: #111827;
        padding: 10px 14px;
        font-size: 16px;
        font-weight: 900;
        letter-spacing: 0.04em;
        text-align: center;
        white-space: nowrap;
      }

      .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 22px;
      }

      .cta,
      .secondary-link {
        min-height: 48px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        padding: 0 20px;
        font-size: 15px;
        font-weight: 850;
        text-decoration: none;
        text-align: center;
        overflow-wrap: anywhere;
      }

      .cta {
        background: #111827;
        color: #ffffff;
        box-shadow: 0 14px 32px rgba(17, 24, 39, 0.18);
      }

      .cta:hover,
      .cta:focus-visible {
        background: #1f2937;
      }

      .secondary-link {
        border: 1px solid var(--border);
        background: #ffffff;
        color: #344054;
      }

      .proof-footer {
        position: relative;
        display: grid;
        gap: 8px;
        width: 100%;
      }

      .tier-toggle {
        display: inline-grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        justify-self: center;
        width: min(100%, 280px);
        margin-bottom: 0;
        padding: 3px;
        border: 1px solid rgba(226, 232, 240, 0.9);
        border-radius: 12px;
        background: rgba(248, 250, 252, 0.9);
        box-shadow: 0 10px 22px rgba(17, 24, 39, 0.045);
        z-index: 4;
      }

      .tier-option {
        min-width: 0;
        min-height: 30px;
        border: 0;
        border-radius: 9px;
        background: transparent;
        color: #667085;
        cursor: pointer;
        font: inherit;
        font-size: 12px;
        font-weight: 850;
        line-height: 1;
        padding: 0 10px;
        transition:
          background 160ms ease,
          box-shadow 160ms ease,
          color 160ms ease,
          transform 160ms ease;
      }

      .tier-option:hover,
      .tier-option:focus-visible {
        color: #111827;
        outline: none;
      }

      .tier-option.is-active {
        background: #ffffff;
        color: #111827;
        box-shadow: 0 6px 14px rgba(17, 24, 39, 0.08);
        transform: translateY(-1px);
      }

      .proof-strip {
        position: relative;
        z-index: 2;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0;
        width: 100%;
        margin: 0;
        border: 1px solid rgba(226, 232, 240, 0.9);
        border-radius: 18px;
        background: rgba(255, 255, 255, 0.86);
        padding: 0;
        list-style: none;
        overflow: hidden;
        clear: both;
        box-shadow: 0 18px 44px rgba(17, 24, 39, 0.07);
      }

      .proof-strip::after {
        content: "";
        position: absolute;
        left: 50%;
        bottom: -1px;
        z-index: 2;
        width: min(240px, 58%);
        height: 18px;
        border-radius: 16px 16px 0 0;
        background:
          linear-gradient(180deg, rgba(255, 255, 255, 0.9), rgba(255, 255, 255, 0.98)),
          rgba(255, 255, 255, 0.94);
        transform: translateX(-50%);
        pointer-events: none;
      }

      .proof-strip li {
        position: relative;
        z-index: 3;
        display: grid;
        gap: 5px;
        align-content: center;
        min-height: 86px;
        border-left: 1px solid rgba(226, 232, 240, 0.9);
        padding: 14px 12px;
        text-align: left;
      }

      .proof-strip li:first-child {
        border-left: 0;
      }

      .proof-strip li:nth-child(odd) {
        border-left: 0;
      }

      .proof-strip li:nth-child(n + 3) {
        border-top: 1px solid rgba(226, 232, 240, 0.9);
      }

      .proof-strip li:first-child {
        background:
          linear-gradient(110deg, rgba(236, 253, 245, 0.95), rgba(255, 255, 255, 0.68), rgba(224, 242, 254, 0.62)),
          rgba(255, 255, 255, 0.86);
        background-size: 180% 100%;
      }

      .proof-value {
        color: #111827;
        font-size: 20px;
        font-weight: 900;
        line-height: 1.05;
        letter-spacing: 0;
        overflow-wrap: anywhere;
      }

      .proof-label {
        color: var(--muted);
        font-size: 11px;
        font-weight: 760;
        line-height: 1.2;
        overflow-wrap: anywhere;
      }

      .proof-strip li:first-child .proof-value {
        color: var(--success);
      }

      .tier-choose {
        position: relative;
        z-index: 1;
        justify-self: center;
        min-width: min(100%, 214px);
        min-height: 54px;
        margin-top: -14px;
        padding: 12px 22px 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 0 0 16px 16px;
        background: var(--brand);
        color: #ffffff;
        font-size: 15px;
        font-weight: 900;
        text-decoration: none;
        box-shadow: 0 14px 30px rgba(79, 70, 229, 0.28);
        transition:
          background 160ms ease,
          box-shadow 160ms ease,
          transform 160ms ease;
      }

      .tier-choose:hover,
      .tier-choose:focus-visible {
        background: var(--brand-dark);
        box-shadow: 0 18px 36px rgba(79, 70, 229, 0.34);
        outline: none;
        transform: translateY(1px);
      }

      @media (min-width: 960px) {
        body {
          padding-block: 12px;
        }

        .offer {
          padding: 28px 38px 30px;
        }

        .brand-row {
          margin-bottom: 18px;
        }

        h1 {
          font-size: clamp(46px, 4.6vw, 62px);
        }

        .offer-hero {
          gap: 16px;
          margin-top: 16px;
        }

        .offer-visual {
          width: min(100%, 390px);
          margin-top: -28px;
        }

        .body-copy {
          margin-bottom: 15px;
          font-size: 16.5px;
          line-height: 1.48;
        }

        .coupon-card {
          padding: 8px;
        }

        .coupon-code {
          padding: 9px 14px;
        }

        .coupon-wrap {
          margin-bottom: 10px;
        }

        .actions {
          margin-bottom: 13px;
        }

        .cta,
        .secondary-link {
          min-height: 42px;
          padding-inline: 18px;
          font-size: 14px;
        }

        .proof-footer {
          margin-top: -44px;
        }

        .proof-strip {
          grid-template-columns: repeat(4, minmax(0, 1fr));
        }

        .proof-strip li {
          min-height: 68px;
          border-top: 0;
          text-align: center;
        }

        .proof-strip li:nth-child(odd) {
          border-left: 1px solid rgba(226, 232, 240, 0.9);
        }

        .proof-strip li:first-child {
          border-left: 0;
        }

        .proof-strip li:nth-child(n + 3) {
          border-top: 0;
        }

        .proof-value {
          font-size: 17px;
        }
      }

      .feedback {
        position: relative;
        padding: 28px;
        align-self: start;
        overflow: hidden;
      }

      .feedback::before {
        content: "";
        position: absolute;
        inset: 0 0 auto;
        height: 4px;
        background: linear-gradient(90deg, #111827, #4f46e5);
      }

      .feedback h2 {
        margin: 0;
        font-size: 24px;
        line-height: 1.16;
        letter-spacing: 0;
      }

      .feedback p {
        margin: 8px 0 18px;
        color: var(--muted);
        font-size: 14px;
        line-height: 1.5;
      }

      .reasons {
        display: grid;
        gap: 10px;
      }

      .reason-button {
        width: 100%;
        min-height: 48px;
        border: 1px solid rgba(226, 232, 240, 0.95);
        border-radius: 14px;
        background: rgba(255, 255, 255, 0.86);
        color: var(--text);
        cursor: pointer;
        font: inherit;
        font-size: 14px;
        font-weight: 750;
        line-height: 1.25;
        padding: 12px 14px;
        text-align: left;
        overflow-wrap: anywhere;
        box-shadow: 0 8px 18px rgba(17, 24, 39, 0.035);
        transition:
          border-color 140ms ease,
          background 140ms ease,
          transform 140ms ease;
      }

      .reason-button:hover:not(:disabled),
      .reason-button:focus-visible:not(:disabled) {
        border-color: rgba(79, 70, 229, 0.58);
        background: #f7f7ff;
        outline: none;
        transform: translateY(-1px);
      }

      .reason-button:disabled {
        cursor: wait;
        opacity: 0.72;
      }

      .thanks {
        display: none;
        border: 1px solid #bbf7d0;
        background: #f0fdf4;
        color: var(--success);
        border-radius: 11px;
        padding: 13px;
        font-size: 14px;
        font-weight: 800;
      }

      .error {
        display: none;
        color: #b42318;
        font-size: 13px;
        margin-top: 12px;
      }

      [data-state="submitted"] .reasons {
        display: none;
      }

      [data-state="submitted"] .thanks {
        display: block;
      }

      @keyframes uninstallCharacterIn {
        from {
          opacity: 0;
          transform: translateY(14px) scale(0.96);
        }
        to {
          opacity: 1;
          transform: translateY(0) scale(1);
        }
      }

      @keyframes offerVisualFloat {
        0%,
        100% {
          transform: translate3d(0, 0, 0) rotate(0deg);
        }
        50% {
          transform: translate3d(0, -14px, 0) rotate(-1.2deg);
        }
      }

      @media (max-width: 820px) {
        body {
          place-items: start center;
          padding: 16px;
        }

        main {
          grid-template-columns: 1fr;
        }

        .offer {
          padding: 26px;
        }

        .offer-hero {
          grid-template-columns: minmax(0, 0.9fr) minmax(220px, 0.8fr);
          margin-top: 16px;
        }

        .offer-visual {
          width: 260px;
          margin: -10px -2px 0 0;
        }
      }

      @media (max-width: 520px) {
        body {
          padding: 8px;
        }

        main {
          gap: 8px;
        }

        .offer,
        .feedback {
          padding: 14px 20px;
          border-radius: 14px;
        }

        .brand-row {
          margin-bottom: 12px;
        }

        .brand-text {
          font-size: 17px;
        }

        .brand-logo {
          width: 22px;
          height: 22px;
          border-radius: 7px;
        }

        .preview-pill {
          padding: 5px 8px;
          font-size: 11px;
        }

        .eyebrow {
          margin-bottom: 6px;
          font-size: 11px;
        }

        h1 {
          max-width: 330px;
          font-size: clamp(27px, 7.6vw, 31px);
        }

        .offer-hero {
          display: block;
          position: relative;
          margin-top: 12px;
        }

        .offer-copy {
          position: static;
        }

        .body-copy {
          max-width: 60%;
          margin: 12px 0 14px;
          font-size: 14.5px;
          line-height: 1.35;
        }

        .offer-visual {
          position: absolute;
          top: 2px;
          right: -8px;
          width: 142px;
          margin: 0;
        }

        .coupon-wrap {
          margin-bottom: 10px;
        }

        .coupon-card {
          display: grid;
          grid-template-columns: minmax(0, 1fr);
          gap: 6px;
          padding: 7px;
          border-radius: 16px;
        }

        .coupon-label {
          grid-column: 1 / -1;
          width: 100%;
        }

        .coupon-label {
          padding-inline: 4px;
          font-size: 10px;
        }

        .coupon-code {
          padding: 7px 10px;
          font-size: 14px;
        }

        .actions {
          display: grid;
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: 8px;
          margin-bottom: 10px;
        }

        .cta,
        .secondary-link {
          min-height: 42px;
          padding: 0 10px;
          font-size: 12.5px;
        }

        .tier-toggle {
          width: min(100%, 246px);
          padding: 2px;
          border-radius: 11px;
        }

        .tier-option {
          min-height: 26px;
          border-radius: 8px;
          font-size: 10.5px;
          padding: 0 6px;
        }

        .proof-strip li {
          min-width: 0;
          min-height: 52px;
          padding: 8px 10px;
        }

        .proof-value {
          font-size: 14px;
        }

        .proof-label {
          font-size: 9px;
        }

        .tier-choose {
          min-height: 48px;
          min-width: min(100%, 176px);
          margin-top: -12px;
          padding-top: 10px;
          font-size: 13px;
        }

        .feedback {
          padding-top: 14px;
        }

        .feedback h2 {
          font-size: 20px;
        }

        .feedback p {
          margin: 3px 0 8px;
          font-size: 12px;
        }

        .reasons {
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: 6px;
        }

        .reason-button {
          min-height: 34px;
          border-radius: 11px;
          padding: 6px 8px;
          font-size: 10.8px;
          line-height: 1.15;
        }

        .coupon-card,
        .cta,
        .secondary-link {
          width: 100%;
        }
      }

      @media (max-width: 520px) and (max-height: 740px) {
        :root {
          --compact-scale: 0.84;
        }

        body {
          overflow: hidden;
          padding: 6px;
          place-items: start center;
        }

        main {
          width: calc(100% / var(--compact-scale));
          max-width: calc(430px / var(--compact-scale));
          transform: scale(var(--compact-scale));
          transform-origin: top center;
        }
      }

      @media (max-width: 520px) and (max-height: 640px) {
        :root {
          --compact-scale: 0.76;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .offer-visual img {
          animation: none;
          transform: none;
        }

        .tier-option {
          transition: none;
        }
      }
    </style>
  </head>
  <body>
    <main data-state="ready" data-preview="false">
      <section class="offer panel" aria-labelledby="uninstall-offer-title">
        <div class="brand-row">
          <div class="brand">
            <img class="brand-logo" src="/logo.svg" alt="" width="24" height="24" />
            <span class="brand-text" data-i18n="brand">AutoLister AI</span>
          </div>
          <div class="preview-pill" data-i18n="preview">Preview mode</div>
        </div>
        <p class="eyebrow" data-i18n="eyebrow">Before you go</p>
        <h1 id="uninstall-offer-title" data-i18n="headline">
          Come back with 20% off
        </h1>
        <div class="offer-hero">
          <div class="offer-copy">
            <p class="body-copy" data-i18n="body">
              Do you really want to do all the manual work yourself? AutoLister helps you sell
              faster, and it is a lot cheaper than most AI tools out there. Use this code for 20%
              off your first month.
            </p>

            <div class="coupon-wrap">
              <div class="coupon-card" aria-label="Discount code">
                <span class="coupon-label" data-i18n="couponLabel">Use code</span>
                <span class="coupon-code" data-coupon-code>{couponCode}</span>
              </div>
            </div>

            <div class="actions">
              <a class="cta" data-reinstall-cta href={chromeStoreUrl} data-i18n="primaryCta">
                Reinstall AutoLister
              </a>
              <a class="secondary-link" data-pricing-link href={pricingUrl} data-i18n="secondaryCta">
                See plans first
              </a>
            </div>
          </div>
          <div class="offer-visual" aria-hidden="true">
            <img
              src="/uninstall-winback-character.webp"
              alt=""
              width="595"
              height="620"
              loading="eager"
              decoding="async"
            />
          </div>
        </div>

        <div class="proof-footer">
          <div class="tier-toggle" role="tablist" aria-label="Plan" data-tier-toggle>
            <button
              class="tier-option is-active"
              type="button"
              role="tab"
              aria-selected="true"
              data-tier-option="starter"
              data-tier-url={tierPricingUrls.starter}
              data-i18n="tierStarter">Starter</button
            >
            <button
              class="tier-option"
              type="button"
              role="tab"
              aria-selected="false"
              data-tier-option="pro"
              data-tier-url={tierPricingUrls.pro}
              data-i18n="tierPro">Pro</button
            >
            <button
              class="tier-option"
              type="button"
              role="tab"
              aria-selected="false"
              data-tier-option="business"
              data-tier-url={tierPricingUrls.business}
              data-i18n="tierBusiness">Business</button
            >
          </div>

          <ul class="proof-strip" aria-label="AutoLister seller value">
            <li>
              <strong class="proof-value" data-tier-proof="proofOneValue" data-i18n="proofOneValue"
                >€3.19</strong
              >
              <span class="proof-label" data-tier-proof="proofOneLabel" data-i18n="proofOneLabel"
                >Starter first month</span
              >
            </li>
            <li>
              <strong class="proof-value" data-tier-proof="proofTwoValue" data-i18n="proofTwoValue"
                >~82% cheaper</strong
              >
              <span class="proof-label" data-tier-proof="proofTwoLabel" data-i18n="proofTwoLabel"
                >than ChatGPT Plus</span
              >
            </li>
            <li>
              <strong
                class="proof-value"
                data-tier-proof="proofThreeValue"
                data-i18n="proofThreeValue">75 listings</strong
              >
              <span class="proof-label" data-tier-proof="proofThreeLabel" data-i18n="proofThreeLabel"
                >included on Starter</span
              >
            </li>
            <li>
              <strong
                class="proof-value"
                data-tier-proof="proofFourValue"
                data-i18n="proofFourValue">Average 5 seconds</strong
              >
              <span class="proof-label" data-tier-proof="proofFourLabel" data-i18n="proofFourLabel"
                >from photos to draft</span
              >
            </li>
          </ul>

          <a
            class="tier-choose"
            href={tierPricingUrls.starter}
            data-tier-choose
            data-i18n="chooseTier">Choose</a
          >
        </div>
      </section>

      <section class="feedback panel" aria-labelledby="uninstall-feedback-title">
        <h2 id="uninstall-feedback-title" data-i18n="feedbackTitle">
          What made you uninstall?
        </h2>
        <p data-i18n="feedbackSubtitle">One tap helps us fix the right thing.</p>
        <section class="reasons" aria-label="Uninstall feedback reasons">
          {
            feedbackReasons.map((reason) => (
              <button
                class="reason-button"
                type="button"
                data-reason={reason}
                data-label={copy.en.reasons[reason]}
              >
                {copy.en.reasons[reason]}
              </button>
            ))
          }
        </section>
        <div class="thanks" role="status" data-i18n="thanks">Thanks, that helps.</div>
        <div class="error" role="alert" data-i18n="error">
          Could not send feedback. You can close this page.
        </div>
      </section>
    </main>

    <script define:vars={{ copy, couponCode }}>
      const page = document.querySelector("main");
      const buttons = Array.from(document.querySelectorAll("[data-reason]"));
      const tierButtons = Array.from(document.querySelectorAll("[data-tier-option]"));
      const tierProofItems = Array.from(document.querySelectorAll("[data-tier-proof]"));
      const tierChoose = document.querySelector("[data-tier-choose]");
      const error = document.querySelector(".error");
      const params = new URLSearchParams(window.location.search);
      const extensionVersion = params.get("version") || null;
      const analyticsClientId = params.get("cid") || null;
      const userId = params.get("uid") || null;
      const previewMode = params.get("preview") === "1";
      const supportedLocales = Object.keys(copy);
      const uninstallOpenKey = [
        "autolister",
        "uninstall-open",
        userId || "anonymous",
        analyticsClientId || "no-cid",
        extensionVersion || "no-version",
      ].join(":");

      function normalizeLocale(value) {
        const locale = String(value || "").toLowerCase().slice(0, 2);
        return supportedLocales.includes(locale) ? locale : "en";
      }

      function getPreferredLocale() {
        return normalizeLocale(
          params.get("lang") ||
            params.get("locale") ||
            navigator.language ||
            navigator.languages?.[0],
        );
      }

      const locale = getPreferredLocale();
      const strings = copy[locale] || copy.en;
      document.documentElement.lang = strings.htmlLang || locale;
      document.title = strings.title || copy.en.title;
      page.dataset.preview = previewMode ? "true" : "false";

      document.querySelectorAll("[data-i18n]").forEach((element) => {
        const key = element.dataset.i18n;
        if (strings[key]) element.textContent = strings[key];
      });

      const tierToggle = document.querySelector("[data-tier-toggle]");
      if (tierToggle && strings.tierLabel) {
        tierToggle.setAttribute("aria-label", strings.tierLabel);
      }

      function applyTier(tier) {
        const tierStrings = strings.tiers?.[tier] || strings.tiers?.starter || copy.en.tiers.starter;

        tierProofItems.forEach((element) => {
          const key = element.dataset.tierProof;
          if (key && tierStrings[key]) {
            element.textContent = tierStrings[key];
          }
        });

        tierButtons.forEach((button) => {
          const isActive = button.dataset.tierOption === tier;
          button.classList.toggle("is-active", isActive);
          button.setAttribute("aria-selected", isActive ? "true" : "false");

          if (isActive && tierChoose && button.dataset.tierUrl) {
            tierChoose.href = button.dataset.tierUrl;
            tierChoose.dataset.tier = tier;
          }
        });
      }

      function getInitialTier() {
        const tier = params.get("tier");
        return ["starter", "pro", "business"].includes(tier) ? tier : "starter";
      }

      tierButtons.forEach((button) => {
        button.addEventListener("click", () => {
          const tier = button.dataset.tierOption || "starter";
          applyTier(tier);
          trackEvent("uninstall_offer_tier_selected", {
            tier,
            offerCampaign: "uninstall_winback_offer_v1",
          });
        });
      });

      applyTier(getInitialTier());

      function getUninstallUtmParams(tier) {
        return {
          utm_source: "uninstall_page",
          utm_medium: "winback",
          utm_campaign: "uninstall_offer",
          utm_content: `${tier}_checkout`,
        };
      }

      async function openTierCheckout(event) {
        const tier = tierChoose?.dataset.tier || getInitialTier();
        trackEvent(
          "uninstall_offer_choose_click",
          {
            tier,
            offerCampaign: "uninstall_winback_offer_v1",
          },
          { beacon: true },
        );

        if (!userId || previewMode) return;

        event.preventDefault();
        tierChoose.setAttribute("aria-busy", "true");

        try {
          const response = await fetch("/api/stripe/create-checkout", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              userId,
              tier,
              source: "uninstall_page",
              couponCode,
              utm: getUninstallUtmParams(tier),
            }),
          });
          const data = await response.json();
          if (!response.ok || !data?.url) {
            throw new Error(data?.error || "Checkout failed");
          }
          window.location.assign(data.url);
        } catch {
          window.location.assign(tierChoose.href);
        }
      }

      tierChoose?.addEventListener("click", openTierCheckout);

      buttons.forEach((button) => {
        const reason = button.dataset.reason;
        const label = strings.reasons?.[reason] || copy.en.reasons[reason];
        button.textContent = label;
        button.dataset.label = label;
      });

      function buildTrackingBody(event, context = {}) {
        return {
          event,
          source: "uninstall_page",
          page: "/uninstall",
          userId,
          context: {
            ...context,
            extensionVersion,
            analyticsClientId,
            userId,
            locale,
            couponCode,
          },
          extensionVersion,
        };
      }

      function trackEvent(event, context = {}, options = {}) {
        if (previewMode) return Promise.resolve();
        const body = JSON.stringify(buildTrackingBody(event, context));

        if (options.beacon && navigator.sendBeacon) {
          const sent = navigator.sendBeacon(
            "/api/events/track",
            new Blob([body], { type: "application/json" }),
          );
          if (sent) return Promise.resolve();
        }

        return fetch("/api/events/track", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body,
          keepalive: true,
        }).catch(() => {});
      }

      function trackUninstallOpen() {
        if (previewMode) return;
        try {
          if (window.localStorage.getItem(uninstallOpenKey)) return;
          window.localStorage.setItem(uninstallOpenKey, String(Date.now()));
        } catch {
          // Ignore storage failures; the API also dedupes uninstall opens.
        }

        trackEvent(
          "extension_uninstalled",
          {
            hasUserId: Boolean(userId),
            offerCampaign: "uninstall_winback_offer_v1",
          },
          { beacon: true },
        );
      }

      async function sendFeedback(button) {
        const reason = button.dataset.reason;
        const reasonLabel = button.dataset.label;
        if (!reason || page?.dataset.state === "submitted") return;

        buttons.forEach((item) => {
          item.disabled = true;
        });
        error.style.display = "none";

        if (previewMode) {
          page.dataset.state = "submitted";
          return;
        }

        try {
          const response = await fetch("/api/events/track", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(
              buildTrackingBody("uninstall_feedback_submitted", {
                reason,
                reasonLabel,
                offerCampaign: "uninstall_winback_offer_v1",
              }),
            ),
            keepalive: true,
          });
          if (!response.ok) {
            throw new Error(`Feedback failed: ${response.status}`);
          }
          page.dataset.state = "submitted";
        } catch (feedbackError) {
          error.style.display = "block";
          buttons.forEach((item) => {
            item.disabled = false;
          });
        }
      }

      document.querySelector("[data-reinstall-cta]")?.addEventListener("click", () => {
        trackEvent(
          "uninstall_reinstall_cta_click",
          {
            offerCampaign: "uninstall_winback_offer_v1",
          },
          { beacon: true },
        );
      });

      document.querySelector("[data-pricing-link]")?.addEventListener("click", () => {
        trackEvent(
          "uninstall_pricing_click",
          {
            offerCampaign: "uninstall_winback_offer_v1",
          },
          { beacon: true },
        );
      });

      buttons.forEach((button) => {
        button.addEventListener("click", () => sendFeedback(button));
      });
      trackUninstallOpen();
    </script>
  </body>
</html>
