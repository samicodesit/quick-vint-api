---
import { existsSync } from "node:fs";
import { join } from "node:path";
import SiteLayout from "../../layouts/SiteLayout.astro";

const screenshotDefinitions = {
  wardrobe: {
    src: "/updates/1-4-0/wardrobe-rewrite.webp",
    file: "wardrobe-rewrite.webp",
    label: "SCREENSHOT 1 — Wardrobe widget + selected listings + toolbar",
    guidance: "1600 × 1000 · Keep product UI inside the middle 80%",
    alt: "AutoLister wardrobe rewrite widget, selected listings, and toolbar",
  },
  phone: {
    src: "/updates/1-4-0/phone-batch-upload.webp",
    file: "phone-batch-upload.webp",
    label: "SCREENSHOT 2 — Phone upload + batch receiving state",
    guidance:
      "1600 × 1000 · Show completed phone uploads and desktop receiving",
    alt: "AutoLister phone upload and desktop batch receiving state",
  },
  review: {
    src: "/updates/1-4-0/review-first.webp",
    file: "review-first.webp",
    label: "SCREENSHOT 3 — Review title and description suggestions",
    guidance: "1600 × 1000 · Keep both suggestion actions readable",
    alt: "AutoLister title and description review suggestions on Vinted",
  },
};

const screenshots = Object.fromEntries(
  Object.entries(screenshotDefinitions).map(([key, screenshot]) => [
    key,
    {
      ...screenshot,
      available: existsSync(
        join(process.cwd(), "public", screenshot.src.replace(/^\//, "")),
      ),
    },
  ]),
) as Record<
  keyof typeof screenshotDefinitions,
  (typeof screenshotDefinitions)[keyof typeof screenshotDefinitions] & {
    available: boolean;
  }
>;
---

<SiteLayout
  title="What’s new in AutoLister 1.4"
  description="Rewrite wardrobe listings and upload phone photos more smoothly with AutoLister 1.4."
  canonical="https://autolister.app/updates/1-4-0"
  ogUrl="https://autolister.app/updates/1-4-0"
  minimalChrome
>
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
  </Fragment>

  <main class="release-page">
    <header class="release-nav" aria-label="AutoLister release">
      <a href="/" aria-label="AutoLister home" class="release-brand">
        AutoLister <span>AI</span>
      </a>
      <span class="version">VERSION 1.4.0</span>
    </header>

    <section class="hero" aria-labelledby="release-title">
      <p class="eyebrow hero-eyebrow">AutoLister 1.4</p>
      <h1 id="release-title">Your listings just got an upgrade.</h1>
      <p class="hero-copy">
        Rewrite your wardrobe.<br />Upload without babysitting.
      </p>
      <div class="hero-action">
        <a class="primary-cta" href="https://www.vinted.com/">
          Try rewriting my listings
          <svg viewBox="0 0 20 20" aria-hidden="true">
            <path d="M4 10h11m-4-4 4 4-4 4"></path>
          </svg>
        </a>
        <p class="cta-hint">
          Open your profile to find <strong>Rewrite listings</strong>.
        </p>
      </div>
      <div class="hero-seam" aria-hidden="true"><span></span></div>
    </section>

    <div class="release-story">
      <section class="feature feature-wardrobe reveal" aria-labelledby="wardrobe-title">
        <div class="feature-copy feature-copy-wide">
          <p class="eyebrow">Your wardrobe</p>
          <h2 id="wardrobe-title">Refresh your wardrobe in one go.</h2>
          <p>
            Select the listings you want, choose your languages, then review the
            new text or replace it directly.
          </p>
        </div>

        <figure class="product-frame product-frame-hero">
          {
            screenshots.wardrobe.available ? (
              <img
                src={screenshots.wardrobe.src}
                alt={screenshots.wardrobe.alt}
                loading="lazy"
              />
            ) : (
              <div
                class="shot-placeholder"
                role="img"
                aria-label={screenshots.wardrobe.alt}
              >
                <span class="shot-index">01 / REAL PRODUCT</span>
                <span class="shot-label">{screenshots.wardrobe.label}</span>
                <strong>{screenshots.wardrobe.file}</strong>
                <span class="shot-guidance">{screenshots.wardrobe.guidance}</span>
              </div>
            )
          }
        </figure>
      </section>

      <section class="feature feature-phone reveal" aria-labelledby="phone-title">
        <figure class="product-frame product-frame-side">
          {
            screenshots.phone.available ? (
              <img
                src={screenshots.phone.src}
                alt={screenshots.phone.alt}
                loading="lazy"
              />
            ) : (
              <div
                class="shot-placeholder"
                role="img"
                aria-label={screenshots.phone.alt}
              >
                <span class="shot-index">02 / REAL PRODUCT</span>
                <span class="shot-label">{screenshots.phone.label}</span>
                <strong>{screenshots.phone.file}</strong>
                <span class="shot-guidance">{screenshots.phone.guidance}</span>
              </div>
            )
          }
        </figure>

        <div class="feature-copy">
          <p class="eyebrow">Phone and batch</p>
          <h2 id="phone-title">Add photos.<br />Then add more.</h2>
          <p>
            Uploads start as soon as you choose them. Add another set whenever
            you need it—AutoLister keeps the full batch together and in order.
          </p>
        </div>
      </section>

      <section class="feature feature-review reveal" aria-labelledby="review-title">
        <div class="feature-copy">
          <p class="eyebrow">Review first</p>
          <h2 id="review-title">Keep the final say.</h2>
          <p>
            Use the title or description you like. Discard the one you don’t.
          </p>
        </div>

        <figure class="product-frame product-frame-side">
          {
            screenshots.review.available ? (
              <img
                src={screenshots.review.src}
                alt={screenshots.review.alt}
                loading="lazy"
              />
            ) : (
              <div
                class="shot-placeholder"
                role="img"
                aria-label={screenshots.review.alt}
              >
                <span class="shot-index">03 / REAL PRODUCT</span>
                <span class="shot-label">{screenshots.review.label}</span>
                <strong>{screenshots.review.file}</strong>
                <span class="shot-guidance">{screenshots.review.guidance}</span>
              </div>
            )
          }
        </figure>
      </section>
    </div>

    <section class="closing reveal" aria-labelledby="closing-title">
      <p class="eyebrow">It’s ready when you are</p>
      <h2 id="closing-title">Ready to refresh your wardrobe?</h2>
      <a class="primary-cta" href="https://www.vinted.com/">
        Try rewriting my listings
        <svg viewBox="0 0 20 20" aria-hidden="true">
          <path d="M4 10h11m-4-4 4 4-4 4"></path>
        </svg>
      </a>
      <p class="cta-hint">
        Open your profile to find <strong>Rewrite listings</strong>.
      </p>
    </section>

    <footer class="release-footer">
      <a href="/">AutoLister AI</a>
      <span>Version 1.4.0</span>
    </footer>
  </main>

  <script>
    const revealItems = document.querySelectorAll(".reveal");
    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    if ("IntersectionObserver" in window && !reducedMotion) {
      document.documentElement.classList.add("has-release-reveal");
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        },
        { threshold: 0.12 },
      );

      revealItems.forEach((item) => observer.observe(item));
    }
  </script>

  <style>
    :global(body) {
      background: #ffffff;
    }

    .release-page {
      --ink: #19164d;
      --indigo: #4f46e5;
      --indigo-deep: #3730a3;
      --teal: #2dd4bf;
      --lavender: #f4f3ff;
      --paper: #ffffff;
      position: relative;
      min-height: 100vh;
      overflow: hidden;
      color: var(--ink);
      background:
        linear-gradient(180deg, rgba(244, 243, 255, 0.44), transparent 19rem),
        var(--paper);
      font-family:
        -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial,
        sans-serif;
    }

    .release-nav {
      position: absolute;
      top: 0;
      left: 50%;
      z-index: 5;
      display: flex;
      width: min(100% - 3rem, 86rem);
      height: 6rem;
      align-items: center;
      justify-content: space-between;
      transform: translateX(-50%);
    }

    .release-brand,
    .release-footer a {
      color: var(--ink);
      font-size: 1.05rem;
      font-weight: 760;
      letter-spacing: -0.035em;
      text-decoration: none;
    }

    .release-brand span {
      color: var(--indigo);
    }

    .version,
    .shot-index,
    .shot-guidance,
    .release-footer span {
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas,
        monospace;
    }

    .version {
      padding: 0.46rem 0.72rem;
      border: 1px solid rgba(79, 70, 229, 0.16);
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.65);
      box-shadow: 0 0.75rem 2.5rem rgba(55, 48, 163, 0.08);
      color: rgba(25, 22, 77, 0.66);
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      backdrop-filter: blur(18px);
    }

    .hero {
      position: relative;
      display: grid;
      min-height: max(46rem, 100svh);
      place-items: center;
      align-content: center;
      padding: 9rem 1.5rem 8rem;
      text-align: center;
      isolation: isolate;
    }

    .hero::before {
      position: absolute;
      top: 18%;
      left: 50%;
      z-index: -2;
      width: min(58rem, 82vw);
      height: min(25rem, 42vw);
      transform: translateX(-50%);
      border-radius: 50%;
      background: linear-gradient(
        108deg,
        rgba(79, 70, 229, 0.13),
        rgba(45, 212, 191, 0.11)
      );
      filter: blur(5rem);
      content: "";
    }

    .eyebrow {
      margin: 0 0 1.15rem;
      color: var(--indigo);
      font-size: 0.76rem;
      font-weight: 800;
      letter-spacing: 0.14em;
      line-height: 1;
      text-transform: uppercase;
    }

    .hero-eyebrow {
      opacity: 0;
      animation: hero-rise 720ms 120ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .hero h1 {
      max-width: 10.5ch;
      margin: 0;
      color: var(--ink);
      font-size: clamp(4.3rem, 9.5vw, 9.5rem);
      font-weight: 790;
      letter-spacing: -0.075em;
      line-height: 0.88;
      text-wrap: balance;
      opacity: 0;
      transform: translateY(2rem);
      animation: hero-rise 980ms 220ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .hero-copy {
      margin: 2.4rem 0 0;
      color: rgba(25, 22, 77, 0.62);
      font-size: clamp(1.15rem, 2vw, 1.55rem);
      font-weight: 540;
      letter-spacing: -0.025em;
      line-height: 1.35;
      opacity: 0;
      transform: translateY(1.5rem);
      animation: hero-rise 850ms 420ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .hero-action {
      display: grid;
      justify-items: center;
      margin-top: 2.5rem;
      opacity: 0;
      transform: translateY(1rem);
      animation: hero-rise 800ms 580ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .primary-cta {
      display: inline-flex;
      min-height: 3.6rem;
      align-items: center;
      justify-content: center;
      gap: 0.7rem;
      padding: 0.85rem 1.35rem 0.9rem 1.55rem;
      border: 1px solid var(--indigo);
      border-radius: 999px;
      background: var(--indigo);
      box-shadow: 0 1rem 2.8rem rgba(79, 70, 229, 0.24);
      color: #ffffff;
      font-size: 0.98rem;
      font-weight: 740;
      letter-spacing: -0.018em;
      text-decoration: none;
      transition:
        transform 180ms ease,
        background-color 180ms ease,
        border-color 180ms ease,
        box-shadow 180ms ease;
    }

    .primary-cta svg {
      width: 1.12rem;
      fill: none;
      stroke: currentColor;
      stroke-linecap: round;
      stroke-linejoin: round;
      stroke-width: 1.7;
      transition: transform 180ms ease;
    }

    .primary-cta:hover {
      border-color: var(--indigo-deep);
      background: var(--indigo-deep);
      box-shadow: 0 1.25rem 3.4rem rgba(55, 48, 163, 0.28);
      transform: translateY(-2px);
    }

    .primary-cta:hover svg {
      transform: translateX(3px);
    }

    .primary-cta:active {
      box-shadow: 0 0.5rem 1.5rem rgba(55, 48, 163, 0.2);
      transform: translateY(0);
    }

    .primary-cta:focus-visible,
    .release-brand:focus-visible,
    .release-footer a:focus-visible {
      outline: 3px solid rgba(45, 212, 191, 0.8);
      outline-offset: 4px;
    }

    .cta-hint {
      margin: 0.9rem 0 0;
      color: rgba(25, 22, 77, 0.52);
      font-size: 0.77rem;
      line-height: 1.4;
    }

    .cta-hint strong {
      color: rgba(25, 22, 77, 0.74);
      font-weight: 700;
    }

    .hero-seam {
      position: absolute;
      bottom: 0;
      left: 50%;
      width: min(44rem, 76vw);
      height: 1px;
      overflow: hidden;
      transform: translateX(-50%);
      background: linear-gradient(
        90deg,
        transparent,
        rgba(79, 70, 229, 0.3),
        rgba(45, 212, 191, 0.32),
        transparent
      );
    }

    .hero-seam span {
      position: absolute;
      inset: 0 auto 0 -25%;
      width: 22%;
      background: linear-gradient(90deg, transparent, #ffffff, transparent);
      filter: drop-shadow(0 0 0.7rem rgba(45, 212, 191, 0.9));
      animation: seam-travel 4.8s 1.2s ease-in-out infinite;
    }

    .release-story {
      position: relative;
      width: min(100% - 3rem, 86rem);
      margin: 0 auto;
    }

    .release-story::before {
      position: absolute;
      top: 1rem;
      bottom: 0;
      left: 50%;
      z-index: 0;
      width: 1px;
      background: linear-gradient(
        180deg,
        rgba(79, 70, 229, 0.24),
        rgba(45, 212, 191, 0.28) 58%,
        transparent
      );
      content: "";
    }

    .feature {
      position: relative;
      z-index: 1;
      padding: clamp(7rem, 12vw, 11rem) 0;
    }

    .feature-wardrobe {
      display: grid;
      gap: 4.25rem;
    }

    .feature-phone,
    .feature-review {
      display: grid;
      grid-template-columns: minmax(0, 1.55fr) minmax(17rem, 0.75fr);
      align-items: center;
      gap: clamp(3.5rem, 8vw, 8rem);
    }

    .feature-review {
      grid-template-columns: minmax(17rem, 0.75fr) minmax(0, 1.55fr);
    }

    .feature-copy {
      max-width: 27rem;
      padding: 2rem 0;
      background: rgba(255, 255, 255, 0.9);
    }

    .feature-copy-wide {
      max-width: 54rem;
      margin: 0 auto;
      padding-inline: 2rem;
      text-align: center;
    }

    .feature h2,
    .closing h2 {
      margin: 0;
      color: var(--ink);
      font-size: clamp(3.1rem, 6.4vw, 6.75rem);
      font-weight: 780;
      letter-spacing: -0.07em;
      line-height: 0.94;
      text-wrap: balance;
    }

    .feature-copy > p:last-child {
      max-width: 35rem;
      margin: 1.65rem 0 0;
      color: rgba(25, 22, 77, 0.59);
      font-size: clamp(1rem, 1.4vw, 1.22rem);
      letter-spacing: -0.018em;
      line-height: 1.65;
    }

    .feature-copy-wide > p:last-child {
      margin-inline: auto;
    }

    .product-frame {
      position: relative;
      aspect-ratio: 8 / 5;
      overflow: hidden;
      margin: 0;
      border: 1px solid rgba(79, 70, 229, 0.2);
      border-radius: clamp(1.35rem, 3vw, 2.6rem);
      background:
        radial-gradient(
          circle at 92% 8%,
          rgba(45, 212, 191, 0.2),
          transparent 31%
        ),
        linear-gradient(
          135deg,
          rgba(255, 255, 255, 0.98),
          rgba(244, 243, 255, 0.94)
        );
      box-shadow:
        0 2.4rem 7rem rgba(55, 48, 163, 0.15),
        inset 0 1px rgba(255, 255, 255, 0.9);
      isolation: isolate;
      backdrop-filter: blur(24px);
    }

    .product-frame::before {
      position: absolute;
      inset: 0;
      z-index: 2;
      border-radius: inherit;
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.64);
      pointer-events: none;
      content: "";
    }

    .product-frame-hero {
      width: 100%;
    }

    .product-frame img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .shot-placeholder {
      position: absolute;
      inset: 0;
      display: grid;
      align-content: center;
      justify-items: center;
      padding: clamp(1.5rem, 5vw, 4rem);
      color: var(--ink);
      text-align: center;
    }

    .shot-placeholder::before {
      position: absolute;
      inset: 10%;
      border: 1px dashed rgba(79, 70, 229, 0.3);
      border-radius: clamp(0.75rem, 2vw, 1.7rem);
      content: "";
    }

    .shot-index {
      position: absolute;
      top: 7%;
      left: 8%;
      color: rgba(55, 48, 163, 0.52);
      font-size: clamp(0.52rem, 0.8vw, 0.68rem);
      font-weight: 700;
      letter-spacing: 0.12em;
    }

    .shot-label {
      position: relative;
      max-width: 34rem;
      color: var(--indigo);
      font-size: clamp(0.72rem, 1vw, 0.88rem);
      font-weight: 800;
      letter-spacing: 0.1em;
      line-height: 1.45;
      text-transform: uppercase;
    }

    .shot-placeholder strong {
      position: relative;
      margin-top: 1.2rem;
      font-size: clamp(1.25rem, 3vw, 2.5rem);
      font-weight: 740;
      letter-spacing: -0.055em;
      line-height: 1;
    }

    .shot-guidance {
      position: relative;
      margin-top: 1.1rem;
      color: rgba(25, 22, 77, 0.5);
      font-size: clamp(0.58rem, 0.9vw, 0.72rem);
      line-height: 1.5;
    }

    .closing {
      position: relative;
      display: grid;
      min-height: 43rem;
      place-items: center;
      align-content: center;
      padding: 8rem 1.5rem;
      text-align: center;
    }

    .closing::before {
      position: absolute;
      top: 15%;
      left: 50%;
      z-index: -1;
      width: min(48rem, 78vw);
      height: 22rem;
      transform: translateX(-50%);
      border-radius: 50%;
      background: linear-gradient(
        105deg,
        rgba(79, 70, 229, 0.13),
        rgba(45, 212, 191, 0.12)
      );
      filter: blur(5.5rem);
      content: "";
    }

    .closing h2 {
      max-width: 11ch;
      margin-bottom: 2.5rem;
    }

    .release-footer {
      display: flex;
      width: min(100% - 3rem, 86rem);
      min-height: 7rem;
      align-items: center;
      justify-content: space-between;
      margin: 0 auto;
      border-top: 1px solid rgba(79, 70, 229, 0.12);
      color: rgba(25, 22, 77, 0.45);
      font-size: 0.75rem;
    }

    .release-footer a {
      font-size: 0.86rem;
    }

    :global(.has-release-reveal) .reveal {
      opacity: 0;
      transform: translateY(3rem);
      transition:
        opacity 900ms cubic-bezier(0.16, 1, 0.3, 1),
        transform 900ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    :global(.has-release-reveal) .reveal.is-visible {
      opacity: 1;
      transform: translateY(0);
    }

    @keyframes hero-rise {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes seam-travel {
      0%,
      12% {
        transform: translateX(0);
        opacity: 0;
      }
      35% {
        opacity: 1;
      }
      68%,
      100% {
        transform: translateX(570%);
        opacity: 0;
      }
    }

    @media (max-width: 820px) {
      .release-nav {
        width: min(100% - 2rem, 86rem);
        height: 5rem;
      }

      .hero {
        min-height: 47rem;
        padding: 8rem 1.25rem 7rem;
      }

      .hero h1 {
        font-size: clamp(3.9rem, 15vw, 6.3rem);
        line-height: 0.91;
      }

      .release-story {
        width: min(100% - 2rem, 86rem);
      }

      .release-story::before {
        left: 1rem;
      }

      .feature,
      .feature-phone,
      .feature-review {
        display: flex;
        flex-direction: column;
        gap: 2.5rem;
        padding: 6.5rem 0;
      }

      .feature-copy,
      .feature-copy-wide {
        order: 1;
        max-width: 37rem;
        margin: 0;
        padding: 0 1rem 0 2.25rem;
        text-align: left;
      }

      .feature-copy-wide > p:last-child {
        margin-inline: 0;
      }

      .product-frame {
        order: 2;
        width: 100%;
      }

      .feature h2 {
        font-size: clamp(3rem, 12vw, 5rem);
      }

      .product-frame-side {
        width: 100%;
      }

      .closing {
        min-height: 39rem;
      }
    }

    @media (max-width: 520px) {
      .release-nav {
        width: calc(100% - 2rem);
      }

      .version {
        padding: 0.4rem 0.58rem;
        font-size: 0.58rem;
      }

      .hero {
        min-height: 44rem;
        padding-inline: 1rem;
      }

      .hero::before {
        width: 100vw;
        height: 22rem;
      }

      .hero h1 {
        font-size: clamp(3.7rem, 17vw, 5.1rem);
        letter-spacing: -0.08em;
      }

      .hero-copy {
        font-size: 1.08rem;
      }

      .primary-cta {
        width: 100%;
        max-width: 21rem;
      }

      .feature {
        padding-block: 5.5rem;
      }

      .feature h2 {
        font-size: clamp(2.8rem, 13.5vw, 4rem);
      }

      .product-frame {
        aspect-ratio: 4 / 3;
        border-radius: 1.25rem;
      }

      .shot-placeholder {
        padding: 1.25rem;
      }

      .shot-label {
        max-width: 17rem;
        font-size: 0.58rem;
      }

      .shot-placeholder strong {
        max-width: 15rem;
        margin-top: 0.85rem;
        font-size: 1.3rem;
        overflow-wrap: anywhere;
      }

      .shot-guidance {
        max-width: 15rem;
        margin-top: 0.75rem;
        font-size: 0.55rem;
      }

      .closing h2 {
        font-size: clamp(3.2rem, 14vw, 4.6rem);
      }

      .release-footer {
