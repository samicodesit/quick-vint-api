---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { DEFAULT_SITE_LOCALE, SUPPORTED_SITE_LOCALES } from "../../i18n/site.js";

const fallbackPath = `/updates/1-4-0/${DEFAULT_SITE_LOCALE}`;
---

<SiteLayout
  title="What’s new in AutoLister 1.4"
  description="Redirecting to your localized AutoLister 1.4 release page."
  canonical="https://autolister.app/updates/1-4-0/en"
  ogUrl="https://autolister.app/updates/1-4-0/en"
  htmlLang="en"
  minimalChrome
>
  <Fragment slot="head"><meta name="robots" content="noindex, nofollow" /></Fragment>
  <main class="grid min-h-screen place-items-center px-6 text-center">
    <div>
      <p class="text-slate-600">Opening AutoLister 1.4…</p>
      <a class="font-semibold text-brand-700" href={fallbackPath}>Continue</a>
    </div>
  </main>
  <script is:inline define:vars={{ supportedLocales: SUPPORTED_SITE_LOCALES }}>
    const params = new URLSearchParams(location.search);
    const requested = params.get("lang") || navigator.languages?.[0] || navigator.language || "en";
    const locale = String(requested).toLowerCase().split(/[-_]/)[0];
    const selected = supportedLocales.includes(locale) ? locale : "en";
    params.delete("lang");
    const query = params.toString();
    location.replace(`/updates/1-4-0/${selected}${query ? `?${query}` : ""}`);
  </script>
</SiteLayout>
