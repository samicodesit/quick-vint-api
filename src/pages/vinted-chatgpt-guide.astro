          Comparison checked on October 28, 2026.
        </p>
        <ListingDraftExample />
      </div>
    </section>

    <!-- How the extension works -->
    <section class="py-20 bg-slate-50">
      <div class="max-w-4xl mx-auto px-4 sm:px-6">
        <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-4">
          How the AutoLister AI Extension Works
        </h2>
        <p class="text-slate-500 text-lg mb-12">
          Install the extension, generate a draft and review your listing.
        </p>

        <div class="space-y-8">
          <div class="flex gap-6 items-start">
            <div
              class="flex-shrink-0 w-12 h-12 bg-indigo-600 text-white rounded-xl flex items-center justify-center font-bold text-xl"
            >
              1
            </div>
            <div>
              <h3 class="text-xl font-semibold text-slate-800 mb-2">
                Install the Chrome Extension
              </h3>
              <p class="text-slate-500 leading-relaxed">
                Add AutoLister AI from the Chrome Web Store. Installation is
                free; sign in to generate drafts.
              </p>
            </div>
          </div>

          <div class="flex gap-6 items-start">
            <div
              class="flex-shrink-0 w-12 h-12 bg-indigo-600 text-white rounded-xl flex items-center justify-center font-bold text-xl"
            >
              2
