                  >Yes</td
                >
                <td class="px-6 py-4 text-center text-slate-500">Yes, upload them to chat</td>
              </tr>
              <tr class="hover:bg-slate-50 transition-colors">
                <td class="px-6 py-4 text-slate-700">How you request a draft</td>
                <td class="px-6 py-4 text-center text-green-700 font-semibold"
                  >Choose your settings and tap Generate</td
                >
                <td class="px-6 py-4 text-center text-slate-500">Ask for a listing description</td>
              </tr>
              <tr class="hover:bg-slate-50 transition-colors">
                <td class="px-6 py-4 text-slate-700"
                  >Fills the Vinted form directly</td
                >
                <td class="px-6 py-4 text-center text-green-700 font-semibold"
                  >Yes</td
                >
                <td class="px-6 py-4 text-center text-slate-500">No</td>
              </tr>
              <tr class="hover:bg-slate-50 transition-colors">
                <td class="px-6 py-4 text-slate-700">Multilingual output</td>
                <td class="px-6 py-4 text-center text-green-700 font-semibold"
                  >Uses your selected preference</td
                >
                <td class="px-6 py-4 text-center text-slate-500"
                  >Ask for your preferred language</td
                >
              </tr>
              <tr class="hover:bg-slate-50 transition-colors">
                <td class="px-6 py-4 text-slate-700"
                  >Listing workflow</td
                >
                <td class="px-6 py-4 text-center text-green-700 font-semibold"
                  >Vinted listing controls</td
                >
                <td class="px-6 py-4 text-center text-slate-500">General-purpose chat</td>
              </tr>
              <tr class="hover:bg-slate-50 transition-colors">
                <td class="px-6 py-4 text-slate-700"
                  >Phone photos</td
                >
                <td class="px-6 py-4 text-center text-green-700 font-semibold"
                  >Upload to the extension's listing session</td
                >
                <td class="px-6 py-4 text-center text-slate-500">Upload to your chat</td>
              </tr>
              <tr class="hover:bg-slate-50 transition-colors">
                <td class="px-6 py-4 text-slate-700"
