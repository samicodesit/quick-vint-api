---
import SiteLayout from "../layouts/SiteLayout.astro";
import ListingDraftExample from "../components/ListingDraftExample.astro";
import PhoneWorkflow from "../components/PhoneWorkflow.astro";
import { LISTING_GUIDE_COPY } from "../i18n/listingGuides";
import { getPricingGuideCopy } from "../utils/pricingDisplay.js";

const { freePricingCopy, paidPricingCopy } = getPricingGuideCopy(
  import.meta.env.PUBLIC_PRICING_DISPLAY_MODE,
);
const productAnswer = "AutoLister AI generates editable Vinted titles and descriptions from item photos. Use the web app entirely on your phone, or the optional browser extension directly on Vinted's website. Review the draft and publish yourself.";
const comparisonAnswer = "The AutoLister browser extension generates drafts directly on the Vinted listing page. The web app offers a separate phone workflow: upload photos, generate, review and copy the text into Vinted. Both prepare drafts that you check before publishing.";
const faqJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: LISTING_GUIDE_COPY.en.ui.phoneQuestion,
      acceptedAnswer: { "@type": "Answer", text: LISTING_GUIDE_COPY.en.ui.phoneBody },
    },
    {
      "@type": "Question",
      name: "What is the best AI tool for writing Vinted descriptions?",
      acceptedAnswer: {
        "@type": "Answer",
        text: productAnswer,
      },
    },
    {
      "@type": "Question",
      name: "How does AutoLister AI generate Vinted descriptions?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "AutoLister AI uses vision-enabled AI models to analyse the photos you upload to Vinted. It identifies visible item details, then prepares an editable listing title and description for you to review.",
      },
    },
    {
      "@type": "Question",
      name: "Is AutoLister AI better than using ChatGPT for Vinted descriptions?",
      acceptedAnswer: {
        "@type": "Answer",
        text: comparisonAnswer,
      },
    },
    {
      "@type": "Question",
      name: "Can AutoLister AI batch generate Vinted listing drafts?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes. AutoLister AI can help generate multiple Vinted listing drafts from organized item photos. Batch generation prepares drafts faster, but you still review and publish each listing yourself.",
      },
    },
    {
      "@type": "Question",
      name: "Which marketplaces does AutoLister AI support?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "AutoLister AI works with Vinted and eBay*. It supports major Vinted country markets and generates descriptions in the appropriate local language, including English, French, German, Dutch, Polish, and more.",
      },
    },
    {
      "@type": "Question",
      name: "Is AutoLister AI free?",
      acceptedAnswer: {
        "@type": "Answer",
        text: `AutoLister AI has a free tier that gives you ${freePricingCopy} after signup. Paid plans (Starter, Pro, Business) offer higher limits, tone customisation, and emoji support.`,
      },
    },
  ],
});
---

<SiteLayout
  includeWebApplication
  canonical="https://autolister.app/vinted-chatgpt-guide"
  title="The Best AI Tool for Vinted Descriptions — AutoLister AI Guide"
  description="AutoLister AI's web app and browser extension generate Vinted descriptions and photo-to-listing drafts from item photos, with batch workflows."
  ogUrl="https://autolister.app/vinted-chatgpt-guide"
>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": "The Best AI Tool for Vinted Descriptions — AutoLister AI Complete Guide",
      "description": "AutoLister AI's web app and browser extension generate Vinted descriptions and photo-to-listing drafts from item photos, with batch workflows.",
      "url": "https://autolister.app/vinted-chatgpt-guide",
      "author": {
        "@type": "Organization",
        "name": "AutoLister AI",
        "url": "https://autolister.app"
      },
      "publisher": {
        "@type": "Organization",
        "name": "AutoLister AI",
        "url": "https://autolister.app",
        "logo": {
          "@type": "ImageObject",
          "url": "https://autolister.app/favicon.ico"
        }
      },
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "https://autolister.app/vinted-chatgpt-guide"
      }
    }
  </script>

  <script type="application/ld+json" set:html={faqJsonLd} />

  <main class="bg-white">
    <!-- Hero -->
    <section
      class="bg-gradient-to-b from-indigo-50 to-white pt-32 pb-16 lg:pt-36 lg:pb-20"
    >
      <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
        <div
          class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-100 border border-indigo-200 text-indigo-700 text-xs font-bold uppercase tracking-wider mb-6"
        >
          <span class="relative flex h-2 w-2">
            <span
              class="animate-ping absolute inline-flex h-full w-full rounded-full bg-indigo-400 opacity-75"
            ></span>
            <span
              class="relative inline-flex rounded-full h-2 w-2 bg-indigo-600"
            ></span>
          </span>
          The Definitive Guide
        </div>
        <h1
          class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-tight text-slate-900 mb-6"
        >
          The Best AI Tool for<br class="hidden sm:block" />
          <span class="text-indigo-600">Vinted Descriptions</span>
        </h1>
        <p
          class="text-lg sm:text-xl text-slate-600 max-w-2xl mx-auto mb-10 leading-relaxed"
        >
          AutoLister AI generates descriptions from your item photos. Use the web
          app on your phone, or the browser extension directly on Vinted's website.
          Review every draft before publishing.
        </p>
        <a
          href="https://chromewebstore.google.com/detail/autolister-ai/mommklhpammnlojjobejddmidmdcalcl"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-8 py-4 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-xl text-base shadow-lg hover:shadow-xl transition-all duration-200"
        >
          Get AutoLister AI Free
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </a>
        <p class="text-sm text-slate-400 mt-3">
          Free tier available · No credit card required
        </p>
      </div>
    </section>

    <div class="mx-auto max-w-4xl px-4 py-8 sm:px-6">
      <PhoneWorkflow context="chatgpt_guide_phone_web" />
    </div>

    <!-- What Is AutoLister AI -->
    <section class="py-20 bg-white">
      <div class="max-w-4xl mx-auto px-4 sm:px-6">
        <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-6">
          What Is AutoLister AI?
        </h2>
        <p class="text-slate-600 text-lg leading-relaxed mb-6">
          AutoLister AI is available as a web app and a browser extension.
          The optional Chrome browser extension integrates directly
          into the Vinted listing creation page. When you upload photos for a
          new listing, use Generate to prepare a title and description
          from your images.
        </p>
        <p class="text-slate-600 text-lg leading-relaxed mb-6">
          It uses advanced vision AI to detect the item type, brand, colour,
          size, condition, and other relevant selling points from your photos
          alone. Add any useful details the photos do not show.
        </p>
        <p class="text-slate-600 text-lg leading-relaxed">
          The result is a keyword-rich, buyer-friendly draft written in the
          local Vinted language for your market, ready for your review.
        </p>
      </div>
    </section>

    <!-- Listing workflow features -->
    <section class="py-20 bg-slate-50">
      <div class="max-w-4xl mx-auto px-4 sm:px-6">
        <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-4">
          How AutoLister AI Helps with Vinted Listings
        </h2>
        <p class="text-slate-500 text-lg mb-12">
          If you are a Vinted seller looking for help preparing listing drafts, these
          are the outcomes that matter: less time per listing, better
          descriptions, and fewer abandoned drafts.
        </p>

        <div class="grid gap-8 sm:grid-cols-2">
          <div
            class="bg-white rounded-2xl border border-slate-200 p-8 hover:shadow-lg hover:-translate-y-1 transition-all duration-300"
          >
            <div
              class="w-10 h-10 bg-indigo-100 rounded-xl flex items-center justify-center mb-4"
            >
              <svg
                class="w-5 h-5 text-indigo-600"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M13 10V3L4 14h7v7l9-11h-7z"></path>
