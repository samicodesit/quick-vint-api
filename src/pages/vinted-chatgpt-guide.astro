                >
                <th class="px-6 py-4 font-semibold text-indigo-700 text-center"
                  >AutoLister extension</th
                >
                <th class="px-6 py-4 font-semibold text-slate-500 text-center"
                  >ChatGPT (manual chat)</th
                >
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <tr class="hover:bg-slate-50 transition-colors">
                <td class="px-6 py-4 text-slate-700">Works inside Vinted</td>
                <td class="px-6 py-4 text-center text-green-700 font-semibold"
