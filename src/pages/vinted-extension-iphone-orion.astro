---
import SiteLayout from "../layouts/SiteLayout.astro";
import { CHROME_WEB_STORE_URL } from "../utils/blog.js";

const pageUrl = "https://autolister.app/vinted-extension-iphone-orion";
const title = "Vinted Extension for iPhone: Use AutoLister with Orion";
const description =
  "Install a Vinted Chrome extension on iPhone with Orion. Set up AutoLister AI, generate Vinted descriptions, check your version, and fix common issues.";

const faqItems = [
  {
    question: "Can you use a Chrome extension on iPhone?",
    answer:
      "Orion Browser offers preliminary support for many Chrome and Firefox extensions on iPhone and iPad. Compatibility varies because iOS browsers do not support every desktop extension API.",
  },
  {
    question: "Can I use the AutoLister Vinted extension on iPhone?",
    answer:
      "Yes. Install AutoLister AI in Orion Browser, enable Chrome extension support, open Vinted in Orion, and use version 1.3.63 or newer for the reliable iPhone sign-in flow. Review every generated listing before publishing.",
  },
  {
    question: "Why does AutoLister open sign-in in a new tab on iPhone?",
    answer:
      "That is intentional. A full browser tab is more reliable than a small extension popup in Orion on iPhone and gives the email and Google sign-in controls enough room.",
  },
  {
    question: "Why does signing out and back in not fix AutoLister on Orion?",
    answer:
      "First check the installed extension version. If Orion still shows AutoLister 1.3.62, signing out will not install the iPhone sign-in fix. Wait until version 1.3.63 or newer is available in the Chrome Web Store, then update or reinstall the extension.",
  },
  {
    question: "Can I scan AutoLister's Phone upload QR code with the same iPhone?",
    answer:
      "No. The Phone and Batch QR flows are designed to send photos from a second phone to a browser session, usually on desktop. When using AutoLister directly in Orion on the same iPhone, choose photos in Vinted first and then tap Generate.",
  },
  {
    question: "Is AutoLister affiliated with Vinted or Orion?",
    answer:
      "No. AutoLister AI is an independent browser extension and is not affiliated with, endorsed by, or sponsored by Vinted, Orion Browser, Kagi, Apple, or Google.",
  },
];

const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      headline: title,
      description,
      datePublished: "2026-07-25",
      dateModified: "2026-07-25",
      author: { "@type": "Organization", name: "AutoLister AI" },
      publisher: {
        "@type": "Organization",
        name: "AutoLister AI",
        url: "https://autolister.app/",
      },
      mainEntityOfPage: pageUrl,
    },
    {
      "@type": "HowTo",
      name: "How to install and use the AutoLister Vinted extension on iPhone with Orion",
      description,
      totalTime: "PT5M",
      tool: [
        { "@type": "HowToTool", name: "iPhone or iPad" },
        { "@type": "HowToTool", name: "Orion Browser" },
      ],
      step: [
        {
          "@type": "HowToStep",
          position: 1,
          name: "Install Orion Browser",
          text: "Install Orion Browser on your iPhone or iPad and open it.",
          url: `${pageUrl}#install`,
        },
        {
          "@type": "HowToStep",
          position: 2,
          name: "Enable Chrome extensions",
          text: "Open Orion's menu, go to Settings, open Extensions, and enable Chrome extension support.",
          url: `${pageUrl}#enable`,
        },
        {
          "@type": "HowToStep",
          position: 3,
          name: "Install AutoLister AI",
          text: "Open the Chrome Web Store in Orion, find AutoLister AI, and add the extension.",
          url: `${pageUrl}#add-autolister`,
        },
        {
          "@type": "HowToStep",
          position: 4,
          name: "Open Vinted and sign in",
          text: "Open Vinted in Orion, start a new listing, tap the AutoLister sign-in button, and complete sign-in in the full browser tab.",
          url: `${pageUrl}#sign-in`,
        },
        {
          "@type": "HowToStep",
          position: 5,
          name: "Generate and review a listing",
          text: "Add item photos in Vinted, tap Generate, then check the title and description before publishing.",
          url: `${pageUrl}#generate`,
        },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: faqItems.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: { "@type": "Answer", text: item.answer },
      })),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Home",
          item: "https://autolister.app/",
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Vinted extension for iPhone",
          item: pageUrl,
        },
      ],
    },
  ],
});
---

<SiteLayout
  canonical={pageUrl}
  title={title}
  description={description}
  ogUrl={pageUrl}
  ogType="article"
  ogImage="https://autolister.app/banner.png"
>
  <script type="application/ld+json" set:html={structuredData} />

  <main class="bg-white">
    <section class="border-b border-slate-200 bg-slate-50 pt-32 pb-16 lg:pt-36">
      <div
        class="mx-auto grid max-w-6xl gap-10 px-4 sm:px-6 lg:grid-cols-[1.08fr_0.92fr] lg:items-center"
      >
        <div>
          <p class="mb-4 text-sm font-bold uppercase tracking-wide text-brand-600">
            Vinted extension for iPhone
          </p>
          <h1
            class="max-w-4xl text-4xl leading-tight font-extrabold tracking-tight text-slate-950 sm:text-5xl lg:text-6xl"
          >
            Use a Vinted extension on iPhone with Orion
          </h1>
          <p class="mt-6 max-w-3xl text-lg leading-8 font-medium text-slate-600">
            This step-by-step guide shows you how to install the AutoLister AI Chrome extension
            in Orion Browser, sign in on iOS, and generate Vinted titles and descriptions from
            your item photos.
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a
              href={CHROME_WEB_STORE_URL}
              target="_blank"
              rel="noopener noreferrer"
              data-track-event="chrome_store_click"
              data-track-context="orion_iphone_guide_hero"
              class="inline-flex items-center justify-center rounded-2xl bg-brand-600 px-7 py-4 text-base font-bold text-white no-underline shadow-lg shadow-brand-600/20 transition hover:bg-brand-700"
            >
              Get AutoLister AI
            </a>
            <a
              href="#install"
              class="inline-flex items-center justify-center rounded-2xl border border-slate-300 bg-white px-7 py-4 text-base font-bold text-slate-900 no-underline transition hover:border-slate-400"
            >
              Follow the iPhone setup
            </a>
          </div>
        </div>

        <aside class="rounded-3xl border border-amber-200 bg-amber-50 p-6 shadow-sm sm:p-8">
          <p class="text-sm font-bold uppercase tracking-wide text-amber-800">
            Check before troubleshooting
          </p>
          <h2 class="mt-2 text-2xl font-extrabold text-slate-950">
            Use AutoLister 1.3.63 or newer
          </h2>
          <p class="mt-4 leading-7 text-slate-700">
            Version 1.3.63 added the reliable Orion-on-iPhone sign-in flow. If Orion still shows
            1.3.62, signing out and back in will not update the extension.
          </p>
          <p class="mt-3 leading-7 text-slate-700">
            Wait until 1.3.63 or newer appears in the public Chrome Web Store, then update or
            reinstall. Store reviews and staged rollouts can take time.
          </p>
        </aside>
      </div>
    </section>

    <section class="border-b border-slate-200 bg-white py-8">
      <nav
        aria-label="Guide contents"
        class="mx-auto flex max-w-6xl flex-wrap gap-3 px-4 text-sm font-bold sm:px-6"
      >
        <a class="rounded-full bg-slate-100 px-4 py-2 text-slate-700 no-underline" href="#install"
          >Install</a
        >
        <a class="rounded-full bg-slate-100 px-4 py-2 text-slate-700 no-underline" href="#sign-in"
          >Sign in</a
        >
        <a class="rounded-full bg-slate-100 px-4 py-2 text-slate-700 no-underline" href="#generate"
          >Generate</a
        >
        <a class="rounded-full bg-slate-100 px-4 py-2 text-slate-700 no-underline" href="#update"
          >Update</a
        >
        <a
          class="rounded-full bg-slate-100 px-4 py-2 text-slate-700 no-underline"
          href="#troubleshooting">Troubleshoot</a
        >
      </nav>
    </section>

    <section class="py-16 sm:py-20">
      <div class="mx-auto max-w-4xl px-4 sm:px-6">
        <div class="rounded-3xl border border-sky-200 bg-sky-50 p-6 sm:p-8">
          <h2 class="text-2xl font-extrabold text-slate-950">What works on iPhone?</h2>
          <p class="mt-4 leading-7 text-slate-700">
            Orion has preliminary support for Chrome and Firefox extensions on iPhone and iPad.
            AutoLister's sign-in page, listing controls, language menus, and dialogs are sized for
            a phone viewport, while the existing desktop layout stays unchanged.
          </p>
          <p class="mt-3 leading-7 text-slate-700">
            Orion cannot guarantee every desktop browser API, so compatibility may change after
            an Orion, iOS, Vinted, or extension update. AutoLister helps draft listing text; it
            does not publish the item for you.
          </p>
        </div>

        <div class="mt-14 space-y-14">
          <section id="install" class="scroll-mt-28">
            <p class="text-sm font-bold uppercase tracking-wide text-brand-600">Step 1</p>
            <h2 class="mt-2 text-3xl font-extrabold text-slate-950">
              Install Orion Browser on your iPhone
            </h2>
            <p class="mt-4 text-lg leading-8 text-slate-700">
              Download Orion Browser from the App Store and open it. Orion is used because Safari
              on iPhone cannot directly install a Chrome Web Store extension.
            </p>
          </section>

          <section id="enable" class="scroll-mt-28">
            <p class="text-sm font-bold uppercase tracking-wide text-brand-600">Step 2</p>
            <h2 class="mt-2 text-3xl font-extrabold text-slate-950">
              Enable Chrome extensions in Orion
            </h2>
            <ol class="mt-5 space-y-3 pl-6 leading-8 text-slate-700">
              <li>Tap Orion's three-dot menu at the bottom-right.</li>
              <li>Open <strong>Settings</strong>, then <strong>Extensions</strong>.</li>
              <li>Turn on support for <strong>Chrome Extensions</strong>.</li>
            </ol>
          </section>

          <section id="add-autolister" class="scroll-mt-28">
            <p class="text-sm font-bold uppercase tracking-wide text-brand-600">Step 3</p>
            <h2 class="mt-2 text-3xl font-extrabold text-slate-950">
              Add the AutoLister AI Chrome extension
            </h2>
            <ol class="mt-5 space-y-3 pl-6 leading-8 text-slate-700">
              <li>Open Orion's Extensions screen and choose to add a Chrome extension.</li>
              <li>
                Visit the <a
                  class="font-bold text-brand-700"
                  href={CHROME_WEB_STORE_URL}
                  target="_blank"
                  rel="noopener noreferrer">AutoLister AI Chrome Web Store page</a
                >.
              </li>
              <li>Tap the install button and approve Orion's extension prompt.</li>
              <li>Return to Extensions and make sure AutoLister AI is enabled.</li>
            </ol>
            <p class="mt-5 rounded-2xl bg-slate-100 p-5 leading-7 text-slate-700">
              If Vinted shows the mobile site without the extension controls, use Orion's page
              menu to request the desktop website, reload, and open Vinted's new-item page again.
            </p>
          </section>

          <section id="sign-in" class="scroll-mt-28">
            <p class="text-sm font-bold uppercase tracking-wide text-brand-600">Step 4</p>
            <h2 class="mt-2 text-3xl font-extrabold text-slate-950">
              Open Vinted in Orion and sign in
            </h2>
            <ol class="mt-5 space-y-3 pl-6 leading-8 text-slate-700">
              <li>Sign in to Vinted in Orion and start a new listing.</li>
              <li>Find the AutoLister controls under the listing fields.</li>
              <li>Tap <strong>Sign in to enable AI tools</strong>.</li>
              <li>Complete Google or email sign-in in the full AutoLister tab.</li>
              <li>Return to the Vinted tab and reload it once if the controls still say sign in.</li>
            </ol>
            <p class="mt-5 leading-7 text-slate-700">
              Opening sign-in as a full tab is intentional on iPhone. It avoids Orion's small
              extension-popup limitations and keeps the sign-in controls usable around the notch
              and home indicator.
            </p>
          </section>

          <section id="generate" class="scroll-mt-28">
            <p class="text-sm font-bold uppercase tracking-wide text-brand-600">Step 5</p>
            <h2 class="mt-2 text-3xl font-extrabold text-slate-950">
              Generate a Vinted title and description from photos
            </h2>
            <ol class="mt-5 space-y-3 pl-6 leading-8 text-slate-700">
              <li>Add clear item photos with Vinted's photo picker.</li>
              <li>Choose your length, format, hashtags, language, and saved note options.</li>
              <li>Tap <strong>Generate</strong>.</li>
              <li>Review the title and description, correct any details, then finish the listing.</li>
            </ol>
            <div class="mt-7 rounded-3xl border border-violet-200 bg-violet-50 p-6">
              <h3 class="text-xl font-extrabold text-slate-950">
                About Phone upload and Batch on the same iPhone
              </h3>
              <p class="mt-3 leading-7 text-slate-700">
                The Phone and Batch buttons show a QR code so a <strong>second device</strong> can
                send photos to the current browser session. An iPhone cannot scan a QR code shown
                on its own screen. When AutoLister is running directly in Orion on that iPhone,
                add photos with Vinted's normal photo picker and use Generate.
              </p>
              <p class="mt-3 leading-7 text-slate-700">
                Keep using the QR workflow when AutoLister is open on a desktop and your photos
                are on your phone. Existing desktop Phone upload and Batch flows are unchanged.
              </p>
            </div>
          </section>

          <section id="update" class="scroll-mt-28">
            <h2 class="text-3xl font-extrabold text-slate-950">
              How to check or update the AutoLister version in Orion
            </h2>
            <ol class="mt-5 space-y-3 pl-6 leading-8 text-slate-700">
              <li>Open Orion's three-dot menu.</li>
              <li>Go to <strong>Settings → Extensions</strong>.</li>
              <li>Open AutoLister AI and check its installed version.</li>
            </ol>
            <div class="mt-6 overflow-hidden rounded-2xl border border-slate-200">
              <div class="grid gap-1 border-b border-slate-200 bg-slate-50 p-4 sm:grid-cols-[9rem_1fr]">
                <strong class="text-slate-950">1.3.63 or newer</strong>
                <span class="text-slate-700">The Orion iPhone sign-in fix is installed.</span>
              </div>
              <div class="grid gap-1 p-4 sm:grid-cols-[9rem_1fr]">
                <strong class="text-slate-950">1.3.62</strong>
                <span class="text-slate-700">
                  Wait for the newer public store version, then update or remove and reinstall
                  AutoLister. Logging out does not change the installed version.
                </span>
              </div>
            </div>
            <p class="mt-5 leading-7 text-slate-700">
              Reinstall only after the newer version is visible in the public Chrome Web Store.
              Otherwise Orion may simply install 1.3.62 again.
            </p>
          </section>

          <section id="troubleshooting" class="scroll-mt-28">
            <h2 class="text-3xl font-extrabold text-slate-950">
              AutoLister not working in Orion? Try these checks
            </h2>
            <div class="mt-6 grid gap-4 sm:grid-cols-2">
              {
                [
                  [
                    "No AutoLister buttons",
                    "Confirm the extension is enabled, request the desktop website, then reload Vinted's new-listing page.",
                  ],
                  [
                    "Sign-in keeps returning",
                    "Check that AutoLister is version 1.3.63 or newer. Then sign in in the full tab and reload Vinted once.",
                  ],
                  [
                    "Generate cannot see photos",
                    "Wait until Vinted finishes adding the thumbnails, then tap Generate again.",
                  ],
                  [
                    "A menu or dialog looks stale",
                    "Close the Vinted tab, update Orion and AutoLister, then open a fresh new-listing page.",
                  ],
                ].map(([heading, copy]) => (
                  <article class="rounded-2xl border border-slate-200 p-5">
                    <h3 class="text-lg font-extrabold text-slate-950">{heading}</h3>
                    <p class="mt-2 leading-7 text-slate-700">{copy}</p>
                  </article>
                ))
              }
            </div>
            <p class="mt-6 leading-7 text-slate-700">
              Still stuck? Visit <a class="font-bold text-brand-700" href="/support"
                >AutoLister support</a
              > and include your iPhone model, iOS version, Orion version, AutoLister version, and
              the step that fails.
            </p>
          </section>
        </div>
      </div>
    </section>

    <section class="border-y border-slate-200 bg-slate-50 py-16 sm:py-20">
      <div class="mx-auto max-w-4xl px-4 sm:px-6">
        <h2 class="text-3xl font-extrabold text-slate-950">
          Frequently asked questions
        </h2>
        <div class="mt-8 space-y-4">
          {
            faqItems.map((item) => (
              <details class="rounded-2xl border border-slate-200 bg-white p-5">
                <summary class="cursor-pointer pr-4 text-lg font-extrabold text-slate-950">
                  {item.question}
                </summary>
                <p class="mt-3 leading-7 text-slate-700">{item.answer}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section class="bg-white py-16 sm:py-20">
      <div class="mx-auto max-w-5xl px-4 text-center sm:px-6">
        <h2 class="text-3xl font-extrabold text-slate-950 sm:text-4xl">
          Write your next Vinted listing from your iPhone
        </h2>
        <p class="mx-auto mt-5 max-w-2xl text-lg leading-8 text-slate-600">
          Install AutoLister AI in Orion, add your item photos, and create a title and
          buyer-friendly description to review in seconds.
        </p>
        <a
          href={CHROME_WEB_STORE_URL}
          target="_blank"
          rel="noopener noreferrer"
          data-track-event="chrome_store_click"
          data-track-context="orion_iphone_guide_bottom"
          class="mt-8 inline-flex items-center justify-center rounded-2xl bg-brand-600 px-8 py-4 text-base font-bold text-white no-underline shadow-lg shadow-brand-600/20 transition hover:bg-brand-700"
        >
          Add AutoLister AI
        </a>
        <div class="mt-8 flex flex-wrap justify-center gap-x-6 gap-y-3 text-sm font-bold">
          <a class="text-brand-700" href="/vinted-description-generator"
            >Vinted description generator</a
          >
          <a class="text-brand-700" href="/blog/batch-generate-vinted-listings"
            >Batch listing guide</a
          >
          <a class="text-brand-700" href="/pricing">Pricing</a>
          <a class="text-brand-700" href="/support">Support</a>
        </div>
        <p class="mx-auto mt-10 max-w-3xl text-xs leading-6 text-slate-500">
          AutoLister AI is an independent tool and is not affiliated with, endorsed by, or
          sponsored by Vinted, Orion Browser, Kagi, Apple, or Google. Orion's extension support is
          preliminary, and not every Chrome extension or browser API is supported on iOS.
        </p>
      </div>
    </section>
  </main>
</SiteLayout>
