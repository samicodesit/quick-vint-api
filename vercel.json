{
  "redirects": [
    {
      "source": "/beta",
      "destination": "/app",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/app",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/app/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/app/auth/callback/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "regions": ["fra1"],
  "functions": {
    "api/user/model.ts": { "maxDuration": 180 },
    "api/cron/user-models.ts": { "maxDuration": 180 }
  },
  "rewrites": [
    {
      "source": "/admin/:view",
      "destination": "/admin"
    }
  ],
  "crons": [
    { "path": "/api/cron/user-models", "schedule": "* * * * *" },
    {
      "path": "/api/cron/billing-notices",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/reset-counts",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/daily-cleanup",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/dom-canary-heartbeat",
      "schedule": "30 7 * * *"
    },
    {
      "path": "/api/cron/billing-reconciliation",
      "schedule": "45 7 * * *"
    },
    {
      "path": "/api/cron/subscription-welcome-retry",
      "schedule": "15 * * * *"
    },
    {
      "path": "/api/cron/incident-sweep",
      "schedule": "*/5 * * * *"
    }
  ]
}
