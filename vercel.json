{
  "redirects": [
    {
      "source": "/beta",
      "destination": "https://quick-vint-api-git-codex-m-09f8c8-ahmed-samis-projects-e6ef0336.vercel.app/app",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/app",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/app/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/app/auth/callback/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "regions": ["fra1"],
  "rewrites": [
    {
      "source": "/admin/:view",
      "destination": "/admin"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/reset-counts",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/daily-cleanup",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/dom-canary-heartbeat",
      "schedule": "30 7 * * *"
    },
    {
      "path": "/api/cron/billing-reconciliation",
      "schedule": "45 7 * * *"
    },
    {
      "path": "/api/cron/subscription-welcome-retry",
      "schedule": "15 * * * *"
    },
    {
      "path": "/api/cron/incident-sweep",
      "schedule": "*/5 * * * *"
    }
  ]
}
